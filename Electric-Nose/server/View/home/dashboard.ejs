<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Electric-Nose</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <!-- Chart.js script - Commented out -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->
    <style>
        :root {
            --primary: #667eea;
            --secondary: #764ba2;
            --accent: #f093fb;
            --danger: #f5576c;
            --bg: #f5f7fa;
        }
        body {
            background: linear-gradient(135deg, var(--bg) 0%, #e0e7ff 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(94, 136, 252, 0.15);
        }
        .card-header {
            border-bottom: none;
            background: transparent;
            font-weight: 600;
            font-size: 1.1rem;
            color: #4c51bf;
        }
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .logo {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--primary);
        }
        .status-chip {
            padding: 8px 16px;
            border-radius: 999px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .chip-success { background: #e6fffa; color: #0f766e; }
        .chip-danger { background: #fee2e2; color: #b91c1c; }
        .chip-warning { background: #fef9c3; color: #854d0e; }
        .wifi-setup-alert {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        }
        .wifi-setup-alert h4 {
            color: #92400e;
            margin-bottom: 15px;
            font-weight: 700;
        }
        .wifi-setup-alert p {
            color: #78350f;
            margin-bottom: 10px;
        }
        .wifi-setup-link {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 24px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }
        .wifi-setup-link:hover {
            color: white;
            opacity: 0.9;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
        }
        /* Modal WiFi Config */
        .wifi-modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            animation: fadeIn 0.3s;
        }
        .wifi-modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .wifi-modal-content {
            background: white;
            border-radius: 20px;
            width: 90%;
            max-width: 600px;
            max-height: 90vh;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: slideUp 0.3s;
        }
        .wifi-modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .wifi-modal-header h3 {
            margin: 0;
            font-weight: 700;
        }
        .wifi-modal-close {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            font-size: 24px;
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }
        .wifi-modal-close:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: rotate(90deg);
        }
        .wifi-modal-body {
            padding: 0;
            height: 600px;
        }
        .wifi-modal-iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes slideUp {
            from { transform: translateY(50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .metric-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            height: 100%;
        }
        .metric-value {
            font-size: 3.2rem;
            font-weight: 700;
            color: var(--primary);
        }
        .metric-label {
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
            color: #94a3b8;
            margin-bottom: 10px;
        }
        .btn-measure {
            background: linear-gradient(135deg, var(--accent) 0%, var(--danger) 100%);
            border: none;
            color: white;
            padding: 16px 30px;
            border-radius: 16px;
            font-size: 1.2rem;
            font-weight: 600;
            width: 100%;
            box-shadow: 0 12px 30px rgba(245, 87, 108, 0.4);
        }
        .status-panel {
            background: #fff1f2;
            border-radius: 16px;
            padding: 18px;
            min-height: 120px;
        }
        .chart-card {
            padding: 20px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(94, 136, 252, 0.15);
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 15px;
        }
        .info-item {
            background: white;
            border-radius: 15px;
            padding: 16px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
        }
        .info-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            color: #94a3b8;
            letter-spacing: 1px;
        }
        .info-value {
            font-size: 1.3rem;
            font-weight: 600;
            color: #0f172a;
        }
        .file-card {
            background: #eef2ff;
            border-radius: 16px;
            padding: 20px;
        }
        .filter-panel {
            background: white;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
        }
        .filter-row {
            display: flex;
            gap: 15px;
            align-items: end;
            flex-wrap: wrap;
        }
        .filter-item {
            flex: 1;
            min-width: 150px;
        }
        .filter-item label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: #64748b;
            font-weight: 500;
        }
        .filter-item select,
        .filter-item input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.9rem;
        }
        .btn-filter {
            padding: 8px 20px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
        }
        .mq-sensor-card {
            background: white;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .mq-sensor-label {
            font-size: 0.85rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .mq-sensor-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
        }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="header-bar">
            <div class="logo">👃 E-NOSE <small style="font-size: 1rem; color: #94a3b8;">Liquid Quality Evaluation</small></div>
            <div class="d-flex gap-2">
                <div class="status-chip chip-success" id="wifiChip"><i class="bi bi-wifi"></i> Connected</div>
                <div class="status-chip chip-warning"><i class="bi bi-battery-full"></i> 100%</div>
                <a href="/settings" class="status-chip" style="background:#eef2ff; color:#4338ca;"><i class="bi bi-menu-button"></i> Menu</a>
            </div>
        </div>

        <!-- WiFi Setup Alert (hiển thị khi ESP32 chưa kết nối WiFi) -->
        <div id="wifiSetupAlert" class="wifi-setup-alert" style="display: none;">
            <h4><i class="bi bi-exclamation-triangle-fill"></i> ESP32 chưa kết nối WiFi</h4>
            <p>Thiết bị ESP32 đang ở chế độ AP mode và cần được cấu hình WiFi trước khi sử dụng.</p>
            <p><strong>Bước 1:</strong> Kết nối WiFi <code>AirSENSE_SPARC_LAB_Config</code> (password: <code>12345678</code>)</p>
            <p><strong>Bước 2:</strong> Nhấn nút bên dưới để tự động mở trang cấu hình WiFi:</p>
            <button onclick="openWifiConfigModal()" class="wifi-setup-link" style="border: none; cursor: pointer;">
                <i class="bi bi-wifi"></i> Cấu hình WiFi cho ESP32
            </button>
            <p style="margin-top: 15px; font-size: 0.9rem; color: #92400e;">
                <i class="bi bi-info-circle"></i> Sau khi cấu hình WiFi, ESP32 sẽ tự động kết nối và trang này sẽ tự động cập nhật.
            </p>
        </div>

        <!-- Modal WiFi Config -->
        <div id="wifiConfigModal" class="wifi-modal">
            <div class="wifi-modal-content">
                <div class="wifi-modal-header">
                    <h3><i class="bi bi-wifi"></i> Cấu hình WiFi cho ESP32</h3>
                    <button class="wifi-modal-close" onclick="closeWifiConfigModal()">&times;</button>
                </div>
                <div class="wifi-modal-body">
                    <iframe id="wifiConfigIframe" class="wifi-modal-iframe" src="http://192.168.4.1/wifi-config"></iframe>
                </div>
            </div>
        </div>

        <!-- Filter Panel -->
        <div class="filter-panel">
            <div class="filter-row">
                <div class="filter-item">
                    <label>Thiết bị</label>
                    <select id="deviceSelect" class="form-select">
                        <option value="">Tất cả thiết bị</option>
                    </select>
                </div>
                <div class="filter-item">
                    <label>Từ ngày</label>
                    <input type="datetime-local" id="fromTime" class="form-control">
                </div>
                <div class="filter-item">
                    <label>Đến ngày</label>
                    <input type="datetime-local" id="toTime" class="form-control">
                </div>
                <div class="filter-item">
                    <label>&nbsp;</label>
                    <button class="btn-filter" onclick="applyFilter()">
                        <i class="bi bi-search"></i> Xem biểu đồ
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Temperature (°C)</div>
                    <div class="metric-value"><span id="temperature">--</span>°C</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Humidity (%)</div>
                    <div class="metric-value"><span id="humidity">--</span>%</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Wi-Fi Signal</div>
                    <div class="metric-value" style="font-size:2.2rem;"><span id="wifiSignal">--</span> dBm</div>
                    <div class="text-muted" id="wifiSSID">SSID: --</div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card p-4">
                    <button class="btn-measure mb-3" id="startMeasurementBtn">
                        <i class="bi bi-play-circle"></i> Start measurement
                    </button>
                    <div class="status-panel">
                        <div class="text-muted mb-2">Status</div>
                        <div id="statusContent" style="font-size:1.2rem; font-weight:600;">Ready</div>
                    </div>
                    <div id="activeMeasurementAlert" class="alert alert-info mt-3" style="display:none;">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Đang đo:</strong> <span id="activeMeasurementFileName"></span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="file-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div style="font-weight:600; color:#4338ca;">Last measurement file</div>
                        <i class="bi bi-file-earmark-bar-graph" style="font-size:1.8rem; color:#4338ca;"></i>
                    </div>
                    <div id="lastFileName" style="font-size:1.2rem; font-weight:600; color:#1f2937;">--</div>
                    <div class="text-muted mb-3" id="lastMeasurementTime">Last updated: --</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary btn-sm" id="downloadFileBtn" style="display:none;">
                            <i class="bi bi-download"></i> Download CSV
                        </button>
                        <a class="btn btn-outline-primary btn-sm" id="fileServerLink" href="#" target="_blank" style="display:none;">
                            <i class="bi bi-link-45deg"></i> Truy cập File Server
                        </a>
                    </div>
                    <div class="text-muted mt-2" style="font-size:0.85rem;" id="fileServerInfo">
                        <i class="bi bi-info-circle"></i> <span id="fileServerText">Đang tải thông tin...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Temperature & Humidity Chart - Commented out -->
        <!--
        <div class="chart-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="font-size:1.1rem; font-weight:600;">Temperature & Humidity Timeline</div>
                <div class="text-muted" style="font-size:0.9rem;">Dữ liệu từ MongoDB</div>
            </div>
            <canvas id="measurementChart" height="120"></canvas>
        </div>
        -->


        <!-- MEMS Sensors Cards -->
        <div class="row g-3 mb-4" id="memsSensorsRow">
            <!-- MEMS sensors sẽ được thêm động bằng JavaScript -->
        </div>

        <!-- MEMS Sensors Charts - Commented out -->
        <!--
        <div class="chart-card mb-4" id="memsSensorsChartContainer" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="font-size:1.1rem; font-weight:600;">MEMS Sensors Timeline</div>
                <div class="text-muted" style="font-size:0.9rem;">8 Cảm biến MEMS</div>
            </div>
            <canvas id="memsSensorsChart" height="120"></canvas>
        </div>
        -->

        <div class="info-grid">
            <div class="info-item">
                <div class="info-title">Total devices</div>
                <div class="info-value" id="totalDevices">--</div>
            </div>
            <div class="info-item">
                <div class="info-title">Devices online</div>
                <div class="info-value text-success" id="onlineDevices">--</div>
            </div>
            <div class="info-item">
                <div class="info-title">Devices offline</div>
                <div class="info-value text-danger" id="offlineDevices">--</div>
            </div>
            <div class="info-item">
                <div class="info-title">Recent commands (1h)</div>
                <div class="info-value" id="recentControls">--</div>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/login/user';
        }

        // Chart variables - Commented out
        // let measurementChart = null;
        // let memsSensorsChart = null;
        let allDevices = [];
        let selectedDeviceId = '';
        let fromTime = null;
        let toTime = null;

        // Load devices list
        async function loadDevices() {
            try {
                const response = await fetch('/api/devices', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await response.json();
                
                if (data.result) {
                    allDevices = data.result;
                    const select = document.getElementById('deviceSelect');
                    select.innerHTML = '<option value="">Tất cả thiết bị</option>';
                    
                    data.result.forEach(device => {
                        const option = document.createElement('option');
                        option.value = device.device_id;
                        option.textContent = device.name || device.device_id;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Error loading devices:', error);
            }
        }

        // Apply filter
        function applyFilter() {
            selectedDeviceId = document.getElementById('deviceSelect').value;
            const fromTimeInput = document.getElementById('fromTime').value;
            const toTimeInput = document.getElementById('toTime').value;
            
            fromTime = fromTimeInput ? new Date(fromTimeInput) : null;
            toTime = toTimeInput ? new Date(toTimeInput) : null;
            
            loadMeasurementHistory();
            loadMEMSSensorsData();
        }

        // Check active measurement và update UI
        async function checkActiveMeasurement() {
            try {
                const activeRes = await fetch('/api/devices/measurements/active', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const activeData = await activeRes.json();
                
                const startBtn = document.getElementById('startMeasurementBtn');
                const statusContent = document.getElementById('statusContent');
                const activeAlert = document.getElementById('activeMeasurementAlert');
                const activeFileName = document.getElementById('activeMeasurementFileName');
                
                if (activeData.result && activeData.result.active && activeData.result.measurement) {
                    // Có measurement đang chạy
                    const measurement = activeData.result.measurement;
                    
                    // Kiểm tra nếu measurement đã completed
                    if (measurement.status === 'completed') {
                        // Measurement đã hoàn thành
                        startBtn.disabled = false;
                        startBtn.style.opacity = '1';
                        startBtn.style.cursor = 'pointer';
                        
                        // Ẩn alert "Đang đo"
                        activeAlert.style.display = 'none';
                        
                        // Hiển thị thông báo hoàn thành với thời gian đo
                        let completionMessage = '✅ Đã hoàn thành';
                        if (measurement.duration_ms) {
                            const durationMinutes = Math.round(measurement.duration_ms / 60000);
                            completionMessage += ` (${durationMinutes} phút)`;
                        }
                        statusContent.textContent = completionMessage;
                        statusContent.style.color = '#16a34a'; // Green color
                        
                        // Reset MEMS sensors về "--" khi measurement completed
                        resetMEMSSensors();
                        
                        // Reload last measurement info để hiển thị file mới nhất
                        loadLastMeasurementInfo();
                    } else {
                        // Kiểm tra thời gian: nếu đã quá 45 phút thì coi như completed
                        const startedAt = new Date(measurement.started_at);
                        const now = new Date();
                        const elapsedMinutes = (now - startedAt) / 60000;
                        
                        if (elapsedMinutes > 45) {
                            // Đã quá thời gian, coi như completed
                            console.log(`⚠️ Measurement ${measurement.file_name} đã quá ${Math.round(elapsedMinutes)} phút, coi như completed`);
                            startBtn.disabled = false;
                            startBtn.style.opacity = '1';
                            startBtn.style.cursor = 'pointer';
                            activeAlert.style.display = 'none';
                            statusContent.textContent = '✅ Đã hoàn thành (quá thời gian)';
                            statusContent.style.color = '#16a34a';
                        } else {
                            // Measurement đang chạy
                            startBtn.disabled = true;
                            startBtn.style.opacity = '0.6';
                            startBtn.style.cursor = 'not-allowed';
                            
                            // Hiển thị thông báo
                            activeAlert.style.display = 'block';
                            activeFileName.textContent = measurement.file_name || 'Unknown';
                            statusContent.textContent = `Đang đo: ${measurement.file_name || 'Unknown'}`;
                            statusContent.style.color = '#2563eb';
                        }
                    }
                } else {
                    // Không có measurement đang chạy
                    startBtn.disabled = false;
                    startBtn.style.opacity = '1';
                    startBtn.style.cursor = 'pointer';
                    
                    // Ẩn thông báo
                    activeAlert.style.display = 'none';
                    
                    // Hiển thị thông báo completed nếu có measurement completed
                    if (activeData.result && activeData.result.measurement && activeData.result.measurement.status === 'completed') {
                        const measurement = activeData.result.measurement;
                        let completionMessage = '✅ Đã hoàn thành';
                        if (measurement.duration_ms) {
                            const durationMinutes = Math.round(measurement.duration_ms / 60000);
                            completionMessage += ` (${durationMinutes} phút)`;
                        }
                        statusContent.textContent = completionMessage;
                        statusContent.style.color = '#16a34a';
                        
                        // Reset MEMS sensors về "--" khi measurement completed
                        resetMEMSSensors();
                        
                        // Reload last measurement info để hiển thị file mới nhất
                        loadLastMeasurementInfo();
                    } else {
                        if (statusContent.textContent.includes('Đang đo:') || statusContent.textContent.includes('Đã hoàn thành')) {
                            statusContent.textContent = 'Ready';
                            statusContent.style.color = '#1f2937';
                            
                            // Reset MEMS sensors về "--" khi không có measurement
                            resetMEMSSensors();
                        }
                    }
                }
            } catch (error) {
                console.error('Error checking active measurement:', error);
            }
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                // Check active measurement trước
                await checkActiveMeasurement();
                
                // Load system status
                const statusRes = await fetch('/api/control/status', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                const statusData = await statusRes.json();
                
                if (statusData.result) {
                    document.getElementById('totalDevices').textContent = statusData.result.total_devices || 0;
                    document.getElementById('onlineDevices').textContent = statusData.result.online_devices || 0;
                    document.getElementById('offlineDevices').textContent = statusData.result.offline_devices || 0;
                    document.getElementById('recentControls').textContent = statusData.result.recent_controls || 0;

                    const wifiChip = document.getElementById('wifiChip');
                    if (statusData.result.wifi_status === 'connected') {
                        wifiChip.className = 'status-chip chip-success';
                        wifiChip.innerHTML = '<i class="bi bi-wifi"></i> Wi-Fi connected';
                        // Ẩn alert nếu WiFi đã kết nối
                        document.getElementById('wifiSetupAlert').style.display = 'none';
                    } else {
                        wifiChip.className = 'status-chip chip-danger';
                        wifiChip.innerHTML = '<i class="bi bi-wifi-off"></i> Disconnected';
                        // Hiển thị alert nếu WiFi chưa kết nối hoặc không có device online
                        if (statusData.result.online_devices === 0 || !statusData.result.wifi_ssid || statusData.result.wifi_ssid === '--') {
                            document.getElementById('wifiSetupAlert').style.display = 'block';
                            // Tự động mở modal WiFi config (chỉ mở 1 lần)
                            if (!window.wifiModalOpened) {
                                setTimeout(() => {
                                    openWifiConfigModal();
                                    window.wifiModalOpened = true;
                                }, 2000); // Đợi 2 giây để user thấy alert trước
                            }
                        } else {
                            document.getElementById('wifiSetupAlert').style.display = 'none';
                            closeWifiConfigModal(); // Đóng modal nếu WiFi đã kết nối
                            window.wifiModalOpened = false; // Reset flag
                        }
                    }
                    document.getElementById('wifiSignal').textContent = statusData.result.wifi_signal || '--';
                    document.getElementById('wifiSSID').textContent = 'SSID: ' + (statusData.result.wifi_ssid || '--');

                    
                    // Cập nhật link file server nếu có IP
                    const fileServerLink = document.getElementById('fileServerLink');
                    const fileServerInfo = document.getElementById('fileServerInfo');
                    const fileServerText = document.getElementById('fileServerText');
                    
                    if (statusData.result.wifi_ip) {
                        const fileServerUrl = `http://${statusData.result.wifi_ip}`;
                        fileServerLink.href = fileServerUrl;
                        fileServerLink.style.display = 'inline-block';
                        fileServerText.textContent = `File server: ${statusData.result.wifi_ip}`;
                        fileServerInfo.style.display = 'block';
                    } else {
                        fileServerLink.style.display = 'none';
                        fileServerText.textContent = 'Chưa có IP address (chưa kết nối WiFi)';
                        fileServerInfo.style.display = 'block';
                    }
                }

                // Load latest sensor data - Ưu tiên từ AirSENSE API (real-time hơn)
                // loadLatestSensorDataFromAirSENSE() sẽ được gọi tự động bởi startAirSENSERefresh()
                
                // Load ADC values từ AirSENSE API (có ADC values gốc)
                // Ưu tiên lấy device_id từ AirSENSE API (device có data thực sự)
                let deviceIdForADC = null;
                
                // Bước 1: Thử lấy từ AirSENSE API (device có data)
                try {
                    const devicesRes = await fetch('/api/devices/airsense/devices', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const devicesData = await devicesRes.json();
                    
                    if (devicesData.result && devicesData.result.success && devicesData.result.devices && devicesData.result.devices.length > 0) {
                        // Lấy device đầu tiên có data (thường là AirSENSE)
                        deviceIdForADC = devicesData.result.devices[0].device_id;
                        console.log('✅ Using device_id from AirSENSE API:', deviceIdForADC);
                    }
                } catch (error) {
                    console.warn('⚠️ Could not get device list from AirSENSE API:', error);
                }
                
                // Bước 2: Nếu không có, thử dùng selectedDeviceId (nhưng validate trước)
                if (!deviceIdForADC && selectedDeviceId) {
                    // Validate: thử query xem device có data không
                    try {
                        const testRes = await fetch(`/api/devices/${selectedDeviceId}/airsense/latest`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const testData = await testRes.json();
                        if (testData.result && testData.result.success && testData.result.data) {
                            deviceIdForADC = selectedDeviceId;
                            console.log('✅ Using selectedDeviceId (validated):', deviceIdForADC);
                        } else {
                            console.warn('⚠️ selectedDeviceId has no data:', selectedDeviceId);
                        }
                    } catch (error) {
                        console.warn('⚠️ selectedDeviceId validation failed:', selectedDeviceId);
                    }
                }
                
                // Bước 3: Nếu vẫn không có, thử allDevices[0] (nhưng validate trước)
                if (!deviceIdForADC && allDevices.length > 0) {
                    const firstDeviceId = allDevices[0].device_id;
                    try {
                        const testRes = await fetch(`/api/devices/${firstDeviceId}/airsense/latest`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const testData = await testRes.json();
                        if (testData.result && testData.result.success && testData.result.data) {
                            deviceIdForADC = firstDeviceId;
                            console.log('✅ Using first device from allDevices (validated):', deviceIdForADC);
                        } else {
                            console.warn('⚠️ First device has no data:', firstDeviceId);
                        }
                    } catch (error) {
                        console.warn('⚠️ First device validation failed:', firstDeviceId);
                    }
                }
                
                let adcLoaded = false;
                
                if (deviceIdForADC) {
                    try {
                        const adcRes = await fetch(`/api/devices/${deviceIdForADC}/airsense/latest`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const adcData = await adcRes.json();
                        
                        if (adcData.result && adcData.result.success && adcData.result.data && adcData.result.data.adc) {
                            const adcArray = adcData.result.data.adc;
                            // Kiểm tra xem có phải là dữ liệu thực không (không phải test data)
                            const hasValidData = adcArray.some(val => val !== null && val !== undefined && val !== 0);
                            
                            if (hasValidData && adcArray.length === 8) {
                                // Hiển thị MEMS sensors với ADC values từ AirSENSE API
                                const sensorDataForMEMS = adcArray.map((value, index) => ({
                                    data_type: `mems${index + 1}`,
                                    value: value,
                                    adc_value: value
                                }));
                                displayMEMSSensors(sensorDataForMEMS);
                                adcLoaded = true;
                                console.log('✅ Loaded ADC values from AirSENSE API:', adcArray);
                            } else {
                                console.warn('⚠️ Invalid ADC data from AirSENSE API:', adcArray);
                            }
                        }
                    } catch (error) {
                        console.error('Error loading ADC values from AirSENSE API:', error);
                    }
                } else {
                    console.warn('⚠️ No valid device_id found for ADC query');
                }
                
                // Chỉ fallback nếu không load được từ AirSENSE API
                if (!adcLoaded) {
                    console.log('⚠️ No valid ADC data from AirSENSE API, trying fallback...');
                    // Thử tìm từ sensorData nhưng chỉ hiển thị nếu có adc_value (không phải voltage)
                    const memsData = (sensorData.result || []).filter(d => 
                        d.data_type && d.data_type.startsWith('mems') && 
                        (d.adc_value !== undefined || (d.unit === 'ADC' && parseFloat(d.value) > 100))
                    );
                    if (memsData.length > 0) {
                        displayMEMSSensors(memsData);
                    } else {
                        console.warn('⚠️ No valid MEMS sensor data found');
                    }
                }
                
                // Load measurement files
                await loadMeasurementFiles();

                await loadMeasurementHistory();
                await loadLastMeasurementInfo();
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        }

