<script>
  function onLogin() {
    Swal.fire({
      title: "<strong>Tùy chọn đăng nhập</strong>",
      icon: "info",
      html:
        `<button class="btn btn-success btn-lg" onclick="onLoginAdmin()">Admin</button> ` +
        `<button  class="btn btn-primary btn-lg" onclick="onLoginCustomer()">Customer</button> `,
      showConfirmButton: false,
      showCloseButton: true,
      // showCancelButton: true,
      // focusConfirm: false,
      // confirmButtonText: '<i class="fa fa-thumbs-up"></i> Great!',
      // confirmButtonAriaLabel: "Thumbs up, great!",
      // cancelButtonText: '<i class="fa fa-thumbs-down"></i>',
      // cancelButtonAriaLabel: "Thumbs down",
    });
  }
  function onLoginAdmin() {
    window.location.href = "http://localhost:3000/login/admin";
  }
  function onLoginCustomer() {
    window.location.href = "http://localhost:3000/login/customer";
  }
  function onReloadMenu() {
    var data = localStorage.getItem("cart");
    var dataCart = { name: "info", value: [] };
    if (data != null) {
      dataCart = JSON.parse(data);
    }
    console.log("onReload ........ dataCart", dataCart);
    var costValue = 0;
    var numberProduct = dataCart.value.length;

    for (var i = 0; i < dataCart.value.length; i++) {
      let item = dataCart.value[i];
      costValue += item.number * item.imageInfo.cost_detail;
    }
    $("#shopping_item_Cart").html(" $" + costValue);
    $("#value_item_Cart").html(numberProduct);
    //shopping_logout_cart
  }
  setTimeout(() => {
    onReloadMenu();
  }, 0);

  function addProductToCart(numberData, product_id, infoData, locatiom) {
    var infoDetailProduct = {
      product_id: product_id,
      number: 1,
      imageInfo: "",
    };
    // Get saved data from localStorage
    var data = localStorage.getItem("cart");
    var dataCart = { name: "info", value: [] };
    if (data != null) {
      dataCart = JSON.parse(data);
    }
    infoDetailProduct.number = numberData;
    infoDetailProduct.imageInfo = dataSaveInfo[infoData][locatiom];
    var fillter = dataCart.value.filter(
      (o) => o.imageInfo.image_id == infoDetailProduct.imageInfo.image_id
    );
    if (fillter.length > 0) {
      // đơn hàng tồn tại
      return;
    }
    dataCart.value.push(infoDetailProduct);

    // Save data to localStorage
    localStorage.setItem("cart", JSON.stringify(dataCart));
    onReload();
  }
</script>
