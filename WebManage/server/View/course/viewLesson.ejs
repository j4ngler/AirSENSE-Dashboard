  <script type="text/javascript">

    const myCommentBox = document.querySelector('.my-comment-box');
    const commentActionWrapper = document.querySelector('.comment-action-wrapper');

    myCommentBox.oninput = () => {
      if (!!myCommentBox.value) {
        commentActionWrapper.style = 'display:flex';
      } else {
        commentActionWrapper.style = 'display:none';
      }
    };
    const sectionTitleWrapper = document.querySelectorAll('.section-title-wrapper');
    const learnList = document.querySelectorAll('.learn-list');
    const sectionTitleIcon = document.querySelectorAll('.section-title-icon-up');

    sectionTitleWrapper.forEach((item, index) => {
      sectionTitleWrapper[index].onclick = () => {
        learnList[index].classList.toggle('learn-list--hidden');
        sectionTitleIcon[index].classList.toggle(
          'section-title-icon-up--rotate180deg'
        );
      };
    });


  </script>

