<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Electric-Nose</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary: #667eea;
            --secondary: #764ba2;
            --accent: #f093fb;
            --danger: #f5576c;
            --bg: #f5f7fa;
        }
        body {
            background: linear-gradient(135deg, var(--bg) 0%, #e0e7ff 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(94, 136, 252, 0.15);
        }
        .card-header {
            border-bottom: none;
            background: transparent;
            font-weight: 600;
            font-size: 1.1rem;
            color: #4c51bf;
        }
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .logo {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--primary);
        }
        .status-chip {
            padding: 8px 16px;
            border-radius: 999px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .chip-success { background: #e6fffa; color: #0f766e; }
        .chip-danger { background: #fee2e2; color: #b91c1c; }
        .chip-warning { background: #fef9c3; color: #854d0e; }
        .metric-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            height: 100%;
        }
        .metric-value {
            font-size: 3.2rem;
            font-weight: 700;
            color: var(--primary);
        }
        .metric-label {
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
            color: #94a3b8;
            margin-bottom: 10px;
        }
        .btn-measure {
            background: linear-gradient(135deg, var(--accent) 0%, var(--danger) 100%);
            border: none;
            color: white;
            padding: 16px 30px;
            border-radius: 16px;
            font-size: 1.2rem;
            font-weight: 600;
            width: 100%;
            box-shadow: 0 12px 30px rgba(245, 87, 108, 0.4);
        }
        .status-panel {
            background: #fff1f2;
            border-radius: 16px;
            padding: 18px;
            min-height: 120px;
        }
        .chart-card {
            padding: 20px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(94, 136, 252, 0.15);
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 15px;
        }
        .info-item {
            background: white;
            border-radius: 15px;
            padding: 16px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
        }
        .info-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            color: #94a3b8;
            letter-spacing: 1px;
        }
        .info-value {
            font-size: 1.3rem;
            font-weight: 600;
            color: #0f172a;
        }
        .file-card {
            background: #eef2ff;
            border-radius: 16px;
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="header-bar">
            <div class="logo">👃 E-NOSE <small style="font-size: 1rem; color: #94a3b8;">Liquid Quality Evaluation</small></div>
            <div class="d-flex gap-2">
                <div class="status-chip chip-success" id="wifiChip"><i class="bi bi-wifi"></i> Connected</div>
                <div class="status-chip chip-warning"><i class="bi bi-battery-full"></i> 100%</div>
                <a href="/enose/settings" class="status-chip" style="background:#eef2ff; color:#4338ca;"><i class="bi bi-menu-button"></i> Menu</a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Temperature (°C)</div>
                    <div class="metric-value"><span id="temperature">--</span>°C</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Humidity (%)</div>
                    <div class="metric-value"><span id="humidity">--</span>%</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Wi-Fi Signal</div>
                    <div class="metric-value" style="font-size:2.2rem;"><span id="wifiSignal">--</span> dBm</div>
                    <div class="text-muted" id="wifiSSID">SSID: --</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Storage Usage</div>
                    <div class="metric-value" style="font-size:2.2rem;"><span id="storageUsage">--</span></div>
                    <div class="text-muted" id="storageSummary">-- / --</div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card p-4">
                    <button class="btn-measure mb-3" id="startMeasurementBtn">
                        <i class="bi bi-play-circle"></i> Start measurement
                    </button>
                    <div class="status-panel">
                        <div class="text-muted mb-2">Status</div>
                        <div id="statusContent" style="font-size:1.2rem; font-weight:600;">Ready</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="file-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div style="font-weight:600; color:#4338ca;">Last measurement file</div>
                        <i class="bi bi-file-earmark-bar-graph" style="font-size:1.8rem; color:#4338ca;"></i>
                    </div>
                    <div id="lastFileName" style="font-size:1.2rem; font-weight:600; color:#1f2937;">--</div>
                    <div class="text-muted" id="lastMeasurementTime">Last updated: --</div>
                </div>
            </div>
        </div>

        <div class="chart-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="font-size:1.1rem; font-weight:600;">Measurement timeline</div>
                <div class="text-muted" style="font-size:0.9rem;">Temperature & Humidity history</div>
            </div>
            <canvas id="measurementChart" height="120"></canvas>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-title">Total devices</div>
                <div class="info-value" id="totalDevices">--</div>
            </div>
            <div class="info-item">
                <div class="info-title">Devices online</div>
                <div class="info-value text-success" id="onlineDevices">--</div>
            </div>
            <div class="info-item">
                <div class="info-title">Devices offline</div>
                <div class="info-value text-danger" id="offlineDevices">--</div>
            </div>
            <div class="info-item">
                <div class="info-title">Recent commands (1h)</div>
                <div class="info-value" id="recentControls">--</div>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/login/user';
        }

        let measurementChart = null;

        // Load dashboard data
        async function loadDashboardData() {
            try {
                // Load system status
                const statusRes = await fetch('/api/enose/control/status', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                const statusData = await statusRes.json();
                
                if (statusData.result) {
                    document.getElementById('totalDevices').textContent = statusData.result.total_devices || 0;
                    document.getElementById('onlineDevices').textContent = statusData.result.online_devices || 0;
                    document.getElementById('offlineDevices').textContent = statusData.result.offline_devices || 0;
                    document.getElementById('recentControls').textContent = statusData.result.recent_controls || 0;

                    const wifiChip = document.getElementById('wifiChip');
                    if (statusData.result.wifi_status === 'connected') {
                        wifiChip.className = 'status-chip chip-success';
                        wifiChip.innerHTML = '<i class="bi bi-wifi"></i> Wi-Fi connected';
                    } else {
                        wifiChip.className = 'status-chip chip-danger';
                        wifiChip.innerHTML = '<i class="bi bi-wifi-off"></i> Disconnected';
                    }
                    document.getElementById('wifiSignal').textContent = statusData.result.wifi_signal || '--';
                    document.getElementById('wifiSSID').textContent = 'SSID: ' + (statusData.result.wifi_ssid || '--');

                    if (statusData.result.storage) {
                        const usagePercent = ((statusData.result.storage.used / statusData.result.storage.total) * 100).toFixed(1);
                        document.getElementById('storageUsage').textContent = usagePercent + '%';
                        document.getElementById('storageSummary').textContent = `${formatBytes(statusData.result.storage.used)} / ${formatBytes(statusData.result.storage.total)}`;
                    }
                }

                // Load latest sensor data
                const sensorRes = await fetch('/api/enose/devices/data/latest', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                const sensorData = await sensorRes.json();
                
                if (sensorData.result) {
                    const temp = sensorData.result.find(d => d.data_type === 'temperature');
                    const humidity = sensorData.result.find(d => d.data_type === 'humidity');
                    
                    if (temp) {
                        document.getElementById('temperature').textContent = parseFloat(temp.value).toFixed(1);
                    }
                    if (humidity) {
                        document.getElementById('humidity').textContent = parseFloat(humidity.value).toFixed(0);
                    }
                }

                await loadMeasurementHistory();
                await loadLastMeasurementInfo();
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        }

        async function loadMeasurementHistory() {
            try {
                const historyRes = await fetch('/api/enose/devices/data/history?limit=8', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const historyData = await historyRes.json();
                if (historyData.result) {
                    const labels = historyData.result.map(item => new Date(item.timestamp).toLocaleTimeString());
                    const tempData = historyData.result.map(item => item.temperature);
                    const humidityData = historyData.result.map(item => item.humidity);

                    renderChart(labels, tempData, humidityData);
                }
            } catch (error) {
                console.error('Error loading measurement history:', error);
            }
        }

        function renderChart(labels, tempData, humidityData) {
            const ctx = document.getElementById('measurementChart');
            if (measurementChart) {
                measurementChart.destroy();
            }
            measurementChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Temperature (°C)',
                            data: tempData,
                            borderColor: '#f43f5e',
                            backgroundColor: 'rgba(244,63,94,0.1)',
                            tension: 0.4,
                            borderWidth: 3,
                        },
                        {
                            label: 'Humidity (%)',
                            data: humidityData,
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59,130,246,0.1)',
                            tension: 0.4,
                            borderWidth: 3,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: false,
                            ticks: {
                                color: '#475569'
                            },
                            grid: {
                                color: 'rgba(148,163,184,0.3)'
                            }
                        },
                        x: {
                            ticks: {
                                color: '#475569'
                            },
                            grid: {
                                display: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: {
                                color: '#1e293b'
                            }
                        }
                    }
                }
            });
        }

        async function loadLastMeasurementInfo() {
            try {
                const response = await fetch('/api/enose/control/measurement/last', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await response.json();
                if (data.result) {
                    document.getElementById('lastFileName').textContent = data.result.file_name || '--';
                    document.getElementById('lastMeasurementTime').textContent = 'Last updated: ' + (data.result.started_at ? new Date(data.result.started_at).toLocaleString() : '--');
                }
            } catch (error) {
                console.error('Error loading last measurement:', error);
            }
        }

        // Start measurement
        document.getElementById('startMeasurementBtn').addEventListener('click', async () => {
            const btn = document.getElementById('startMeasurementBtn');
            const statusContent = document.getElementById('statusContent');
            
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Measuring...';
            statusContent.textContent = 'Starting measurement...';
            
            try {
                const response = await fetch('/api/enose/control/measurement/start', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });
                
                const data = await response.json();
                
                if (data.result && data.result.success) {
                    statusContent.textContent = `Measurement started: ${data.result.file_name}`;
                    statusContent.style.color = '#16a34a';
                    document.getElementById('lastFileName').textContent = data.result.file_name;
                    document.getElementById('lastMeasurementTime').textContent = 'Last updated: ' + new Date(data.result.started_at).toLocaleString();
                } else {
                    statusContent.textContent = data.error?.message || 'Failed to start measurement';
                    statusContent.style.color = '#dc3545';
                }
            } catch (error) {
                statusContent.textContent = 'Error: ' + error.message;
                statusContent.style.color = '#dc3545';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-play-circle"></i> Start measurement';
            }
        });

        // Format bytes
        function formatBytes(bytes) {
            if (!bytes || bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Initial load
        loadDashboardData();
        setInterval(loadDashboardData, 5000);
    </script>
</body>
</html>
