<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/assets/css/authen/authen.css">
    <script src="https://code.jquery.com/jquery.min.js"></script>
    <title>Reset Password</title>
</head>
<body>
    <div class="authen-center">
        <h2>Reset Password</h2>
        <h4>RESET PASSWORD</h4>
     <div class="authen-alert-box">
        <span><i class="fa fa-check-circle" aria-hidden="true"></i>
        Hãy nhập mật khẩu mới cho tài khoản của bạn
        </span>
     </div> 
        <form>  
            <div class="authen-text-field">
                <input type="password" id="newResetPass" required>
                <span></span>
                <label>Mật khẩu mới</label>
            </div>
            <div class="authen-text-field">
                <input type="password" id="checkNewResetPass" required>
                <span></span>
                <label>Nhập lại mật khẩu mới</label>
            </div>
      </form>
    <button class="authen-submit-button-2" onclick="submit()">Reset</button>
    <script>
        function submit () {

            var nowURL = window.location.href;
            let nowURLArray = nowURL.split('/');
            let token = nowURLArray[nowURLArray.length - 1];
            let userid = nowURLArray[nowURLArray.length - 2];
            if ($('#newResetPass').val() != $('#checkNewResetPass').val()) {
            alert("Mật khẩu nhật lại không khớp");
            return;
        }


            $.ajax({
                        type: 'post',
                        method: 'POST',
                        url: '/api/auth/newResetPass',
                     //   body: JSON.stringify({type:dataView}), // body data type must match "Content-Type" header
                        data: JSON.stringify( {
                            password: $('#newResetPass').val(),
                            token: token,
                            userId: userid
                        }), // body data type must match "Content-Type" header
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        redirect: 'follow', // manual, *follow, error
                        referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                        dataType: 'json',
                        cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                        credentials: 'same-origin', // include, *same-origin, omit
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            // 'Authorization': 'Beard ' + localStorage.getItem('token'),
                            // 'Content-Type': 'application/x-www-form-urlencoded',
                        },
   
   
          success: function(loadcofig) {
              console.log(loadcofig);
              console.log(loadcofig);
              if (loadcofig.message) {
                  alert(loadcofig.message)
              } else {
                  alert("Không tìm thấy email nào giống như bạn cung cấp cho chúng tôi");
              }
          },
          complete: function(loadcofig) {
              console.log(loadcofig.responseText);
          },
          error: function(loadcofig) {
              console.log(loadcofig);
          }
      });
      }
        
    </script>
</body>
</html>