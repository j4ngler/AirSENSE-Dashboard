        function createMaker(LoLa,station)
        {
            if(station.aqi==0) {
                return;
                // station.aqi = "n/a";
            }

            var IIcon=L.Icon.extend({
                options:{
                    iconSize:     [30, 60],
                    shadowSize:   [50, 64],
                    iconAnchor:   [22, 94],
                    popupAnchor:  [-3, -76]
                }
            });
            MakerObj={};
            Options={};
            var color = getColorByAQI(station.aqi);
            html = '<div class="contain-icon"><div class="maker-icon '+color+'"></div>'+
                        '<div class="detail-index-aqi">'+station.aqi+'</div></div>';

            var marker=L.marker(LoLa,
            {
                icon: new L.DivIcon({
                    className: 'div-icon',
                    html: html
                }),
                stationId: station.station_id

            },MakerObj).addTo(mapObj);
        
            var popup=L.popup(Options);
            popup.setContent('<div class="maker-content">'+station.content+'</div>');
            marker.bindPopup(popup);
            marker.on('mouseover', function (e) {
                this.openPopup();
            });
            marker.on('mouseout', function (e) {
                this.closePopup();
            });

            marker.on('click', function (e) {
                $('#popout').animate({ right: 0 }, 'medium');
                $('.detail-venue').text(station.content);
                $('#aqi-index').removeClass();
                $('#aqi-index').addClass(color);
                $('.index-aqi').text(station.aqi);
                drawAqiChart(station.station_id,'aqi-chart', 'Chỉ số AQI');
                drawRightBarChart(station.station_id,'temp-chart', 'Nhiệt độ', 'temperature');
                drawRightBarChart(station.station_id,'humid-chart', 'Độ ẩm', 'humidity');
                $('#selectTable').val(this.options.stationId);
                
                setTimeout(gotoCheckData(false),500);

            });
            return marker;
        }

