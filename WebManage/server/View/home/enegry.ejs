        $(document).click(function(event) {
            //if you click on anything except the modal itself or the "open modal" link, close the modal
            if (!$(event.target).closest("#popout, .detail-index-aqi").length ) {
                $("body").find("#popout").animate({ right: -373 }, 'slow');
            }
        });
        // var mname = localStorage.getItem("tocken_LVC");
        var allInfoStation=null;
        gotoCheckUserStorage();

        // should display by some colors
        function getRandomColor() {
            var letters = '0123456789ABCDEF';
            var color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            // console.log('color', color);
            color = '#3A0A6C';
            return color;
        }


        function getConfig(arrayID,data,element,title,color) {

            var itemDaraw=[];
            for(var i=0;i<arrayID.length;i++){
                let item=arrayID[i];
                itemDaraw.push({
                    label: data[item].nameStation,
                    backgroundColor: color[i],
                    borderColor: color[i],
                    data: data[item].data,
                    fill: false,
                    showLine: true,
                    borderWidth: 1,
                });

            }
            var config = {
                type: 'scatter',
                data: {
                    //labels: strtime,
                    datasets: itemDaraw
                },
                options: {
                    responsive: true,
                    title: {
                        display: true,
                        text: title,
                        position: 'top'
                    },
                    tooltips: {
                        mode: 'index',
                        intersect: false,
                    },
                    hover: {
                        mode: 'nearest',
                        intersect: true
                    },
                    scales: {
                        xAxes: [{
                            type: 'time',
                            distribution: 'linear',
                            displayFormats: {
                                quarter: 'MMM YYYY'
                            }
                        }],
                        y: {
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: '%humi'
                            },
                        }
                    },
                    elements: {
                        point:{
                            radius: 0
                        }
                    },
                    annotation: {
                        annotations: [
                            {
                                drawTime: "afterDatasetsDraw",
                                id: "up",
                                type: "line",
                                mode: "horizontal",
                                scaleID: "y-axis-0",
                                value: 20,
                                borderColor: "red",
                                borderWidth: 0,
                                label: {
                                    backgroundColor: "red",
                                    content: "min",
                                    enabled: false
                                },
                            },
                            {
                                drawTime: "afterDatasetsDraw",
                                id: "low",
                                type: "line",
                                mode: "horizontal",
                                scaleID: "y-axis-0",
                                value: 10,
                                borderColor: "blue",
                                borderWidth: 0,
                                label: {
                                    backgroundColor: "red",
                                    content: "max",
                                    enabled: false
                                },
                            },
                        ]
                    }
                },
            };
            return config;
        }


        var reset = 0;
        function drawSensor(data){
            $(".no-station").hide();
            $(".no-data").hide();
            $(".dashboard").show();
            
            let stationid = data.station;
            var color=[];
            if(data.data.length){
                let arrayData={};
                let arrayID=[];
                let stationid = data.station;
                for(let i=0; i<data.data.length; i++){
                    let dataview=data.data[i];
                    // let subTopic = dataview.topic.split('/');
                    // console.log('.......hey Giang, notice that', stationid);
                    if(arrayData[stationid]) { 
                        // Covers 'undefined' as well
                        arrayData[stationid].data.push(dataview);
                    } 
                    else {
                        var  nameStation="";
                        for(let j=0;j<allInfoStation.length;j++){
                            // hey Giang, check name again later
                            if(stationid==allInfoStation[j].station_id){
                                nameStation=allInfoStation[j].title;
                            }
                        }
                        color.push(getRandomColor());
                        arrayID.push(stationid);
                        arrayData[stationid]={nameStation:nameStation ,data:[]};
                        arrayData[stationid].data.push(dataview);
                    }   
                }
                // console.log('arrayData: ',arrayData);
                // console.log('arrayID: ',arrayID);
                drawSingleChart(arrayID,arrayData,'Voltage','Voltage',color);
                drawSingleChart(arrayID,arrayData,'Current','Current',color);
                drawSingleChart(arrayID,arrayData,'Power','Power',color);
                drawSingleChart(arrayID,arrayData,'Energy','Energy',color);
                drawSingleChart(arrayID,arrayData,'Frequency','Frequency',color);
                drawSingleChart(arrayID,arrayData,'Power_Factor','Power_Factor',color);
                reset = 1;
            } 
            else {
                $(".no-data").show();
                $(".dashboard").hide();
                $(".no-station").hide();
            }
        }

        function drawSingleChart(arrayID,data, title, property,color) {
            var broad_data={};
            for(var i=0;i<arrayID.length;i++){
                let itemBroad=arrayID[i];
                broad_data[itemBroad]={nameStation:data[itemBroad].nameStation ,data:[]};
                for(let i=0; i<10; ++i) {
                    broad_data[itemBroad].data.push()
                }


                broad_data[itemBroad].data = data[itemBroad].data.map(item => 
                {
                    if(item.content !== undefined && item.content[property] !== undefined)
                    return data = {'x': new Date(item.time*1000), 'y': item.content[property]};
                }
                )
            }

            var config = getConfig(arrayID,broad_data,element,title,color);
            var element = document.getElementById(property).getContext('2d');
            // if(reset==1) {
            //     window[property].data.datasets = config.data.datasets;
            //     window[property].update();
            // } 
            // else 
            window[property] = new Chart(element, config);
            // console.log(window[property])
            
        }



        function onSelectClick(){
            if(stringvalue.length>1)
                gotoCheckData();
        }

        loadAllContent();
        function loadAllContent(){
            var Link='/api/power/getPowerMeasureStation';
                $.ajax({
                    type: 'get',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        var showData='<option value="">None</option>';
                        var groupID=[];
                        var nameGroupID=[];
                        allInfoStation=loadcofig.result;
                        defaultStation = loadcofig.result.station_id;
                        for(var k=0;k< allInfoStation.length;k++) {
                            let v=allInfoStation[k];
                            if(k===0) {
                                showData+='<option selected value="'+v.station_id+'">'+v.title +'</option>';
                            } else showData+='<option value="'+v.station_id+'">'+v.title +'</option>';
                            
                            // add group
                            // if((v.id_group>0)&&(!groupID.includes(v.id_group)))
                            // {
                            //     groupID.push(v.id_group);
                            //     nameGroupID.push(v.name_group);
                            // }
                            
                        }

                        for(var l=0;l< groupID.length;l++) {
                            let dataChoice=groupID[l];
                            var itemData="";
                            for(var k=0;k< loadcofig.result.length;k++) {
                                let v=loadcofig.result[k];
                                if(v.id_group==dataChoice){
                                    if(itemData.length>1) itemData+=","
                                    itemData+=""+v.station_id+"";
                                }   
                            }
                            showData+='<option value="'+itemData+'">'+nameGroupID[l] +'</option>';

                        }
                        $('#selectTable').html(showData);
                        gotoCheckData();
                        
                    },
                    error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
        }

        function gotoCheckData(isShowLoader){  
            console.log("go to check data");
            var data=document.getElementById("selectTable").value;
            var Link='/api/power/dataSensor';
            var fromTime = new Date($('#fromTime').val());
            var now = new Date().getTime()/1000;
            if(fromTime==undefined || now-fromTime/1000>3*24*60*60) {
                $("#fromTime").val(new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toJSON().slice(0,19));
