        window.onload=function(){
            mapObj=L.map('Map',Mapconfig);
            var southWest = L.latLng(20, 104);
            var northEast = L.latLng(22, 106);
            bounds = L.latLngBounds(southWest, northEast);
            L.tileLayer('http://{s}.tile.osm.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="http://osm.org/copyright">OpenStreetMap</a> contributors',
                // bounds: bounds,
            }).addTo(mapObj);

            function onMoveEnd(event) {
                let coordinate = this.getCenter();
                let refresh = false;
                if(coordinate.lat>22) {
                    coordinate.lat = 21.99;
                    refresh = true;
                }
                if(coordinate.lat<20.5) {
                    coordinate.lat = 20.51;
                    refresh = true;
                }
                if(coordinate.lng>106) {
                    coordinate.lng = 105.99;
                    refresh = true;
                }
                if(coordinate.lng<104) {
                    coordinate.lat = 104.01;
                    refresh = true;
                }      
                if(refresh) {
                    this.setView([coordinate.lat,coordinate.lng]);  
                }  
            }

            function zoomEnd(event) {
                var zoom = this.getZoom();
                mapObj.removeLayer(tsMaker);
                mapObj.removeLayer(hsMaker);
                addIconToHSTS(zoom); 
                // if( zoom < 10) {
                //     this.setZoom(10);
                // }
            }
            mapObj.on('zoomend', zoomEnd);
            // mapObj.on('moveend', onMoveEnd);

            showMaker();

            initiateHstsMaker();
            
        }

