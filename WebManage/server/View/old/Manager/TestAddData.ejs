<html lang="en">
    <head>
        <meta charset="utf-8" http-equiv="Content-Type" >
        <style>
            body {font-family: Arial, Helvetica, sans-serif;}
            
            /* The Modal (background) */
            .modal {
                display: none; /* Hidden by default */
                position: fixed; /* Stay in place */
                z-index: 1; /* Sit on top */
                padding-top: 100px; /* Location of the box */
                left: 0;
                top: 0;
                width: 100%; /* Full width */
                height: 100%; /* Full height */
                overflow: auto; /* Enable scroll if needed */
                background-color: rgb(0,0,0); /* Fallback color */
                background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
            }
            
            /* Modal Content */
            .modal-content {
              background-color: #fefefe;
              margin: auto;
              padding: 20px;
              border: 1px solid #888;
              width: 80%;
            }
            
            /* The Close Button */
            .close {
              color: #aaaaaa;
              float: right;
              font-size: 28px;
              font-weight: bold;
            }
            
            .close:hover,
            .close:focus {
              color: #000;
              text-decoration: none;
              cursor: pointer;
            }
        </style>
      <script language="JavaScript" src="https://code.jquery.com/jquery-3.3.1.js" type="text/javascript"></script>
      <script language="JavaScript" src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js" type="text/javascript"></script>
      <script language="JavaScript" src="https://cdn.datatables.net/1.10.20/js/dataTables.bootstrap4.min.js" type="text/javascript"></script>
      <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/css/bootstrap.css">
      <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.20/css/dataTables.bootstrap4.min.css">
      <script type="text/javascript" src="/old/javascripts/commonView.js"></script>
    </head>
    <body  onload="checkUserAuthenSecsion()">  

      <h1> Thêm dữ liệu </h1>
      dữ liệu <input type="text" value="$STATION I6009,2020-07-08 15:00:00,3.0,18.5,1485.126,19.0,2368.772,18.7,16# " id="text_add" style="width: 600px;" /> 
  
    <br/>
    <center> Tác vụ </center>
    <br/>
    <center>
        <button onclick='loaddingUser()'> Thêm </button>
    </center>
    <div id="selectTable"> 

    </div>
      
    <script type="text/javascript">

            var mname = localStorage.getItem("tocken_LVC");
           
            function loaddingUser(){
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: 'http://localhost:3000/senddata',
                    data: {data: document.getElementById("text_add").value },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        //location.reload();
                        document.getElementById("selectTable").value=loadcofig.toString();
                    },
                    complete: function (loadcofig) {
                        console.log(loadcofig.responseText);
                        document.getElementById("selectTable").value=loadcofig.responseText;
                    },
                    error: function (loadcofig) {
                        console.log(loadcofig);
                    }
                });
            }


            

            
        </script>
    </body>
</html>