<% include ../Layout/header.ejs %>
<% include ../Layout/topBar.ejs %>

<style>
    .manage-blog {
        background-color: lightgray;
    }
</style>

<body>

    <section class="mag-posts-area d-flex flex-wrap" style="background-color: white;">

        <% include ../Layout/leftSideBar.ejs %>
        <!-- content -->
        <div class="mag-posts-content mt-30 mb-30 p-30 box-shadow">
            <br />
            <table id="datatable" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Posit</th>
                        <th>Offi</th>
                        <th>Age</th>
                        <th>Start date</th>
                        <th>Salarc</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Tiger Nixon</td>
                        <td>System Architect</td>
                        <td>Edinburgh</td>
                        <td>61</td>
                        <td>2011/04/25</td>
                        <td>$320,800</td>
                    </tr>

                </tbody>
            </table>
            <br />
            <center> Tác vụ </center>
            <br />
            <center>
                <button class="add-button" onclick='actionData("add")'> Thêm </button>

            </center>
            <div id="myModal" class="modal">

                <!-- Modal content -->
                <div class="modal-content1">
                    <span class="close">&times;</span>
                    <div id="ationSelect">

                    </div>
                </div>

            </div>
        </div>

    </section>
    <% include ../Layout/footer.ejs %>
    <script type="text/javascript">
        var mname = localStorage.getItem("tocken_LVC");
        var lisItemStation = "";
        var tableReport = 'sparc_posts';
        gotoCheckUserStorage();
        gotoCheckUser(tableReport);


        var actionDataSelect = null;
        var dataSelectEdit = null;
        var dataClick = null;
        /*$(document).ready(function() {
            $('#datatable').DataTable();
            
            gotoCheckUser();
            
        } ); */

        // 0 là không cho hiện
        // 1 là chỉ quyền admin thì mới cho hiện
        // 2  không hiện
        // 3 hiện dữ liệu không cho chỉnh sửa trừ admin
        // 4 hiện dữ liệu cho chỉnh sửa
        var table;
        function assetDataBase(result) {
            actionDataSelect = {
                dataTableTitle: result.dataReport.dataTableTitle,
                titleDataBase: result.dataReport.titleDataBase,
                titleReport: result.dataReport.titleReport
            };
            $('#datatable').DataTable({ destroy: true }).destroy();
            var showData = '<thead> <tr>';
            var columeShow = [];
            for (var k in result.dataReport.dataTableTitle) {
                if ((result.dataReport.titleDataBase[k] > 2) && (result.dataReport.titleDataBase[k] < 6)) {
                    showData += result.dataReport.dataTableTitle[k]
                    showData += '<th data-field="' + k + '">' + result.dataReport.dataTableTitle[k] + '</th>';
                    columeShow.push({ data: k });
                }
            }
            columeShow.push({ data: "edit" });
            columeShow.push({ data: "delete" });
            showData += '<th>sửa</th><th>Xóa</th></tr></thead>';

            for (var k = 0; k < result.result.length; k++) {
                result.result[k]["edit"] = '<p data-placement="top" data-toggle="tooltip" title="Edit"><button onclick="' + "actionData('edit')" + '" class="btn btn-primary btn-xs" data-title="Edit" data-toggle="modal" data-target="#edit" ><span class="glyphicon glyphicon-pencil"></span></button></p>';
                result.result[k]["delete"] = '<p data-placement="top" data-toggle="tooltip" title="Delete"><button onclick="' + "loaddingDeleteUser(this)" + '"  class="btn btn-danger btn-xs" data-title="Delete" data-toggle="modal" data-target="#delete" ><span class="glyphicon glyphicon-trash"></span></button></p>';
            }
            $('#datatable').html(showData);
            table = $('#datatable').DataTable({ "data": result.result, columns: columeShow });
            $('#datatable tbody').on('click', 'td',
                function () {
                    console.log('datatable')
                    var idx = table.cell(this).index().row;
                    var data = table.row(idx).data();
                    dataClick = data;
                }
            );

        }

        // gotoCheckUser();
        function gotoCheckUser(tableSelect) {
            console.log('gotoCheckUser')
            if (tableSelect.length < 1) return;
            var Link = '/api/users/report';
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: Link,
                data: JSON.stringify({table:tableSelect}),
                cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                credentials: 'same-origin', // include, *same-origin, omit
                redirect: 'follow', // manual, *follow, error
                referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                dataType: 'json',
                cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                credentials: 'same-origin', // include, *same-origin, omit
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + mname,
                    // 'Content-Type': 'application/x-www-form-urlencoded',
                },
                success: function (posts) {
                    console.log('success: ',posts)
                    assetDataBase(posts);
                },
                error: function (posts) {
                    console.log('error');
                    console.log(posts);
                    console.log('end error');
                }
            });
        }

        loadAllContent();


        function loadAllContent() {
            var Link = '/api/users/report';
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: Link,
                data: JSON.stringify({table:"sparc_posts"}),
                cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                credentials: 'same-origin', // include, *same-origin, omit
                redirect: 'follow', // manual, *follow, error
                referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                dataType: 'json',
                cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                credentials: 'same-origin', // include, *same-origin, omit
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + mname,
                    // 'Content-Type': 'application/x-www-form-urlencoded',
                },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    lisItemStation = '<select id="id_group" style="width: 200px;" > <option value="0">không xác định </option>';
                    for (var k = 0; k < loadcofig.result.length; k++) {
                        let v = loadcofig.result[k];
                        lisItemStation += '<option value="' + v.id_group + '">' + v.name_group + '</option>';
                    }
                    var showData = '</select>';

                },
                error: function (loadcofig) {
                    console.log('error');
                    console.log(loadcofig);
                    console.log('end error');
                }
            });
        }


        var modal = document.getElementById("myModal");
        // Get the button that opens the modal
        // Get the <span> element that closes the modal
        var span = document.getElementsByClassName("close")[0];
        // When the user clicks the button, open the modal 
        var listSetValue = [];
        function actionDataDetail(varAction) {
            if (varAction === "add") {
                window.location.href = '/editBlog';
            }
            else if (varAction === "edit") {
                window.location.href = '/editBlog?id='+dataClick.id;
            }
        }

        // function actionData(varAction) {
        //     window.location.href = '/editBlog';
        // }

        function actionData(varAction) {
            setTimeout(function () {
                actionDataDetail(varAction);
            }, 300);

        }

        // When the user clicks on <span> (x), close the modal
        span.onclick = function () {
            //ationSelect
            modal.style.display = "none";
        }
        // When the user clicks anywhere outside of the modal, close it
        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

        function loaddingUser(linkUpdate, jsonValue) {
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: linkUpdate,
                data: jsonValue,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'Bearer ' + mname);
                },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    //location.reload();
                    gotoCheckUser(tableReport);
                },
                complete: function (loadcofig) {
                    console.log(loadcofig.responseText);
                    gotoCheckUser(tableReport);
                },
                error: function (loadcofig) {
                    console.log(loadcofig);
                }
            });
        }


        function loaddingAddUser() {
            var showData = {};
            for (var k in actionDataSelect.dataTableTitle) {
                showData[k] = null;
                if (k === 'station_id') {
                    showData[k] = parseInt($('#MAC').val(), 16);
                    continue;
                }
                if ($('#' + k).val()) {
                    showData[k] = $('#' + k).val();
                }
            }
            modal.style.display = "none";
            showData["add_table"] = tableReport;
            showData["action_table"] = "add";
            loaddingUser('/managerTable', showData);
        }

        function loaddingUppdateUser() {
            var showData = dataClick;
            if (!confirm("Bạn muốn sửa chứ")) {
                return;
            }
            for (var k in actionDataSelect.dataTableTitle) {
                if (k === 'station_id') {
                    showData[k] = parseInt($('#MAC').val(), 16);
                    continue;
                }
                if ($('#' + k).val()) {
                    showData[k] = $('#' + k).val();
                }
            }
            showData["add_table"] = tableReport;
            showData["action_table"] = "update";
            modal.style.display = "none";
            loaddingUser('/managerTable', showData);
        }
        function loaddingDeleteUser(item) {
            if (!confirm("Bạn muốn xóa chứ")) {
                return;
            }
            var idx = table.cell(item.parentElement.parentElement).index().row;
            var data = table.row(idx).data();
            var showData = data;
            showData["add_table"] = tableReport;
            showData["action_table"] = "delete";
            loaddingUser('/managerTable', showData);
        }

    </script>

</body>