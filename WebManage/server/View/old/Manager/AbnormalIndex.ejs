    <script type="text/javascript">
        $('#datatable').dataTable( {
            "language": {
            "emptyTable": "No data available in table"
            }
        });
        var mname = localStorage.getItem("tocken_LVC");
        var lisItemStation="";
		var tableReport='sparc_sensor_max_min';
            //gotoCheckUser(tableReport);
            gotoCheckUserStorage();

        var actionDataSelect=null;
        var dataSelectEdit=null;
        var dataClick=null;

        loadAllContent();
        setInterval(function(){
            loadAllContent();
        }, 60000);
        function assetDataBase(result){
            console.log("assetDataBase")
            $('#datatable').DataTable( { destroy: true } ).destroy();
            var showData= '<thead> <tr> <th data-field="station_id">Mã trạm</th><th data-field="createat"> Thời gian</th><th data-field="content"> Nội dung</th>';
            var columeShow=[ {data: "station_id"},  {data: "createat"}, {data: "content"}];

            $('#datatable').html(showData);
            var table = $('#datatable').DataTable ({"data" : result, columns: columeShow});
            $('#datatable tbody').on( 'click', 'td',
                function ()
                {
                    console.log(this);
                    var idx = table.cell( this ).index().row;
                    console.log(idx);
                    var data = table.row( idx ).data();
                    console.log(data);
                    dataClick=data; 
                }
            );

        }

           
        
        function loadAllContent(){
            var Link='http://localhost:3000/getAbnormalData';
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (result) {  
                        console.log('success')                   
                        assetDataBase(result);
                    }
                });
        }

    </script>

