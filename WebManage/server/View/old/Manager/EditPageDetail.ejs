    <script type="text/javascript">
      	var dataJson = "<%= dataPage %>";
        var listImage=[];
        var listSelectContent=[];
        console.log(dataJson);

       // $('#noiseChange').html(" <p> brr");
       
        $(document).ready( () => {
            $("#btnSubmit").click((event) => {
                //stop submit the form, we will post it manually.
                event.preventDefault();
                doAjax();
            });
        
        });
        function doAjax() {
            var form = $('#applicationForm')[0];
            var data = new FormData(form);
            $.ajax({
                type: "POST",
                enctype: 'multipart/form-data',
                url: "http://localhost:3000/uploadimage",
                data: data,
                processData: false, //prevent jQuery from automatically transforming the data into a query string
                contentType: false,
                cache: false,
                success: (data) => {
                    console.log(data);
                    var userData= 'http://localhost:3000/image/' +data.filename;
                    listImage.push(userData);
                    var stringData="";
                    for(var i=0;i<listImage.length;i++){
                         stringData +='<div class="slide-lvc"> <img src="'+listImage[i]+'" width="100px" onClick="coppyDataView('+i+')"/></div>';

                    }
                    $('#sliderUserImage').html(stringData);
                    
                    
                },
                error: (e) => {
                    console.log(e.responseText);
                }
            });
        }

        function coppyDataView(i){
            $('#datatoCoppy').html(listImage[i]);
        }

        function selectUserData(){
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: "http://localhost:3000/uploadimage",
                contentType: false,
                data: {
                    file:$('#fileSaveImage').val(),
                    title:title,
                    group:group,
		            maintitle:titleBody
                 },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    var string ="Đăng bài ";
                    if(loadcofig)  string+="thành công";
                    else string+="thất bại";
                    alert(string); 
                },
                error: function (loadcofig) {
                    console.log('error');
                    alert("Lỗi  đăng bài");
                   
                }
            });
        }



        function onSelectClick(value){
            console.log(value);
            var group=$('#selectTableDetail').val();
            var title=$('#titleInput').val();
            var titleBody=" du lieu";
            var startHtml= "<html> <head><title>"+ title+"</title> </head><body> ";

            var endHtml="</body></html";


            var valueHtml=startHtml+value+endHtml;


           
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: "http://localhost:3000/editPage",
                data: {
                    content:valueHtml,
                    title:title,
                    group:group,
                    maintitle:titleBody,
                    iddelete:dataJson
                 },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    var string ="Đăng bài ";
                    if(loadcofig)  string+="thành công";
                    else string+="thất bại";
                    alert(string);
                },
                error: function (loadcofig) {
                    console.log('error');
                    alert("Lỗi  đăng bài");
                   
                }
            });



           // gotoCheckUser(stringvalue);

        }
        function selectTableGroup(){
            var group=$('#selectTable').val();
            var showDataDetail="";
            for(var k=0;k< listSelectContent.length;k++) {
                let v=listSelectContent[k];
                if((v["content_group"].indexOf("_")>-1)&&(v["content_group"].indexOf(group)>-1))
                {
                    showDataDetail+='<option value="'+v["content_group"]+'">'+v["title"] +'</option>';
                }
                
            }
            $('#selectTableDetail').html(showDataDetail);
        }
        loadAllContent();
        function loadAllContent(){
            var Link='http://localhost:3000/report/content_group';
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        console.log('ssssssssssss');
                        var showData="";
                        var showDataDetail="";
                        listSelectContent=loadcofig.result;
                        for(var k=0;k< loadcofig.result.length;k++) {
                            let v=loadcofig.result[k];
                            if(v["content_group"].indexOf("_")<0){
                                showData+='<option value="'+v["content_group"]+'">'+v["title"] +'</option>'
                            }
                            else
                            {
                                showDataDetail+='<option value="'+v["content_group"]+'">'+v["title"] +'</option>';
                            }
                            
                        }

                        console.log(showData);
                       
                        $('#selectTable').html(showData);
                        $('#selectTableDetail').html(showDataDetail);
                        
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
        }
        
        loadAllPage(dataJson);
        function loadAllPage(dataJson){
            var Link='http://localhost:3000/detailPage';
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { pageid:dataJson},
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        console.log('ssssssssssss');
                      //  setTimeout(() =>  $('#noiseChange').html("loadcofig.data"), 1000);

                      

                    
                        if( loadcofig.main.length>0){
                            document.getElementById("noiseChange").value=loadcofig.data;
                            var theTextareas = document.getElementsByTagName("textarea");
                            for (var i = 0; i < theTextareas.length; i++)
                            {
                                var theTextarea = theTextareas[i];
                                
                                if (theTextarea.className.classExists("widgEditor"))
                                {
                                    if (theTextarea.id == "")
                                    {
                                        theTextarea.id = theTextarea.name;
                                    }
                                	setTimeout("new widgEditor('" + theTextarea.id + "')", 500 * (i));
                                }
                            }

                            $('#selectTable').val(loadcofig.main[0].group_file);
                            $('#selectTableDetail').val(loadcofig.main[0].group_file);
                           
                        }  
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
        }

    </script>



</html>
