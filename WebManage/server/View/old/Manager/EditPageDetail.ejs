<body>

   <center> <h2> Đăng bài </h2> </center> 
   <div style="height: auto;overflow: hidden;">
        <div style="width: 880px;float: right;">
            <div style="height: auto;overflow: hidden;">
                <div style="width: 700px;float: right;">
                    <div class="wrapper-lvc">   
                        <div id="sliderUserImage" class="text-center">
                            
                        </div>
                    </div>
                    <label id="datatoCoppy">coppy </label>

                </div>
                <div style="width: 180px; float: none;width: auto;overflow: hidden;">
                    <form method="POST" enctype="multipart/form-data" id="applicationForm">			
                        <div class="form-group"> 
                            <div class="form-group">
                                <input type="file" class="form-control" id="resume" placeholder="Upload File"  name="resume"></input>
                            </div>
                            <div>
                              <button type="submit" class="btn btn-primary" id="btnSubmit">Submit Application</button>
                            </div>
                        </div>
                    </form> 
                </div>
            </div>   
        </div>
        <div style="width: 100px; float: none;width: auto;overflow: hidden;">
            chuyên mục chính
            <select id="selectTable" onclick="selectTableGroup()" >
                <option value="newProduct"> sản phẩm mới</option>
                <option value="product">  các sản phẩm   </option>
                <option value="support">Góc hỗ trợ</option>
                <option value="video">video</option>
                <option value="communicate">cộng đồng</option>
            </select>
            <br/>
            chuyên mục phụ
            <select id="selectTableDetail"  >
                <option value="newProduct"> sản phẩm mới</option>
                <option value="product">  các sản phẩm   </option>
                <option value="support">Góc hỗ trợ</option>
                <option value="video">video</option>
                <option value="communicate">cộng đồng</option>
            </select>
            </br>
            Tiêu đề <input id="titleInput"/> 
        </div>
    </div>
    
<!-- END experimentInfo -->

    

	<div id="content">
        
		<form action="" onsubmit="onSelectClick(document.getElementById('noiseChange').value); return false;">
			<fieldset>
				<label for="noise">
					Nội dung bài viết:
				</label>
				<textarea id="noiseChange" name="noise" class="widgEditor nothing">
                    hu doa
                
                </textarea>
			</fieldset>
			<fieldset class="submit">
				<input type="submit" value="uploadDataa" />
			</fieldset>
        </form>
        <button onclick="onSelectClick(document.getElementById('noise').value)"> up lpad</button>
	</div>
