    <script type="text/javascript">
          var mname = localStorage.getItem("tocken_LVC");
          var lisItemGroupStation="";
          var lisItemStation="";
            var tableReport='sparc_acess_location_sensor';
            gotoCheckUserStorage();
            gotoCheckUser(tableReport);


            var actionDataSelect=null;
            var dataSelectEdit=null;
            var dataClick=null;
            /*$(document).ready(function() {
                $('#datatable').DataTable();
                
                gotoCheckUser();
                
            } ); */
            
// 0 là không cho hiện
// 1 là chỉ quyền admin thì mới cho hiện
// 2  không hiện
// 3 hiện dữ liệu không cho chỉnh sửa trừ admin
// 4 hiện dữ liệu cho chỉnh sửa
            function assetDataBase(result){
                actionDataSelect={dataTableTitle:result.dataReport.dataTableTitle,
                                    titleDataBase:result.dataReport.titleDataBase,
                                    titleReport:result.dataReport.titleReport};
                $('#datatable').DataTable( { destroy: true } ).destroy();
                var showData= '<thead> <tr>';
                var columeShow=[];
                for(var k in result.dataReport.dataTableTitle) {
                    if((result.dataReport.titleDataBase[k]>2)&&(result.dataReport.titleDataBase[k]<6)){
                      showData+=result.dataReport.dataTableTitle[k]
                      showData+='<th data-field="'+k+'">'+result.dataReport.dataTableTitle[k]+'</th>';
                      columeShow.push({ data: k});
                    }
                }
                columeShow.push({ data: "edit"});
                columeShow.push({ data: "delete"});
                showData += '<th>sửa</th><th>Xóa</th></tr></thead>';

                for(var k=0; k<result.result.length;k++) {
                    result.result[k]["edit"]='<p data-placement="top" data-toggle="tooltip" title="Edit"><button onclick="'+"actionData('edit')"+'" class="btn btn-primary btn-xs" data-title="Edit" data-toggle="modal" data-target="#edit" ><span class="glyphicon glyphicon-pencil"></span></button></p>';
                    result.result[k]["delete"]='<p data-placement="top" data-toggle="tooltip" title="Delete"><button onclick="'+"loaddingDeleteUser()"+'"  class="btn btn-danger btn-xs" data-title="Delete" data-toggle="modal" data-target="#delete" ><span class="glyphicon glyphicon-trash"></span></button></p>'; 
                }

                $('#datatable').html(showData);
                var table = $('#datatable').DataTable ({"data" : result.result, columns: columeShow});
                $('#datatable tbody').on( 'click', 'td',
                    function ()
                    {
                        console.log(this);
                        var idx = table.cell( this ).index().row;
                        console.log(idx);
                        var data = table.row( idx ).data();
                        console.log(data);
                        dataClick=data; 
                    }
                );

            }

           // gotoCheckUser();
            function gotoCheckUser(tableSelect){  
                if(tableSelect.length<1) return;
                var Link='http://localhost:3000/report/'+tableSelect;
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        console.log('ssssssssssss');
                        if(loadcofig.logout){
                            window.location.href = "http://localhost:3000";
                        }

                        
                        assetDataBase(loadcofig);
                        
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
            }

        loadAllContent();
        function loadAllContent(){
            var Link='http://localhost:3000/report/sparc_group_location_sensor';
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        lisItemGroupStation='<select id="id_group" style="width: 200px;" > <option value="0">không xác định </option>';
                        for(var k=0;k< loadcofig.result.length;k++) {
                            let v=loadcofig.result[k];
                            lisItemGroupStation+='<option value="'+v.id_group+'">'+v.name_group +'</option>';
                        }
                        var showData='</select>';
                        
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
        }


        
        loadAllContentStation();
        function loadAllContentStation(){
            var Link='http://localhost:3000/report/sparc_location_sensor';
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        lisItemStation='<select id="station_id" style="width: 200px;" > <option value="0">không xác định </option>';
                        for(var k=0;k< loadcofig.result.length;k++) {
                            let v=loadcofig.result[k];
                            lisItemStation+='<option value="'+v.station_id+'">'+v.content +'</option>';
                        }
                        var showData='</select>';
                        
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
        }


            var modal = document.getElementById("myModal");
            // Get the button that opens the modal
            // Get the <span> element that closes the modal
            var span = document.getElementsByClassName("close")[0];
            // When the user clicks the button, open the modal 
            var listSetValue=[];
            function actionData(varAction) {
                listSetValue=[];
                var showData=" <div> <h3>Thêm Trạm </h3> </div> <table> ";
                if(varAction==="add")
                {
                    for(var k in actionDataSelect.dataTableTitle) {
                        if(actionDataSelect.titleDataBase[k]>3){
                            if(actionDataSelect.titleDataBase[k]==8){
                                if(k==="station_id"){
                                    showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                    showData+='</th><th>'+lisItemStation+'</th></tr>';
                                }
                                else
                                if(k==="id_group"){
                                    showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                    showData+='</th><th>'+lisItemGroupStation+'</th></tr>';
                                }
                                
                            }
                            else
                            if(actionDataSelect.titleDataBase[k]==7){
                                showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                showData+='</th><th>'+lisItemStation+'</th></tr>';
                            }
                            else
                            if(actionDataSelect.titleDataBase[k]==6){
                                showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                showData+='</th><th>'+actionDataSelect.titleReport[k]+'</th></tr>';
                            } //lisItemStation
                            else
                            {
                                showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                showData+='</th><th><input type="text" id="'+k+'"/> </th></tr>';
                            }
                        }
                    }
                    showData+="</table> <br/> <button onclick='loaddingAddUser()'>Thêm </button>";
                    console.log(showData);
                    $('#ationSelect').html(showData);
                    modal.style.display = "block";
                  

                }
                else if(varAction==="edit")
                {
                    var showData=" <div> <h3>Sửa Trạm </h3> </div> <table> ";
                    for(var k in actionDataSelect.dataTableTitle) {
                        if(actionDataSelect.titleDataBase[k]>3){
                            if(actionDataSelect.titleDataBase[k]==8){
                                if(k==="station_id"){
                                    showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                    showData+='</th><th>'+lisItemStation+'</th></tr>';
                                    listSetValue.push({content:k,data:dataClick[k]});
                                }
                                else
                                if(k==="id_group"){
                                    showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                    showData+='</th><th>'+lisItemGroupStation+'</th></tr>';
                                    listSetValue.push({content:k,data:dataClick[k]});
                                }
                                
                            }
                            else
                            if(actionDataSelect.titleDataBase[k]==7){
                                showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                showData+='</th><th>'+lisItemStation+'</th></tr>';
                            }
                            else
                            if(actionDataSelect.titleDataBase[k]==6){
                                showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                showData+='</th><th>'+actionDataSelect.titleReport[k]+'</th></tr>';
                                listSetValue.push({content:k,data:dataClick[k]});
                            }
                            else
                            {
                                showData+=" <tr> <th>"+ actionDataSelect.dataTableTitle[k]
                                showData+='</th><th><input type="text" id="'+k+'" value="'+ dataClick[k]+'"" /></th> </tr>';
                            }
                       // showData+=" <tr> <th>"+actionDataSelect.dataTableTitle[k]
                        //showData+='</th><th><input type="text" id="'+k+'" value="'+ dataClick[k]+'"" /></th> </tr>';
                        }
                    }
                    showData+="</table> <br/> <button onclick='loaddingUppdateUser()'>Sửa </button>";
                    console.log(showData);
                    $('#ationSelect').html(showData);
                    modal.style.display = "block";
                    setTimeout(function(){
                        for(var i=0;i< listSetValue.length;i++)
                                $('#'+listSetValue[i].content).val(listSetValue[i].data);
                    }, 300);

                }
            }

            // When the user clicks on <span> (x), close the modal
            span.onclick = function() {
                //ationSelect
                modal.style.display = "none";
            }
            // When the user clicks anywhere outside of the modal, close it
            window.onclick = function(event) {
                if (event.target == modal) {
                    modal.style.display = "none";
                }
            }

            function loaddingUser(linkUpdate,jsonValue){
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: linkUpdate,
                    data: jsonValue,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                                success: function (loadcofig) {
                        console.log(loadcofig);
                        //location.reload();
                         gotoCheckUser(tableReport);
                    },
                    complete: function (loadcofig) {
                        console.log(loadcofig.responseText);
                         gotoCheckUser(tableReport);
                    },
                    error: function (loadcofig) {
                        console.log(loadcofig);
                    }
                });
            }


            function loaddingAddUser(){
                var showData={};
                for(var k in actionDataSelect.dataTableTitle) {
                      showData[k] =null;
                      if($('#'+k).val()){
                        showData[k]=$('#'+k).val();
                      }
                }
                console.log("loadcofig  loaddingAddUser");
                console.log(showData);
                modal.style.display = "none";
                 showData["add_table"]=tableReport;
                showData["action_table"]="add";
                loaddingUser('http://localhost:3000/managerTable',showData);
            }
            
            function loaddingUppdateUser(){
                var showData=dataClick;
                if (!confirm("Bạn muốn sửa chứ")) {
                        return;
                } 
                for(var k in actionDataSelect.dataTableTitle) {
                      if($('#'+k).val()){
                        showData[k]=$('#'+k).val();
                      }
                }
                 showData["add_table"]=tableReport;
                showData["action_table"]="update";
                modal.style.display = "none";
                loaddingUser('http://localhost:3000/managerTable',showData);
            }
            function loaddingDeleteUser(){
                var showData=dataClick;
                if (!confirm("Bạn muốn xóa chứ")) {
                        return;
                } 
                showData["add_table"]=tableReport;
                showData["action_table"]="delete";
                loaddingUser('http://localhost:3000/managerTable',showData);
            }

    </script>

</body>

