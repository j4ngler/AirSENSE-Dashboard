    <script>
        var totalPosts = 0;
        var pageSize = 10;
        var currentPage = 1;
        var totalPages = 0;
        var getTotalPosts = function() {
            var Link = '/getTotalPosts';
            $.ajax({
                type: 'get',
                dataType: 'json',
                url: Link,
                data: {},
                success: function (result) {
                    totalPosts = result.total;
                    totalPages = Math.ceil(totalPosts/pageSize);
                    choosePage();
                },
                error: function (err) { 
                }
            });
        }();

        function choosePage() {
            var Link = '/getBlogsPagination';
            $.ajax({
                type: 'get',
                dataType: 'json',
                url: Link,
                data: {
                    pageNumber: currentPage,
                    pageSize: pageSize
                },
                success: function (posts) {
                    render(posts);
                    rederPageLink();
                },
                error: function (err) { 
                }
            });
        };


        function render(posts) {
            var html = '';
            posts.forEach(function(post) {
                post.post_date = formatDate(post.post_date);
                html += '<div class="post">'+
                                '<div class="title">'+
                                    '<a href="/post?id='+post.ID+'">'+post.post_title+'</a>'+
                                '</div>'+
                                '<div class="detail">'+
                                    '<div class="image-intro">'+
                                        '<img style="height: 100px; width: 100px;" src="'+post.image_intro+'">'+
                                    '</div>'+
                                    '<div class="info">'+
                                        '<div class="crop">'+
                                            post.content_intro+
                                        '</div>'+
                                        '<div class="divider"></div>'+
                                        '<span class="data_info">'+post.post_date+'</span>'+
                                    '</div>'+
                                '</div>'+
                            '</div>'
            });
            $('#row-1198733960').html(html);
        }

        function rederPageLink() {
            let html = '';
            for(let i=1; i<=totalPages; i++) {
                if(i == currentPage) {
                    html += '<li><span aria-current="page" class="page-index page-number current">'+i+'</span></li>';
                } else if(i==currentPage+2) {
                    html += '<li><a class="next page-number" href="#"><span class="icon material-icons">navigate_next</span></a></li>';
                } else if(i==currentPage-2) {
                    html += '<li><a class="prev page-number" href="#"><span class="icon material-icons">navigate_before</span></a></li>';
                } else if(i>currentPage+2 || i<currentPage-2) {
                    continue;
                } else html+= '<li><a class="page-index page-number" href="#">'+i+'</a></li>';
            }
            $('.page-numbers').html(html);
        }

        $(document).on("click",".page-index",function(event) {
            event.preventDefault();
            currentPage = parseInt($(this).text());
            choosePage();
        });
        $(document).on("click",".prev",function(event) {
            event.preventDefault();
            currentPage--;
            choosePage();
        });
        $(document).on("click",".next",function(event) {
            event.preventDefault();
            currentPage++;
            choosePage();
        });


        function formatDate(date) {
            const d = new Date(date)
            const ye = new Intl.DateTimeFormat('en', { year: 'numeric' }).format(d)
            const mo = new Intl.DateTimeFormat('en', { month: 'long' }).format(d)
            const da = new Intl.DateTimeFormat('en', { day: '2-digit' }).format(d)
            date = `${mo} ${da}, ${ye}`;
            return date;
        }
 
    </script>
