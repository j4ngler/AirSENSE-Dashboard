    <script>
        var url = location.href;
        console.log('url is ' + url)
        var mname = localStorage.getItem("tocken_LVC");
        var allInfoStation=null;
        gotoCheckUserStorage();

        function getRandomColor() {
            var letters = '0123456789ABCDEF';
            var color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }


        function getConfig(arrayID,data,element,title,color) {

            var itemDaraw=[];
            for(var i=0;i<arrayID.length;i++){
                let item=arrayID[i];
                itemDaraw.push({
                    label: data[item].nameStation,
                    backgroundColor: color[i],
                    borderColor: color[i],
                    data: data[item].data,
                    fill: false,
                    showLine: true,
                    borderWidth: 1,
                });

            }
            var config = {
                type: 'scatter',
                data: {
                    //labels: strtime,
                    datasets: itemDaraw
                },
                options: {
                    responsive: true,
                    title: {
                        display: true,
                        text: title,
                        position: 'top'
                    },
                    tooltips: {
                        mode: 'index',
                        intersect: false,
                    },
                    hover: {
                        mode: 'nearest',
                        intersect: true
                    },
                    scales: {
                        xAxes: [{
                            type: 'time',
                            distribution: 'linear',
                            displayFormats: {
                                quarter: 'MMM YYYY'
                            }
                        }],
                        y: {
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: '%humi'
                            },
                        }
                    },
                    elements: {
                        point:{
                            radius: 0
                        }
                    },
                    annotation: {
                        annotations: [
                            {
                                drawTime: "afterDatasetsDraw",
                                id: "up",
                                type: "line",
                                mode: "horizontal",
                                scaleID: "y-axis-0",
                                value: 20,
                                borderColor: "red",
                                borderWidth: 0,
                                label: {
                                    backgroundColor: "red",
                                    content: "min",
                                    enabled: false
                                },
                            },
                            {
                                drawTime: "afterDatasetsDraw",
                                id: "low",
                                type: "line",
                                mode: "horizontal",
                                scaleID: "y-axis-0",
                                value: 10,
                                borderColor: "blue",
                                borderWidth: 0,
                                label: {
                                    backgroundColor: "red",
                                    content: "max",
                                    enabled: false
                                },
                            },
                        ]
                    }
                },
            };
            return config;
        }


        var reset = 0;
        function drawSensor(data){
            $(".no-data").hide();
            $(".dashboard").show();
            var color=[];
            if(data.result){
                var arrayData={};
                var arrayID=[];
                for(var i=0;i<data.result.length;i++){
                    let dataview=data.result[i];
                    var stationid='station'+dataview.station_id;
                    if(arrayData[stationid]) { // Covers 'undefined' as well
                        
                        arrayData[stationid].data.push(dataview);
                    } else {
                        var  nameStation="";
                        for(var j=0;j<allInfoStation.length;j++){
                            if(dataview.station_id===allInfoStation[j].station_id){
                                nameStation=allInfoStation[j].content;
                            }
                        }
                        color.push(getRandomColor());
                        arrayID.push(stationid);
                        arrayData[stationid]={nameStation:nameStation ,data:[]};
                        arrayData[stationid].data.push(dataview);
                    }   
                }
                console.log(arrayData);

                drawSingleChart(arrayID,arrayData,'Broad Temperature','broad_temp',color);
                drawSingleChart(arrayID,arrayData,'Broad vbat','vbat',color);
                drawSingleChart(arrayID,arrayData,'CH1 Temperature','ch1_temp',color);
                drawSingleChart(arrayID,arrayData,'CH2 Temperature','ch2_temp',color);
                drawSingleChart(arrayID,arrayData,'CH1 Frequence','ch1_freq',color);
                drawSingleChart(arrayID,arrayData,'CH2 Frequence','ch2_freq',color);
                reset = 1;
            }
        }

        function drawSingleChart(arrayID,data, title, property,color) {
            var broad_data={};
            for(var i=0;i<arrayID.length;i++){
                let itemBroad=arrayID[i];
                broad_data[itemBroad]={nameStation:data[itemBroad].nameStation ,data:[]};
                broad_data[itemBroad].data = data[itemBroad].data.map(item => ({'x': new Date(item.timestampe), 'y': item[property]}));
            }

            var config = getConfig(arrayID,broad_data,element,title,color);
            let max,min,max_enable=false, min_enable=false;

            if(property === 'broad_temp') {
                if(threshold.broad_temp_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.broad_temp;
                }
                if(threshold.broad_temp_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.broad_temp_min;
                }
            }
            
            if(property === 'vbat') {
                if(threshold.vbat_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.vbat_min;
                }
                if(threshold.vbat_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.vbat_max;
                }
            }
            if(property === 'ch1_freq') {
                if(threshold.ch1_freq_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.ch1_freq_min;
                }
                if(threshold.ch1_freq_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.ch1_freq;
                }
            }
            if(property === 'ch2_freq') {
                if(threshold.ch2_freq_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.ch2_freq_min;
                }
                if(threshold.ch2_freq_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.ch2_freq;
                }
            }
            if(property === 'ch1_temp') {
                if(threshold.ch1_temp_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.ch1_temp_min;
                }
                if(threshold.ch1_temp_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.ch1_temp;
                }
            }
            if(property === 'ch2_temp') {
                if(threshold.ch2_temp_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.ch2_temp_min;
                }
                if(threshold.ch2_temp_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.ch2_temp;
                }
            }

            if(min_enable) {
                config.options.annotation.annotations[0].scaleID = 'y-axis-1';
                config.options.annotation.annotations[0].value = min;
            }
            if(max_enable) {
                config.options.annotation.annotations[1].scaleID = 'y-axis-1';
                config.options.annotation.annotations[1].value = max;
            }

            var element = document.getElementById(property).getContext('2d');
            if(reset==1) {
                window[property].data.datasets = config.data.datasets;
                window[property].update();
            } else window[property] = new Chart(element, config);
            
        }





