            $('#popout').animate({ right: -373 }, 'slow');
        });

        function drawRightBarChart(stationId, property, title, field) {
            var Link = '/getDataRecent';
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: Link,
                data: {stationId: stationId},
                success: function (result) {
                    console.log('recent data: ', result);
                    if(field=='Temperature') {
                        $("#current-temp").text(Math.round(result[result.length-1].Temperature));
                    } else $("#current-humid").text(Math.round(result[result.length-1].Humidity));
                    let datasets = [];
                    let data = [];
                    result.map(item => data.push({x: new Date(item.Time*1000),y:item[field]}));
                    datasets.push({
                        label: title,
                        backgroundColor: window.chartColors.red,
                        borderColor: window.chartColors.red,
                        data: data,
                        fill: false,
                        showLine: true,
                        borderWidth: 1,
                    })
                    let config = {
                        type: 'line',
                        data: {
                            datasets: datasets
                        },
                        options: {
                            legend: {
                                display: false,
                            },
                            tooltips: {
                                callbacks: {
                                    label: function(tooltipItem) {
                                        console.log(tooltipItem)
                                        return tooltipItem.yLabel;
                                    }
                                },
                            },
                            responsive: true,
                            title: {
                                display: true,
                                text: title,
                                position: 'top'
                            },
                            tooltips: {
                                mode: 'index',
                                intersect: false,
                            },
                            hover: {
                                mode: 'nearest',
                                intersect: true
                            },
                            scales: {
                                xAxes: [{
                                    type: 'time',
                                    time: {
                                        time: {
                                            unit: 'hour'
                                        },
                                        displayFormats: {
                                            'hour': 'hA',
                                        }
                                    }
                                }],
                                yAxes: [{
                                    display: true,
                                    stacked: true,
                                    ticks: {
                                        min: 0,
                                    }
                                }]
                            },
                            elements: {
                                point:{
                                    radius: 0
                                }
