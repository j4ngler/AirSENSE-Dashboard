        function getRandomColor() {
            var letters = '0123456789ABCDEF';
            var color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }


        function getConfig(arrayID,data,element,title,color) {

            var itemDaraw=[];
            for(var i=0;i<arrayID.length;i++){
                let item=arrayID[i];
                itemDaraw.push({
                    label: data[item].nameStation,
                    backgroundColor: color[i],
                    borderColor: color[i],
                    data: data[item].data,
                    fill: false,
                    showLine: true,
                    borderWidth: 1,
                });

            }
            var config = {
                type: 'scatter',
                data: {
                    //labels: strtime,
                    datasets: itemDaraw
                },
                options: {
                    responsive: true,
                    title: {
                        display: true,
                        text: title,
                        position: 'top'
                    },
                    tooltips: {
                        mode: 'index',
                        intersect: false,
                    },
                    hover: {
                        mode: 'nearest',
                        intersect: true
                    },
                    scales: {
                        xAxes: [{
                            type: 'time',
                            distribution: 'linear',
                            displayFormats: {
                                quarter: 'MMM YYYY'
                            }
                        }],
                        y: {
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: '%humi'
                            },
                        }
                    },
                    elements: {
                        point:{
                            radius: 0
                        }
                    },
                    annotation: {
                        annotations: [
                            {
                                drawTime: "afterDatasetsDraw",
                                id: "up",
                                type: "line",
                                mode: "horizontal",
                                scaleID: "y-axis-0",
                                value: 20,
                                borderColor: "red",
                                borderWidth: 0,
                                label: {
                                    backgroundColor: "red",
                                    content: "min",
                                    enabled: false
                                },
                            },
                            {
                                drawTime: "afterDatasetsDraw",
                                id: "low",
                                type: "line",
                                mode: "horizontal",
                                scaleID: "y-axis-0",
                                value: 10,
                                borderColor: "blue",
                                borderWidth: 0,
                                label: {
                                    backgroundColor: "red",
                                    content: "max",
                                    enabled: false
                                },
                            },
                        ]
                    }
                },
            };
            return config;
        }


        var reset = 0;
        function drawSensor(data){
            $(".no-station").hide();
            $(".no-data").hide();
            $(".dashboard").show();
            var color=[];
            if(data.length){
                var arrayData={};
                var arrayID=[];
                for(var i=0;i<data.length;i++){
                    let dataview=data[i];
                    var stationid='station'+dataview.station_id;
                    if(arrayData[stationid]) { // Covers 'undefined' as well
                        
                        arrayData[stationid].data.push(dataview);
                    } else {
                        var  nameStation="";
                        for(var j=0;j<allInfoStation.length;j++){
                            if(dataview.station_id===allInfoStation[j].station_id){
                                nameStation=allInfoStation[j].content;
                            }
                        }
                        color.push(getRandomColor());
                        arrayID.push(stationid);
                        arrayData[stationid]={nameStation:nameStation ,data:[]};
                        arrayData[stationid].data.push(dataview);
                    }   
                }
                console.log('arrayData: ',arrayData);
                console.log('arrayID: ',arrayID);
                drawSingleChart(arrayID,arrayData,'PM2p5','PM2p5',color);
                drawSingleChart(arrayID,arrayData,'PM10','PM10',color);
                drawSingleChart(arrayID,arrayData,'PM1','PM1',color);
                drawSingleChart(arrayID,arrayData,'Temperature','Temperature',color);
                drawSingleChart(arrayID,arrayData,'Humidity','Humidity',color);
                reset = 1;
            } else {
                $(".no-data").show();
                $(".dashboard").hide();
                $(".no-station").hide();
            }
        }

        function drawSingleChart(arrayID,data, title, property,color) {
            console.log('data: ',data);
            var broad_data={};
            for(var i=0;i<arrayID.length;i++){
                let itemBroad=arrayID[i];
                broad_data[itemBroad]={nameStation:data[itemBroad].nameStation ,data:[]};
                broad_data[itemBroad].data = data[itemBroad].data.map(item => ({'x': new Date(item.Time*1000), 'y': item[property]}));
            }


            var config = getConfig(arrayID,broad_data,element,title,color);
            let max,min,max_enable=false, min_enable=false;

            if(property === 'PM2p5') {
                if(threshold.pm25_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.pm25_min;
                }
                if(threshold.pm25_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.pm25_max;
                }
            }
            
            if(property === 'PM10') {
                if(threshold.pm10_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.pm10_min;
                }
                if(threshold.pm10_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.pm10_max;
                }
            }
            if(property === 'PM1') {
                if(threshold.pm1_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.pm1_min;
                }
                if(threshold.pm1_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.pm1_max;
                }
            }
            if(property === 'Temperature') {
                if(threshold.temp_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.temp_min;
                }
                if(threshold.temp_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.temp_max;
                }
            }
            if(property === 'Humidity') {
                if(threshold.humid_min_enanble === 1) {
                    min_enable = true;
                    min = threshold.humid_min;
                }
                if(threshold.humid_max_enanble === 1) {
                    max_enable = true;
                    max = threshold.humid_max;
                }
            }

            //tam thoi khong hien thi nguong max min
            max_enable=false, min_enable=false;

            if(min_enable) {
                config.options.annotation.annotations[0].scaleID = 'y-axis-1';
                config.options.annotation.annotations[0].value = min;
            }
            if(max_enable) {
                config.options.annotation.annotations[1].scaleID = 'y-axis-1';
                config.options.annotation.annotations[1].value = max;
            }

            var element = document.getElementById(property).getContext('2d');
            if(reset==1) {
                window[property].data.datasets = config.data.datasets;
                window[property].update();
            } else window[property] = new Chart(element, config);
            
        }



