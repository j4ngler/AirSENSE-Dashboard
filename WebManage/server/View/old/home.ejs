        function gotoCheckData(isShowLoader){  
            console.log("go to check data");
            var data=document.getElementById("selectTable").value;
            var Link='/api/social/getdata';
            var fromTime = new Date($('#fromTime').val());
            var now = new Date().getTime()/1000;
            if(fromTime==undefined || now-fromTime/1000>3*24*60*60) {
                $("#fromTime").val(new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toJSON().slice(0,19));
            }
            var toTime = new Date($('#toTime').val());
            if(isNaN(fromTime.getFullYear())) {
                fromTime = undefined;
            } else fromTime = fromTime.getTime()/1000;
            if(isNaN(toTime.getFullYear())) {
                toTime = undefined;
            } else toTime = toTime.getTime()/1000;
            if(isShowLoader != false) {
                showLoader();
            }
            if(!!!data) return;
            console.log(" data .............request.body.....",{data:data, fromTime: fromTime, toTime: toTime});
            document.getElementsByClassName("dashboard")[0].style.display = "none";
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: Link,
                //data: {data:data, fromTime: fromTime, toTime: toTime},
                data: JSON.stringify({data:data, fromTime: fromTime, toTime: toTime}), // body data type must match "Content-Type" header
                cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                credentials: 'same-origin', // include, *same-origin, omit
                redirect: 'follow', // manual, *follow, error
                referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                dataType: 'json',
                cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                credentials: 'same-origin', // include, *same-origin, omit
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'Authorization': 'Beard ' + mname,
