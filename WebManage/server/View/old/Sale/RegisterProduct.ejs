<body>
    <h2>The three greatest things you learn from traveling</h2>
<!-- END experimentInfo -->

	<div id="content">
        <div >
            <div  style="width: 25%; float: left; box-sizing: border-box;">
                <div>
                    chuyên mục
                    <select id="selectTable" >
                        <option value="newProduct"> sản phẩm mới</option>
