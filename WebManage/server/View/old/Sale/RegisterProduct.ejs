                  </select>
                
                </br>
                 Tiêu đề <input id="titleInput"/> 
                </div>
                <button onclick="onSelectClick1();"> up lpad</button>
            </div>
            <div  style="width: 75%; float: left; box-sizing: border-box;">
                <main>
                    <div class="centered">
                        <div class="document-editor">
