<!-- END content -->
</body>


    <script type="text/javascript">
        var dataJsonPage = "<%= dataPage %>";
        var mname = localStorage.getItem("tocken_LVC");

        class UploadAdapter {
            constructor(loader) {
                this.loader = loader;
            }
            upload() {

                return this.loader.file
            .then( file => new Promise( ( resolve, reject ) => {
                const data = new FormData();
                    data.append('resume', file);

                    $.ajax({
                        type: "POST",
                        enctype: 'multipart/form-data',
                        url: "http://localhost:3000/uploadimage",
                        data: data,
                        processData: false, //prevent jQuery from automatically transforming the data into a query string
                        contentType: false,
                        cache: false,
                        success: (data1) => {
                            console.log(data1);
                            if (data1.filename) {  
                                resolve({
                                    default: 'http://localhost:3000/image/' +data1.filename
                                });
                            } else {
                                reject(false);
                            }
                            
                        },
                        error: (e) => {
                            console.log(e.responseText);
                        }
                    });
            } ) );

            }
            abort() {
            }
        }
    

        DecoupledEditor
            .create( document.querySelector( '#editor' ), {
                // toolbar: [ 'heading', '|', 'bold', 'italic', 'link' ]
            } )
            .then( editor => {
                const toolbarContainer = document.querySelector( 'main .toolbar-container' );

               toolbarContainer.prepend( editor.ui.view.toolbar.element );

                window.editor = editor;
                editor.plugins.get('FileRepository').createUploadAdapter = (loader)=>{
                    return new UploadAdapter(loader);
                };
            } )
            .catch( err => {
                console.error( err.stack );
                console.log(err);
            } );

        function onSelectClick1(){
            const editorData = editor.getData();
            onSelectClick(editorData);
        }

        function onSelectClick(value){
            console.log(value);
            var title=$('#titleInput').val();
            var startHtml= "<html> <head><title>"+ title+"</title> </head><body> ";
            var endHtml="</body></html>";
            var valueHtml=startHtml+value+endHtml;
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: "http://localhost:3000/uploadProduct",
                data: {
                    productid:dataJsonPage,
                    title:title,
                    content:valueHtml
                },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    var string ="Đăng bài ";
                    if(loadcofig)  string+="thành công";
                    else string+="thất bại";
                    alert(string);
                },
                error: function (loadcofig) {
                    console.log('error');
                    alert("Lỗi  đăng bài");
                   
                }
            });
        }
    

    </script>



</html>
