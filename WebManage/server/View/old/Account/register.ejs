<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Đăng ký</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="favicon.ico">
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <!-- vector map CSS -->
    <link href="/old/assets/vendors/bower_components/jasny-bootstrap/dist/css/jasny-bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Custom CSS -->
    <link href="/old/assets/css/style.css" rel="stylesheet" type="text/css">

    <style>
        .suport-item{
            width: 380px;
             margin: 5px;
        }
       
        </style>
    
</head>

<body>
    <!--Preloader-->
    <div class="preloader-it">
        <div class="la-anim-1"></div>
    </div>
    <!--/Preloader-->
    <div class="wrapper pa-0">
        <header class="sp-header">
            <div class="sp-logo-wrap pull-left">
                <a href="/" title="Airsense - Quan trắc chất lượng không khí" rel="home">
                    <img class="brand-img mr-10" src="/old/resource/airsense.vn/wp-content/uploads/2020/04/airsense.png" width="200" height="50" alt="brand" />
                </a>
            </div>
            <div class="form-group mb-0 pull-right">
                <span class="inline-block pr-10">Bạn đã có tài khoản?</span>
                <a class="inline-block btn btn-primary btn-rounded" href="login">Đăng nhập</a>
            </div>
            <div class="clearfix"></div>
        </header>
        <!-- Main Content -->
        <div class="page-wrapper pa-0 ma-0 auth-page">
            <div class="container-fluid">
                <!-- Row -->
                <div class="table-struct full-width full-height">
                    <div class="table-cell vertical-align-middle auth-form-wrap">
                        <div class="auth-form  ml-auto mr-auto no-float card-view pt-30 pb-30">
                            <div class="row">
                                <div class="col-sm-12 col-xs-12">
                                    <div class="mb-30">
                                        <h3 class="text-center txt-dark mb-10">Đăng ký </h3>
                                    </div>
                                    <div class="form-wrap">
                                        <form action="#">
                                            <div class="form-group">
                                                <input type="text" class="form-control  suport-item" required="" id="fullname" placeholder="Họ và tên">
                                            </div>
                                            <div class="form-group">
                                                <input type="email" class="form-control suport-item" required="" id="email" placeholder="Email">
                                            </div>
                                            <div class="form-group">
                                                <input type="text" class="form-control suport-item" required="" id="phoneNumber" placeholder="Số điện thoại">
                                            </div>
                                            <div class="form-group">
                                                <input type="password" class="form-control suport-item" required="" id="pass" placeholder="Mật khẩu">
                                            </div>
                                            <div class="form-group">
                                                <input type="text" class="form-control suport-item" required="" id="address" placeholder="Địa chỉ">
                                            </div>
                                            <div class="form-group">
                                                <div class="checkbox checkbox-primary pr-10 pull-left">
                                                    <input id="checkbox_2" required="" type="checkbox">
                                                    <label for="checkbox_2"> Tôi đồng ý với <span class="txt-primary">điều khoản dịch vụ</span>
                                                    </label>
                                                </div>
                                                <div class="clearfix"></div>
                                            </div>
                                            <div class="form-group text-center">
                                                <button type="submit" onclick="summitUser()" class="btn btn-primary btn-rounded">Đăng ký</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Row -->
            </div>
        </div>
        <!-- /Main Content -->
    </div>
    <!-- /#wrapper -->
    <!-- JavaScript -->
    <!-- jQuery -->
    <script src="/old/assets/vendors/bower_components/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap Core JavaScript -->
    <script src="/old/assets/vendors/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/old/assets/vendors/bower_components/jasny-bootstrap/dist/js/jasny-bootstrap.min.js"></script>
    <!-- Slimscroll JavaScript -->
    <script src="/old/assets/js/jquery.slimscroll.js"></script>
    <!-- Init JavaScript -->
    <script src="/old/assets/js/init.js"></script>
    <script>
    // Get the modal

    //console.log(dataLink);
    function validateEmail(email) {
        var re = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        return re.test(email);
    }

    function summitUser() {
        var linkUpdate = '/api/auth/register';

        if ($('#fullname').val().length < 4) {
            alert("độ dài Họ tên lớn hơn 4");
            return;
        }
        if ($('#pass').val().length < 8) {
            alert("pass quá ngắn");
            return;
        }
        if ($('#fullname').val().length < 4) {
            alert("độ dài Họ tên lớn hơn 4");
            return;
        }

        var phoneno = /^\(?([0-9]{3})\)?[-. ]?([0-9]{3})[-. ]?([0-9]{4})$/;
        if (!$('#phoneNumber').val().match(phoneno)) {
            alert("Số điện thaoi không hợp lệ");
            return;
        }
        if (!validateEmail($('#email').val())) {
            alert("Sai định dạng email");
            return;
        }

        if ($('#address').val().length < 4) {
            alert("Xin vui lòng nhập địa chỉ");
            return;
        }
        $.ajax({
            type: 'post',
            dataType: 'json',
            url: linkUpdate,
            data: {
                name: "registerbycomputer",
                fullname: $('#fullname').val(),
                phoneNumber: $('#phoneNumber').val(),
                password: $('#pass').val(),
                email: $('#email').val(),
                address: $('#address').val()
            },
            cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
            credentials: 'same-origin', // include, *same-origin, omit
            redirect: 'follow', // manual, *follow, error
            referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
            dataType: 'json',
            cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
            credentials: 'same-origin', // include, *same-origin, omit
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'Authorization': 'Beard ' + localStorage.getItem('token'),
                // 'Content-Type': 'application/x-www-form-urlencoded',
            },
            success: function(loadcofig) {
                console.log(loadcofig);
                if (!loadcofig.tocken) {
                    alert(loadcofig.note);
                } else {
                    localStorage.setItem("tocken_LVC", loadcofig.tocken);
                    localStorage.setItem("name_LVC", $('#fullname').val());
                    alert("Bạn đã đăng ký thành công");
                    window.location.href = "http://localhost:3000/";
                }

            },
            complete: function(loadcofig) {
                console.log(loadcofig.responseText);
            },
            error: function(loadcofig) {
                console.log(loadcofig.responseText);
            }
        });
    }
    // When the user clicks anywhere outside of the modal, close it
    </script>
</body>

</html>