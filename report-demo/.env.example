# Sao chép thành file .env và điền giá trị thật.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env  (Windows CMD)

# --- App ---
PORT=3010
REPORT_DEMO_TITLE=AirSENSE Report Demo
REPORT_DEMO_REFRESH_MS=10000
# Múi giờ đặt tên file đo MMDDYYYY_HHMM (trùng ESP). Ví dụ: Asia/Ho_Chi_Minh
# TZ=Asia/Ho_Chi_Minh

# API key cho app mobile (Android) khi gọi /api/enose qua Internet.
# Để trống = không bắt buộc (chế độ LAN). Khi đặt giá trị: client phải gửi
# header `X-API-Key: <value>`. Web cùng máy chủ vẫn dùng được nhờ bypass localhost.
APP_API_KEY=

# --- SQL (PostgreSQL khuyến nghị; hoặc mysql) ---
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=reportdemo
DB_PASSWORD=reportdemo
DB_NAME=reportdemo

# Nếu dùng MySQL thay vì PostgreSQL:
# DB_CLIENT=mysql
# DB_PORT=3306

# --- MongoDB ---
APP_MONGO=mongodb://127.0.0.1
APP_MONGO_PORT=27017
APP_MONGO_USER=
APP_MONGO_PASS=
APP_MONGO_TABLE=airsense
MONGO_AUTH_SOURCE=admin

# --- MQTT broker ---
MQTT_BROKER_URL=mqtt://127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=report_demo

# Tuỳ chọn: URL thư mục HTTP nơi thiết bị/laptop phục vụ file .csv (có dấu / cuối). Dashboard sẽ hiện nút "File server".
# MEASUREMENT_FILE_BASE_URL=http://192.168.1.100/measurements/
