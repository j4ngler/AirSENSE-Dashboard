        var data = {
          fromTime: fromTime,
          toTime: toTime,
          station_id: station_id,
          getFromTime: getFromTime,
          getToTime: getToTime,
        };

        var link = "/api/shrimp_lake/getReportStations";
        console.log(data);
        $.ajax({
          type: "post",
          method: "POST",
          url: link,
          data: JSON.stringify({
            station_id: station_id,
            fromTime: fromTime,
