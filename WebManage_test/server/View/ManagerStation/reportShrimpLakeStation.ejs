      function exportReport() {
        var fromTime = new Date($("#fromTime").val());
        const getFromTime = fromTime.getTime();
        var toTime = new Date($("#toTime").val());
        const getToTime = toTime.getTime();
        var station_id = document.getElementById("selectTable").value;
        if (!station_id) {
          alert("Vui lòng chọn trạm để xuất báo cáo");
          return;
        }
        if (isNaN(fromTime.getFullYear())) {
          fromTime = undefined;
        } else
          fromTime =
            fromTime.getFullYear() +
            "-" +
            fromTime.getMonth() +
            "-" +
            fromTime.getDate() +
            " " +
            fromTime.getHours() +
            ":" +
            fromTime.getMinutes() +
            ":00";
        if (isNaN(toTime.getFullYear())) {
          toTime = undefined;
        } else
          toTime =
            toTime.getFullYear() +
            "-" +
            toTime.getMonth() +
            "-" +
            toTime.getDate() +
            " " +
            toTime.getHours() +
            ":" +
            toTime.getMinutes() +
            ":00";

        var now = new Date().getTime() / 1000;
        // if(fromTime==undefined || now-fromTime/1000>3*24*60*60) {
        //     $("#fromTime").val(new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toJSON().slice(0,19));
        // }
