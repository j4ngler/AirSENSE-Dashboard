<section id="best-seller-section">
    <h2 class="best-seller-caption text-center">Linh Kiện</h2>
    <div class="row best-seller-group grid" id="best-seller-book">
      
    </div>
    <div class="best-seller-load-more text-center">
      <button type="button" class="btn btn-outline-primary" onclick="loadAnotherGroupBook()">Load more</button>
    </div>
  </section>

  <script type="text/javascript">
    
    var jsonItemBook=[];
    var lstGroupBook={product_group:2,start:-5,end:0};
    loadAnotherGroupBook();

    function loadAnotherGroupBook(){
        lstGroupBook.start+=5;
        lstGroupBook.end+=5;
        postInfoData('/api/customers/lst_product',lstGroupBook,(data)=>{
          if(!data.error){
            data.result.forEach((element) => {
              if(jsonItemBook.findIndex(o=>(o.product_id==element.product_id))<0) 
                jsonItemBook.push(element);
            });
            
            setFillertProductToView(jsonItemBook,"#best-seller-book");
          }
          
        });
    }
    
  </script>