    <script type="text/javascript">
        function repyQuestion(){
            var aNodes = document.getElementById('check_question_id');
            var bNodes = aNodes.getElementsByTagName('input');
            var stringInfoValue=[];
            var TextIndex =['A','B','C','D','E','F','G','H'];
            for(var i=0;i<bNodes.length;i++) {
                console.log("bNodes textContent",bNodes[i],bNodes[i].checked );
                if(bNodes[i].checked)
                    stringInfoValue.push(TextIndex[i]);
            }
            alert(" cau tra lời là "+ stringInfoValue);
        }

    </script>

  <script type="text/javascript">

    var dataView = '<%= detail %>';
    var linkAcess =
      'http://' + window.location.hostname + ':' + window.location.port + '/' +
      dataView.replaceAll('+', '/');
    console.log(linkAcess);
    // document.getElementById("htmlToView").src = linkAcess;

    $.ajax({
      type: 'GET',
      enctype: 'multipart/form-data',
      url: linkAcess,
      data: {},
      processData: false, //prevent jQuery from automatically transforming the data into a query string
      contentType: false,
      cache: false,
      success: (data) => {
        console.log(data);
        $('#htmlToView').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
        $('html, body').animate({ scrollTop: 0 }, 'fast');
      },
      error: (e) => {
        console.log(e.responseText);
      },
    });

    // Bookmark
    const bookmark = document.querySelector('.blog-detail__icon-bookmark');
    bookmark.onclick = () =>
      bookmark.classList.toggle('blog-detail__icon-bookmark--active');

    // Like
    const likeAside = document.querySelector('.blog-aside__like');
    const likeBottom = document.querySelector('.blog-bottom__like');
    const likeAsideIcon = document.querySelector('.blog-aside__like-icon');
    const likeBottomIcon = document.querySelector('.blog-bottom__like-icon');

    likeBottom.onclick = () => {
      likeBottomIcon.classList.toggle('blog-bottom__like-icon--active');
      likeAsideIcon.classList.toggle('blog-aside__like-icon--active');
    };

    likeAside.onclick = () => {
      likeBottomIcon.classList.toggle('blog-bottom__like-icon--active');
      likeAsideIcon.classList.toggle('blog-aside__like-icon--active');
    };

    // Option
    const ellipsis = document.querySelector('.blog-detail__ellipsis');
    const option = document.querySelector('.blog-detail__option');
    const optionList = document.querySelector('.blog-detail__option-list');
    const optionItems = document.querySelectorAll('.blog-detail__option-item');
    const optionIcons = document.querySelectorAll('.blog-detail__option-icon');
    const optionDescriptions = document.querySelectorAll('.blog-detail__option-description');
    ellipsis.onclick = () => {
      option.classList.add('blog-detail__option--show');
    };

    const check = function (eventTarget, optionElements) {
      let i = 0;
      optionElements.forEach(function (item) {
        if (item != eventTarget) i++;
      });
      if (i == optionElements.length) {
        return true;
      } else {
        return false;
      }
    };

    window.onclick = (event) => {
      if (
        event.target != ellipsis &&
        event.target.parentNode != ellipsis
      ) {
        option.classList.remove('blog-detail__option--show');
      }
    };

    // Comment
    const messageButtons = [document.querySelector('.blog-aside__comment'), document.querySelector('.blog-bottom__comment')];
    const closeButton = document.querySelector('.comment-close');
    const modal = document.querySelector('.modal');
    const commentContainer = document.querySelector('.comment-container');

    const showComment = () => {
      Object.assign(commentContainer.style, {
        transform: 'translateX(0%)',
        opacity: '1',
      });


      modal.classList.add('modal--show')

    };

    messageButtons.forEach((messageButton) => {
      messageButton.addEventListener('click', showComment);
    });

    // const closeComment = () => {

    //   modal.classList.add('modal--show')
    // };
    // messageButtons.forEach((messageButton) => {
    //   messageButton.addEventListener('click', showComment);
    // });
    const closeComment = () => {

      if (document.body.offsetWidth >= 970) {
        Object.assign(commentContainer.style, {
          transform: 'translateX(200%)',
          opacity: '0',
        });
      } else {
        Object.assign(commentContainer.style, {
          transform: 'translateY(-200%)',
          opacity: '0',
        });
      }

      setTimeout(function () {
        modal.classList.remove('modal--show')
      }, 200);
    };


    closeButton.onclick = () => closeComment();

    modal.onclick = () => closeComment();

    commentContainer.onclick = (event) => event.stopPropagation();

    closeButton.onclick = () => closeComment();
    modal.onclick = () => closeComment();
    commentContainer.onclick = (event) => event.stopPropagation();
  </script>

