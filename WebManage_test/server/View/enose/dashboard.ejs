        // Auto-refresh dữ liệu từ AirSENSE collection
        function startAirSENSERefresh() {
            if (airsenseDataInterval) {
                clearInterval(airsenseDataInterval);
            }
            
            airsenseDataInterval = setInterval(() => {
                loadLatestSensorDataFromAirSENSE();
                // Có thể refresh history mỗi 30 giây
                if (Math.random() < 0.2) { // 20% chance mỗi lần refresh
                    loadMeasurementHistoryFromAirSENSE();
                }
            }, 5000); // 5 giây
        }

        // Khởi tạo khi trang load - Load từ AirSENSE collection
        // Đảm bảo load device list trước, sau đó mới start refresh
        loadDeviceListFromAirSENSE().then(() => {
            // Sau khi có device list và currentDeviceId đã được set, start refresh sensor data
            if (currentDeviceId) {
                startAirSENSERefresh();
            } else {
                console.warn('⚠️ Không có device để load sensor data');
            }
        }).catch(error => {
            console.error('❌ Error loading device list:', error);
        });

        // Cleanup khi trang unload
        window.addEventListener('beforeunload', function() {
            if (airsenseDataInterval) {
                clearInterval(airsenseDataInterval);
            }
        });
    </script>
