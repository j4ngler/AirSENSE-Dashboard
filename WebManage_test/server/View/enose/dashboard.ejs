        function displayMEMSSensors(sensorData) {
            // Tên các cảm biến MEMS (tương ứng với ADC channels)
            const memsSensorNames = ['EtOH3', 'EtOH4', 'EtOH5', 'EtOH6', 'EtOH1', 'EtOH2', 'VOC1', 'VOC2'];
            const row = document.getElementById('memsSensorsRow');
            row.innerHTML = '';
            
            let hasMEMSData = false;
            
            // Tìm dữ liệu ADC từ sensorData
            // Có thể có trong các format: adc_values, ADC_Value, hoặc từ data_type riêng lẻ
            let adcValues = null;
            
            // Thử tìm từ object có adc_values hoặc ADC_Value
            const adcDataItem = sensorData.find(d => d.adc_values || d.ADC_Value || d.adc);
            if (adcDataItem) {
                adcValues = adcDataItem.adc_values || adcDataItem.ADC_Value || adcDataItem.adc;
            }
            
            // Nếu không tìm thấy array, thử tìm từng sensor riêng lẻ với data_type là adc0, adc1, etc.
            if (!adcValues || !Array.isArray(adcValues)) {
                adcValues = [];
                for (let i = 0; i < 8; i++) {
                    const adcItem = sensorData.find(d => 
                        d.data_type === `adc${i}` || 
                        d.data_type === `ADC${i}` ||
                        d.data_type === `mems${i + 1}` && d.adc_value !== undefined
                    );
                    if (adcItem) {
                        adcValues[i] = adcItem.value || adcItem.adc_value || 0;
                    } else {
                        // Tìm từ mems sensors - ưu tiên adc_value, sau đó value
                        const memsItem = sensorData.find(d => d.data_type === `mems${i + 1}`);
                        if (memsItem) {
                            // Ưu tiên adc_value, nếu không có thì dùng value (có thể là ADC hoặc voltage)
                            adcValues[i] = memsItem.adc_value !== undefined ? memsItem.adc_value : 
                                          (memsItem.value !== undefined ? memsItem.value : null);
                        } else {
                            adcValues[i] = null;
                        }
                    }
                }
            }
            
            // QUAN TRỌNG: Cập nhật cache với giá trị mới (nếu có), giữ lại giá trị cũ nếu null
            // YÊU CẦU: Giữ lại giá trị cũ trong 10 giây trước khi cập nhật
            const now = Date.now();
            const CACHE_DURATION_MS = 10 * 1000; // 10 giây
            
            for (let i = 0; i < 8; i++) {
                if (adcValues && adcValues[i] !== null && adcValues[i] !== undefined) {
                    // Có giá trị mới → cập nhật cache và timestamp
                    lastValidADCValues[i] = adcValues[i];
                    lastValidADCTimestamps[i] = now;
                }
                // Nếu null, giữ lại giá trị cũ trong cache (không cập nhật timestamp)
            }
            
            // Hiển thị các cảm biến MEMS với giá trị ADC
            // Chỉ dùng giá trị cũ nếu còn trong 10 giây, nếu quá 10 giây thì hiển thị "--"
            memsSensorNames.forEach((sensorName, index) => {
                let adcValue = null;
                
                // Ưu tiên giá trị mới
                if (adcValues && adcValues[index] !== null && adcValues[index] !== undefined) {
                    adcValue = adcValues[index];
                } else if (lastValidADCValues[index] !== null && lastValidADCValues[index] !== undefined) {
                    // Kiểm tra xem giá trị cũ còn trong 10 giây không
                    const lastUpdateTime = lastValidADCTimestamps[index];
                    if (lastUpdateTime && (now - lastUpdateTime) <= CACHE_DURATION_MS) {
                        // Giá trị cũ còn trong 10 giây → dùng giá trị cũ
                        adcValue = lastValidADCValues[index];
                    } else {
                        // Giá trị cũ đã quá 10 giây → không dùng (sẽ hiển thị "--")
                        adcValue = null;
                    }
                }
                
                // Validate: chỉ hiển thị nếu là số nguyên và có giá trị hợp lệ (không phải test data)
                // Test data thường là 102, 202, 302... (pattern: index * 100 + 2)
                const numValue = parseInt(adcValue);
                const isTestData = numValue > 0 && numValue < 1000 && (numValue % 100 === 2 || numValue % 100 === 0);
                
                // Render card cho cảm biến (có giá trị hoặc không)
                const col = document.createElement('div');
                col.className = 'col-md-3 col-sm-6';
                
                if (adcValue !== null && adcValue !== undefined && !isNaN(numValue) && !isTestData) {
                    hasMEMSData = true;
                    col.innerHTML = `
                        <div class="mq-sensor-card">
                            <div class="mq-sensor-label">${sensorName}</div>
                            <div class="mq-sensor-value">${numValue}</div>
                            <div class="mq-sensor-unit">ADC</div>
                        </div>
                    `;
                } else {
                    // Không có giá trị hợp lệ → hiển thị "--"
                    col.innerHTML = `
                        <div class="mq-sensor-card">
                            <div class="mq-sensor-label">${sensorName}</div>
                            <div class="mq-sensor-value" style="color: #cbd5e1;">--</div>
                            <div class="mq-sensor-unit">ADC</div>
                        </div>
                    `;
                }
                row.appendChild(col);
            });
            
            if (hasMEMSData) {
                // document.getElementById('memsSensorsChartContainer').style.display = 'block'; // Commented out
            }
        }

