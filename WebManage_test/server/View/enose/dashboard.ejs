        // Start measurement
        function initStartMeasurementButton() {
            const startBtn = document.getElementById('startMeasurementBtn');
            if (!startBtn) {
                console.error('❌ startMeasurementBtn not found!');
                setTimeout(initStartMeasurementButton, 100); // Retry sau 100ms
                return;
            }
            
            // Remove existing listeners bằng cách clone
            const newBtn = startBtn.cloneNode(true);
            startBtn.parentNode.replaceChild(newBtn, startBtn);
            
            newBtn.addEventListener('click', async () => {
            const btn = document.getElementById('startMeasurementBtn');
            const statusContent = document.getElementById('statusContent');
            
            // Kiểm tra lại xem có measurement đang chạy không trước khi start
            // Đảm bảo button không bị enable lại bởi checkActiveMeasurement
            try {
                const activeCheck = await fetch('/api/enose/devices/measurements/active', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const activeData = await activeCheck.json();
                
                if (activeData.result && activeData.result.active && activeData.result.measurement) {
                    const measurement = activeData.result.measurement;
                    // Chỉ block nếu measurement thực sự đang chạy (không phải completed/failed)
                    if (measurement.status === 'started' || measurement.status === 'in_progress') {
                        statusContent.textContent = `Đang có measurement đang chạy: ${measurement.file_name}. Vui lòng đợi hoàn thành.`;
                        statusContent.style.color = '#dc2626';
                        // Disable button và update UI
            btn.disabled = true;
                        btn.style.opacity = '0.6';
                        btn.style.cursor = 'not-allowed';
                        return; // Không cho phép start mới
                    }
                }
            } catch (activeCheckError) {
                console.warn('⚠️ Could not check active measurement before start:', activeCheckError);
                // Tiếp tục nếu không check được
            }
            
            // QUAN TRỌNG: Kiểm tra xem ESP32 có online không (có sensor data mới trong 2 phút)
            // Chỉ cho phép start khi ESP32 đang bật và có dữ liệu gửi lên
            try {
                const selectedDeviceId = document.getElementById('deviceSelect')?.value;
                if (selectedDeviceId) {
                    const sensorCheck = await fetch(`/api/enose/devices/${selectedDeviceId}/airsense/latest`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const sensorData = await sensorCheck.json();
                    
                    if (sensorData.result && sensorData.result.success && sensorData.result.data) {
                        const data = sensorData.result.data;
                        const currentTime = Math.floor(Date.now() / 1000);
                        const dataTimestamp = data.timestamp || 0;
                        
                        // QUAN TRỌNG: Validate timestamp - nếu là tương lai hoặc quá cũ, coi như offline
                        const timestampDiff = Math.abs(currentTime - dataTimestamp);
                        let ageSeconds = currentTime - dataTimestamp;
                        
                        // Nếu timestamp không hợp lệ (tương lai hoặc quá cũ > 1 giờ), coi như offline
                        if (timestampDiff > 3600) {
                            ageSeconds = 999999; // Force offline
                        }
                        
                        const maxAgeSeconds = 2 * 60; // 2 phút
                        
                        if (ageSeconds > maxAgeSeconds || ageSeconds < 0) {
                            // ESP32 không có sensor data mới trong 2 phút → chưa được khởi động hoặc đã tắt
                            statusContent.textContent = `⚠️ ESP32 chưa được khởi động. Không có dữ liệu sensor trong ${Math.round(ageSeconds/60)} phút gần đây. Vui lòng kiểm tra và khởi động thiết bị.`;
                            statusContent.style.color = '#dc2626';
                            btn.disabled = true;
                            btn.style.opacity = '0.6';
                            btn.style.cursor = 'not-allowed';
                            btn.innerHTML = '<i class="bi bi-play-circle"></i> Start measurement';
                            return; // Không cho phép start
                        }
                    } else {
                        // Không có sensor data → ESP32 chưa được khởi động
                        statusContent.textContent = '⚠️ ESP32 chưa được khởi động. Thiết bị chưa gửi dữ liệu sensor. Vui lòng kiểm tra thiết bị có đang hoạt động và kết nối MQTT không.';
                        statusContent.style.color = '#dc2626';
                        btn.disabled = true;
                        btn.style.opacity = '0.6';
                        btn.style.cursor = 'not-allowed';
                        btn.innerHTML = '<i class="bi bi-play-circle"></i> Start measurement';
                        return; // Không cho phép start
                    }
                }
            } catch (deviceCheckError) {
                console.warn('⚠️ Could not check device online status before start:', deviceCheckError);
                // Nếu không check được, vẫn cho phép start (fallback)
            }
            
            // Disable button ngay để tránh double-click
            btn.disabled = true;
            btn.style.opacity = '0.6';
            btn.style.cursor = 'not-allowed';
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Starting...';
            statusContent.textContent = 'Starting measurement...';
            
            try {
                const response = await fetch('/api/enose/control/measurement/start', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });
                
                const data = await response.json();
                
                if (data.result && data.result.success) {
                    statusContent.textContent = `Measurement started: ${data.result.file_name}`;
                    statusContent.style.color = '#16a34a';
                    const fileName = data.result.file_name;
                    document.getElementById('lastFileName').textContent = fileName;
                    document.getElementById('lastMeasurementTime').textContent = 'Last updated: ' + new Date(data.result.started_at).toLocaleString();
                    
                    // Hiển thị nút download và lưu file name + start time
                    const downloadBtn = document.getElementById('downloadFileBtn');
                    downloadBtn.style.display = 'block';
                    downloadBtn.dataset.fileName = fileName;
                    downloadBtn.dataset.startedAt = data.result.started_at; // Lưu start time để fallback
                    
                    // Disable nút start và hiển thị thông báo đang đo
                    btn.disabled = true;
                    btn.style.opacity = '0.6';
                    btn.style.cursor = 'not-allowed';
                    const activeAlert = document.getElementById('activeMeasurementAlert');
                    const activeFileName = document.getElementById('activeMeasurementFileName');
                    activeAlert.style.display = 'block';
                    activeFileName.textContent = fileName;
                    
                    // Check lại active measurement sau 1 giây để đảm bảo sync
                    setTimeout(checkActiveMeasurement, 1000);
                } else {
                    // Có lỗi từ backend
                    const errorMessage = data.error?.message || data.result?.message || 'Failed to start measurement';
                    
                    // Kiểm tra xem có phải lỗi device offline không
                    if (data.result && data.result.device_offline) {
                        // ESP32 chưa được khởi động hoặc đã tắt
                        if (data.result.no_sensor_data) {
                            statusContent.textContent = '⚠️ ESP32 chưa được khởi động. Thiết bị chưa gửi dữ liệu sensor. Vui lòng kiểm tra thiết bị có đang hoạt động và kết nối MQTT không.';
                        } else {
                            const ageMinutes = data.result.last_sensor_data_age_seconds ? Math.round(data.result.last_sensor_data_age_seconds / 60) : 0;
                            statusContent.textContent = `⚠️ ESP32 chưa được khởi động hoặc đã tắt. Không có dữ liệu sensor trong ${ageMinutes} phút gần đây. Vui lòng kiểm tra và khởi động thiết bị trước khi bắt đầu đo.`;
                        }
                        statusContent.style.color = '#dc2626';
                        // Giữ button disabled
                        btn.disabled = true;
                        btn.style.opacity = '0.6';
                        btn.style.cursor = 'not-allowed';
                    } else if (data.result && data.result.active_measurement) {
                        // Nếu có active measurement, hiển thị thông tin chi tiết
                        const active = data.result.active_measurement;
                        statusContent.textContent = `Đang có measurement đang chạy: ${active.file_name} (${active.elapsed_minutes} phút). Vui lòng đợi hoàn thành.`;
                        statusContent.style.color = '#dc3545';
                        // Giữ button disabled
                        btn.disabled = true;
                        btn.style.opacity = '0.6';
                        btn.style.cursor = 'not-allowed';
                    } else {
                        // Lỗi khác
                        statusContent.textContent = errorMessage;
                        statusContent.style.color = '#dc3545';
                        // Enable lại button nếu không có measurement đang chạy
                        btn.disabled = false;
                        btn.style.opacity = '1';
                        btn.style.cursor = 'pointer';
                    }
                    btn.innerHTML = '<i class="bi bi-play-circle"></i> Start measurement';
                }
            } catch (error) {
                statusContent.textContent = 'Error: ' + error.message;
                statusContent.style.color = '#dc3545';
                // Enable lại button nếu có lỗi
                btn.disabled = false;
                btn.style.opacity = '1';
                btn.style.cursor = 'pointer';
                btn.innerHTML = '<i class="bi bi-play-circle"></i> Start measurement';
            } finally {
                // Luôn check lại active measurement để sync UI
                setTimeout(async () => {
                    await checkActiveMeasurement();
                }, 500);
            }
            });
        }
        
        // Khởi tạo button khi DOM ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initStartMeasurementButton();
            });
        } else {
            // DOM đã ready, gọi ngay
            initStartMeasurementButton();
        }
        
        // Download file button
        document.getElementById('downloadFileBtn').addEventListener('click', async () => {
            const btn = document.getElementById('downloadFileBtn');
            const fileName = btn.dataset.fileName;
            
            if (!fileName || fileName === '--') {
                alert('No file available to download');
                return;
            }
            
            try {
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Loading...';
                
                // Ưu tiên: Tải file trực tiếp từ ESP32 file server qua API proxy
                // Đảm bảo file name có extension .csv
                const fileNameWithExt = fileName.endsWith('.csv') ? fileName : `${fileName}.csv`;
                
                try {
                    const fileUrl = `/api/enose/devices/files/download?file_name=${encodeURIComponent(fileNameWithExt)}`;
                    console.log(`🔄 Downloading file from ESP32 via proxy: ${fileUrl}`);
                    
                    // Fetch file từ API proxy
                    const fileResponse = await fetch(fileUrl, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    
                    if (fileResponse.ok) {
                        // Kiểm tra content type để đảm bảo là file CSV
                        const contentType = fileResponse.headers.get('content-type');
                        console.log(`✅ File downloaded successfully, content-type: ${contentType}`);
                        
                        // Tạo blob từ response
                        const blob = await fileResponse.blob();
                        
                        // Tạo link download
                        const link = document.createElement('a');
                        const url = URL.createObjectURL(blob);
                        link.href = url;
                        link.download = fileNameWithExt;
                        link.style.visibility = 'hidden';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        URL.revokeObjectURL(url);
                        
                        btn.innerHTML = '<i class="bi bi-download"></i> Download CSV';
                        btn.disabled = false;
                        console.log(`✅ File downloaded to local machine: ${fileNameWithExt}`);
                        return; // Thành công, không cần fallback
                    } else {
                        // Thử parse error message
                        let errorMessage = 'Unknown error';
                        try {
                            const errorData = await fileResponse.json();
                            errorMessage = errorData.message || errorData.error || 'Unknown error';
                        } catch (e) {
                            errorMessage = `HTTP ${fileResponse.status}: ${fileResponse.statusText}`;
                        }
                        console.warn(`⚠️ Failed to download from ESP32 (HTTP ${fileResponse.status}):`, errorMessage);
                        // Tiếp tục với fallback (tạo từ MongoDB)
                    }
                } catch (proxyError) {
                    console.error('❌ Proxy download error:', proxyError);
                    console.warn('⚠️ Falling back to MongoDB data generation');
                    // Tiếp tục với fallback (tạo từ MongoDB)
                }
                
                // Fallback: Tạo file từ MongoDB (sensor data) - cần lấy tất cả data của file này
                // Tạm thời dùng API getSensorDataByTimeRange với thời gian từ khi file được tạo
                // Hoặc có thể lấy từ measurement file detail để biết thời gian bắt đầu
                const measurementDetailRes = await fetch(`/api/devices/measurements/files/${encodeURIComponent(fileName)}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!measurementDetailRes.ok) {
                    throw new Error('Failed to fetch measurement details');
                }
                
                const measurementDetail = await measurementDetailRes.json();
                let startTime = measurementDetail.result?.started_at || measurementDetail.result?.created_at;
                
                // Fallback: nếu không có trong MongoDB, thử lấy từ dataset (đã lưu khi start)
                if (!startTime && btn.dataset.startedAt) {
                    startTime = btn.dataset.startedAt;
                    console.log('⚠️ Using fallback start time from dataset');
                }
                
                if (!startTime) {
                    throw new Error('Could not determine measurement start time. Please wait for measurement to complete or refresh the page.');
                }
                
                // Lấy sensor data từ thời điểm bắt đầu đến hiện tại (nếu đang đo) hoặc +40 phút (nếu đã xong)
                const startDate = new Date(startTime);
                const isActive = measurementDetail.result?.status === 'started' || measurementDetail.result?.status === 'in_progress';
                const endDate = isActive 
                    ? new Date() // Nếu đang đo, lấy đến hiện tại
                    : (measurementDetail.result?.completed_at 
                        ? new Date(measurementDetail.result.completed_at) 
                        : new Date(startDate.getTime() + 40 * 60 * 1000)); // Fallback: +40 phút
                
                const sensorDataRes = await fetch(`/api/devices/data/time-range?start_time=${startDate.toISOString()}&end_time=${endDate.toISOString()}&limit=10000`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!sensorDataRes.ok) {
                    throw new Error('Failed to fetch sensor data');
                }
                
                const sensorData = await sensorDataRes.json();
                
                if (sensorData.result && sensorData.result.length > 0) {
                    // Nhóm dữ liệu theo timestamp để tạo CSV rows
                    const dataByTimestamp = {};
                    
                    sensorData.result.forEach(item => {
                        const timestamp = item.created_at || item.timestamp;
                        if (!dataByTimestamp[timestamp]) {
                            dataByTimestamp[timestamp] = {
                                timestamp: timestamp,
                                temperature: '',
                                humidity: '',
                                adc: ['', '', '', '', '', '', '', '']
                            };
                        }
                        
                        if (item.data_type === 'temperature') {
                            dataByTimestamp[timestamp].temperature = item.value || '';
                        } else if (item.data_type === 'humidity') {
                            dataByTimestamp[timestamp].humidity = item.value || '';
                        } else if (item.data_type && item.data_type.startsWith('mems')) {
                            const memsIndex = parseInt(item.data_type.replace('mems', '')) - 1;
                            if (memsIndex >= 0 && memsIndex < 8) {
                                // Ưu tiên adc_value, nếu không có thì dùng value
                                dataByTimestamp[timestamp].adc[memsIndex] = item.adc_value !== undefined ? item.adc_value : (item.value || '');
                            }
                        }
                    });
                    
                    // Nếu đang đo và chưa có nhiều data, thêm thông báo
                    if (isActive && Object.keys(dataByTimestamp).length < 10) {
                        console.log('⚠️ Measurement is still in progress, downloading partial data');
                    }
                    
                    // Tạo CSV content
                    let csvContent = 'TimeStamp,Temperature,Humidity,EtOH3,EtOH4,EtOH5,EtOH6,EtOH1,EtOH2,VOC1,VOC2\n';
                    
                    // Sort theo timestamp
                    const sortedTimestamps = Object.keys(dataByTimestamp).sort();
                    sortedTimestamps.forEach(ts => {
                        const row = dataByTimestamp[ts];
                        csvContent += `${row.timestamp},${row.temperature},${row.humidity},${row.adc.join(',')}\n`;
                    });
                    
                    // Download file
                    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                    const link = document.createElement('a');
                    const url = URL.createObjectURL(blob);
                    link.setAttribute('href', url);
                    link.setAttribute('download', fileName);
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    
                    btn.innerHTML = '<i class="bi bi-download"></i> Download CSV';
                } else {
                    // Không dùng alert để tránh chặn tương tác, chỉ log và hiển thị thông báo nhẹ nhàng
                    console.warn('⚠️ No sensor data found for this measurement file:', fileName);
                    // Hiển thị thông báo nhẹ nhàng bằng cách cập nhật status (nếu có)
                    const statusContent = document.getElementById('statusContent');
                    if (statusContent && !statusContent.textContent.includes('Đang đo')) {
                        const originalText = statusContent.textContent;
                        statusContent.textContent = '⚠️ Không có dữ liệu sensor cho file này';
                        statusContent.style.color = '#f59e0b'; // Orange color
                        // Tự động quay về trạng thái ban đầu sau 3 giây
                        setTimeout(() => {
                            statusContent.textContent = originalText;
                            statusContent.style.color = '#16a34a'; // Green color
                        }, 3000);
                    }
                    btn.innerHTML = '<i class="bi bi-download"></i> Download CSV';
                }
            } catch (error) {
                console.error('Error downloading file:', error);
                // Không dùng alert để tránh chặn tương tác, chỉ log và hiển thị thông báo nhẹ nhàng
                const statusContent = document.getElementById('statusContent');
                if (statusContent && !statusContent.textContent.includes('Đang đo')) {
                    const originalText = statusContent.textContent;
                    statusContent.textContent = '⚠️ Lỗi khi tải file: ' + error.message;
                    statusContent.style.color = '#dc2626'; // Red color
                    // Tự động quay về trạng thái ban đầu sau 3 giây
                    setTimeout(() => {
                        statusContent.textContent = originalText;
                        statusContent.style.color = '#16a34a'; // Green color
                    }, 3000);
                }
                btn.innerHTML = '<i class="bi bi-download"></i> Download CSV';
            } finally {
                btn.disabled = false;
            }
        });

        // Format bytes
        function formatBytes(bytes) {
            if (!bytes || bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Mở modal WiFi config
        function openWifiConfigModal() {
            const modal = document.getElementById('wifiConfigModal');
            if (modal) {
                modal.classList.add('show');
                // Reload iframe để đảm bảo kết nối WebSocket mới
                const iframe = document.getElementById('wifiConfigIframe');
                if (iframe) {
                    iframe.src = 'http://192.168.4.1/wifi-config';
                }
            }
        }

        // Đóng modal WiFi config
        function closeWifiConfigModal() {
            const modal = document.getElementById('wifiConfigModal');
            if (modal) {
                modal.classList.remove('show');
            }
        }

        // Đóng modal khi click bên ngoài
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('wifiConfigModal');
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        closeWifiConfigModal();
                    }
                });
            }
        });

        // Initial load - Đảm bảo DOM đã ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                loadDevices();
                loadDashboardData();
                // Check device online ngay khi load trang
                setTimeout(checkDeviceOnlineAndUpdateUI, 1000);
            });
        } else {
            loadDevices();
            loadDashboardData();
            // Check device online ngay khi load trang
            setTimeout(checkDeviceOnlineAndUpdateUI, 1000);
        }
        
        // Auto-refresh mỗi 5 giây để cập nhật dữ liệu real-time từ MongoDB
        // (Status, storage, etc. - không cần realtime như sensor data)
        setInterval(loadDashboardData, 5000);
        
        // Hàm kiểm tra ESP32 online và cập nhật UI (ẩn dữ liệu nếu offline)
        async function checkDeviceOnlineAndUpdateUI() {
            try {
                const selectedDeviceId = document.getElementById('deviceSelect')?.value;
                if (!selectedDeviceId) {
                    // Nếu không có device được chọn, thử lấy device đầu tiên
                    return;
                }
                
                const statusContent = document.getElementById('statusContent');
                const startBtn = document.getElementById('startMeasurementBtn');
                const tempEl = document.getElementById('temperature');
                const humEl = document.getElementById('humidity');
                const wifiSignalEl = document.getElementById('wifiSignal');
                
                if (!statusContent || !startBtn || !tempEl || !humEl || !wifiSignalEl) {
                    return; // DOM chưa ready
                }
                
                // Check device online bằng cách lấy latest sensor data
                const sensorCheck = await fetch(`/api/enose/devices/${selectedDeviceId}/airsense/latest`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const sensorData = await sensorCheck.json();
                
                const currentTime = Math.floor(Date.now() / 1000);
                let isOnline = false;
                let ageSeconds = 0;
                
                if (sensorData.result && sensorData.result.success && sensorData.result.data) {
                    const data = sensorData.result.data;
                    const dataTimestamp = data.timestamp || 0;
                    
                    // Validate timestamp - nếu là tương lai hoặc quá cũ, coi như offline
                    const timestampDiff = Math.abs(currentTime - dataTimestamp);
                    ageSeconds = currentTime - dataTimestamp;
                    
                    // Nếu timestamp không hợp lệ (tương lai hoặc quá cũ > 1 giờ), coi như offline
                    if (timestampDiff > 3600) {
                        ageSeconds = 999999; // Force offline
                    }
                    
                    const maxAgeSeconds = 2 * 60; // 2 phút
                    isOnline = (ageSeconds <= maxAgeSeconds && ageSeconds >= 0);
                }
                
                // Cập nhật UI dựa trên trạng thái online/offline
                if (!isOnline) {
                    // ESP32 offline → ẩn dữ liệu và hiển thị thông báo
                    tempEl.textContent = '--';
                    humEl.textContent = '--';
                    wifiSignalEl.textContent = '--';
                    
                    // Chỉ cập nhật status nếu không có measurement đang chạy
                    if (!statusContent.textContent.includes('Đang đo') && !statusContent.textContent.includes('Đã hoàn thành')) {
                        if (ageSeconds > 0 && ageSeconds < 999999) {
                            statusContent.textContent = `⚠️ ESP32 chưa được khởi động. Không có dữ liệu sensor trong ${Math.round(ageSeconds/60)} phút gần đây.`;
                        } else {
                            statusContent.textContent = '⚠️ ESP32 chưa được khởi động. Thiết bị chưa gửi dữ liệu sensor.';
                        }
                        statusContent.style.color = '#dc2626';
                    }
                    
                    // Disable button nếu không có measurement đang chạy
                    // (checkActiveMeasurement sẽ handle việc enable/disable khi có measurement)
                    const activeRes = await fetch('/api/enose/devices/measurements/active', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const activeData = await activeRes.json();
                    
                    if (!activeData.result || !activeData.result.active) {
                        startBtn.disabled = true;
                        startBtn.style.opacity = '0.6';
                        startBtn.style.cursor = 'not-allowed';
                    }
                }
                // Nếu ESP32 online, dữ liệu sẽ được cập nhật bởi loadDashboardData() hoặc startAirSENSERefresh()
                // Button sẽ được enable bởi checkActiveMeasurement() nếu không có measurement đang chạy
            } catch (error) {
                console.warn('⚠️ Could not check device online status:', error);
                // Nếu không check được, không thay đổi UI (fallback)
            }
        }
        
        // Check active measurement và device online thường xuyên hơn (mỗi 2 giây) để cập nhật UI nhanh
        setInterval(checkActiveMeasurement, 2000);
        setInterval(checkDeviceOnlineAndUpdateUI, 2000); // Check device online và cập nhật UI
        
        // Refresh sensor data realtime sẽ được xử lý bởi startAirSENSERefresh() sau khi loadDeviceListFromAirSENSE() hoàn thành

        // ========== FUNCTIONS ĐỌC TỪ COLLECTION 'sensor' CHUNG CỦA AIRSENSE ==========
        
        let currentDeviceId = null;
        let airsenseDataInterval = null;

        // Lấy danh sách devices từ collection 'sensor' (AirSENSE common collection)
        async function loadDeviceListFromAirSENSE() {
            try {
                const response = await fetch('/api/enose/devices/airsense/devices', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const result = await response.json();
                
                if (result.result && result.result.success && result.result.devices && result.result.devices.length > 0) {
                    // Chọn device đầu tiên hoặc device được chọn
                    currentDeviceId = result.result.devices[0].device_id;
                    
                    console.log('📱 Devices from AirSENSE collection:', result.result.devices);
                    console.log('📱 Selected device:', currentDeviceId);
                    
                    // Cập nhật UI với danh sách devices (nếu có dropdown)
                    const deviceSelect = document.getElementById('device-select');
                    if (deviceSelect) {
                        result.result.devices.forEach(device => {
                            const option = document.createElement('option');
                            option.value = device.device_id;
                            option.textContent = `${device.device_id} (Last: ${device.last_seen ? new Date(device.last_seen).toLocaleString('vi-VN') : 'N/A'})`;
                            deviceSelect.appendChild(option);
                        });
                        deviceSelect.value = currentDeviceId;
                        
                        // Thêm event listener để đổi device
                        deviceSelect.addEventListener('change', (e) => {
                            currentDeviceId = e.target.value;
                            loadLatestSensorDataFromAirSENSE();
                            loadMeasurementHistoryFromAirSENSE();
                        });
                    }
                    
                    // Bắt đầu load dữ liệu
                    loadLatestSensorDataFromAirSENSE();
                    loadMeasurementHistoryFromAirSENSE();
                } else {
                    console.warn('⚠️ Chưa có thiết bị nào có dữ liệu trong AirSENSE collection');
                }
            } catch (error) {
                console.error('❌ Error loading device list from AirSENSE:', error);
            }
        }

        // Lấy dữ liệu sensor mới nhất từ collection 'sensor' (AirSENSE common collection)
        async function loadLatestSensorDataFromAirSENSE() {
            if (!currentDeviceId) {
                console.warn('⚠️ Chưa chọn device - currentDeviceId:', currentDeviceId);
                // Thử load device list lại
                await loadDeviceListFromAirSENSE();
                if (!currentDeviceId) {
                    console.warn('⚠️ Vẫn chưa có device sau khi load lại');
                    return;
                }
            }
            
            console.log('📡 Loading sensor data for device:', currentDeviceId);
            
            try {
                const response = await fetch(`/api/enose/devices/${currentDeviceId}/airsense/latest`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!response.ok) {
                    console.error('❌ API Error:', response.status, response.statusText);
                    return;
                }
                
                const result = await response.json();
                
                // Debug: log response để kiểm tra format
                console.log('📡 API Response:', JSON.stringify(result, null, 2));
                
                // Kiểm tra cả 2 format: result.result.data và result.data
                let data = null;
                if (result.result && result.result.success && result.result.data) {
                    data = result.result.data;
                } else if (result.success && result.data) {
                    data = result.data;
                } else if (result.result && result.result.data) {
                    // Format: { result: { data: {...} } }
                    data = result.result.data;
                } else if (result.data) {
                    // Format: { data: {...} }
                    data = result.data;
                }
                
                if (data) {
                    // QUAN TRỌNG: Kiểm tra timestamp - chỉ cập nhật nếu dữ liệu gần đây (trong 30 giây)
                    // Tránh cập nhật với dữ liệu cũ khi ESP32 đã tắt
                    const dataTimestamp = data.timestamp ? (typeof data.timestamp === 'number' ? data.timestamp : new Date(data.timestamp).getTime() / 1000) : null;
                    const currentTime = Math.floor(Date.now() / 1000);
                    const maxAge = 30; // 30 giây
                    
                    if (dataTimestamp && (currentTime - dataTimestamp) > maxAge) {
                        // Dữ liệu quá cũ (> 30 giây) → không cập nhật, có thể ESP32 đã tắt
                        logThrottle('old_sensor_data', () => 
                            `⚠️ Sensor data quá cũ (${Math.round(currentTime - dataTimestamp)}s) - ESP32 có thể đã tắt, không cập nhật UI`
                        );
                        return; // Không cập nhật UI với dữ liệu cũ
                    }
                    
                    console.log('📊 Parsed data:', {
                        temperature: data.temperature,
                        humidity: data.humidity,
                        adc: data.adc,
                        adc_count: data.adc ? data.adc.length : 0,
                        age: dataTimestamp ? Math.round(currentTime - dataTimestamp) : 'unknown'
                    });
                    
                    // Cập nhật Temperature
                    const tempEl = document.getElementById('temperature');
                    if (tempEl) {
                        if (data.temperature !== null && data.temperature !== undefined && !isNaN(data.temperature)) {
                            tempEl.textContent = parseFloat(data.temperature).toFixed(1);
                            console.log('✅ Updated temperature:', parseFloat(data.temperature).toFixed(1));
                        } else {
                            tempEl.textContent = '--';
                            console.warn('⚠️ Temperature is null/undefined/NaN:', data.temperature);
                        }
                    } else {
                        console.error('❌ Temperature element not found');
                    }
                    
                    // Cập nhật Humidity
                    const humEl = document.getElementById('humidity');
                    if (humEl) {
                        if (data.humidity !== null && data.humidity !== undefined && !isNaN(data.humidity)) {
                            humEl.textContent = parseFloat(data.humidity).toFixed(0);
                            console.log('✅ Updated humidity:', parseFloat(data.humidity).toFixed(0));
                        } else {
                            humEl.textContent = '--';
                            console.warn('⚠️ Humidity is null/undefined/NaN:', data.humidity);
                        }
                    } else {
                        console.error('❌ Humidity element not found');
                    }
                    
                    // Cập nhật MEMS sensors CHỈ KHI ĐANG ĐO (không cập nhật khi đã hoàn thành)
                    // Kiểm tra xem có measurement đang chạy không
                    try {
                        const activeMeasurementRes = await fetch('/api/enose/devices/measurements/active', {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const activeMeasurement = await activeMeasurementRes.json();
                        
                        const isMeasuring = activeMeasurement.result && activeMeasurement.result.active === true;
                        
                        // Debug log
                        console.log('🔍 Measurement status check:', {
                            isMeasuring: isMeasuring,
                            activeMeasurementResult: activeMeasurement.result,
                            hasAdc: !!(data.adc && Array.isArray(data.adc)),
                            adcLength: data.adc ? data.adc.length : 0,
                            adcValues: data.adc ? data.adc.slice(0, 3) : null // Log 3 giá trị đầu
                        });
                        
                        if (isMeasuring) {
                            // Đang đo: hiển thị MEMS sensors
                            // QUAN TRỌNG: Chỉ cập nhật nếu có ít nhất 1 ADC value khác null
                            // Nếu tất cả đều null, giữ lại giá trị cũ (không reset về "--")
                            let hasValidADC = false;
                            let adcArray = null;
                            
                            if (data.adc && Array.isArray(data.adc)) {
                                // Kiểm tra xem có ít nhất 1 giá trị khác null không
                                hasValidADC = data.adc.some(value => value !== null && value !== undefined);
                                adcArray = data.adc;
                                console.log('📊 Found ADC array:', {
                                    length: adcArray.length,
                                    hasValid: hasValidADC,
                                    values: adcArray
                                });
                            } else if (data.adc_values && Array.isArray(data.adc_values)) {
                                hasValidADC = data.adc_values.some(value => value !== null && value !== undefined);
                                adcArray = data.adc_values;
                                console.log('📊 Found ADC values array:', {
                                    length: adcArray.length,
                                    hasValid: hasValidADC,
                                    values: adcArray
                                });
                            } else {
                                console.warn('⚠️ No ADC array found in data:', {
                                    hasAdc: !!data.adc,
                                    hasAdcValues: !!data.adc_values,
                                    dataKeys: Object.keys(data)
                                });
                            }
                            
                            if (hasValidADC && adcArray) {
                                // Có ít nhất 1 ADC value hợp lệ → cập nhật
                                const sensorDataForMEMS = adcArray.map((value, index) => ({
                                    data_type: `mems${index + 1}`,
                                    value: value,
                                    adc_value: value
                                }));
                                displayMEMSSensors(sensorDataForMEMS);
                                console.log('✅ Updated MEMS sensors with valid ADC values:', sensorDataForMEMS);
                            } else {
                                // Tất cả ADC values đều null → giữ lại giá trị cũ (không reset)
                                // Chỉ log để debug, không cập nhật UI
                                logThrottle(`no_adc_keep_old_${currentDeviceId}`, () => 
                                    `⚠️ All ADC values are null, keeping previous values displayed. isMeasuring=${isMeasuring}, hasAdc=${!!data.adc}, adcArray=${adcArray}`
                                );
                            }
                        } else {
                            // Không đang đo: reset MEMS về "--"
                            console.log('🔄 Not measuring, resetting MEMS sensors');
                            resetMEMSSensors();
                }
            } catch (error) {
                        console.warn('⚠️ Error checking active measurement for MEMS display:', error);
                        // Nếu có lỗi, vẫn reset MEMS về "--" để an toàn
                        resetMEMSSensors();
                    }
                    
                    // Cập nhật timestamp
                    const timeEl = document.getElementById('last-update-time');
                    if (timeEl && data.timestamp_iso) {
                        timeEl.textContent = 'Last update: ' + new Date(data.timestamp_iso).toLocaleString('vi-VN');
                    }
                    
                    console.log('✅ Sensor data updated from AirSENSE:', data);
                } else {
                    console.warn('⚠️ Không có dữ liệu mới từ AirSENSE:', result.result?.message);
                }
            } catch (error) {
                console.error('❌ Error loading latest sensor data from AirSENSE:', error);
            }
        }

        // Lấy lịch sử đo từ collection 'sensor' (AirSENSE common collection)
        async function loadMeasurementHistoryFromAirSENSE() {
            if (!currentDeviceId) {
                return;
            }
            
            try {
                const limit = 100; // Số điểm dữ liệu muốn lấy
                const response = await fetch(`/api/devices/${currentDeviceId}/airsense/history?limit=${limit}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const result = await response.json();
                
                if (result.result && result.result.success && result.result.data && result.result.data.length > 0) {
                    // Cập nhật chart với dữ liệu mới - Commented out
                    // updateChartsFromAirSENSE(result.result.data);
                }
            } catch (error) {
                console.error('❌ Error loading measurement history from AirSENSE:', error);
            }
        }

