        async function loadLastMeasurementInfo() {
            try {
                console.log('📁 Loading last measurement info...');
                
                // Ưu tiên lấy từ MongoDB
                const response = await fetch('/api/enose/devices/measurements/files?limit=1', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!response.ok) {
                    console.error('❌ API Error:', response.status, response.statusText);
                    return;
                }
                
                const data = await response.json();
                console.log('📁 API Response:', data);
                
                if (data.result && Array.isArray(data.result) && data.result.length > 0) {
                    const lastMeasurement = data.result[0];
                    const fileName = lastMeasurement.file_name || '--';
                    
                    console.log('✅ Found last measurement:', {
                        file_name: fileName,
                        started_at: lastMeasurement.started_at,
                        status: lastMeasurement.status
                    });
                    
                    document.getElementById('lastFileName').textContent = fileName;
                    document.getElementById('lastMeasurementTime').textContent = 'Last updated: ' + (lastMeasurement.started_at ? new Date(lastMeasurement.started_at).toLocaleString('vi-VN') : '--');
                    
                    // Hiển thị nút download nếu có file
                    const downloadBtn = document.getElementById('downloadFileBtn');
                    if (fileName !== '--') {
                        downloadBtn.style.display = 'block';
                        downloadBtn.dataset.fileName = fileName;
                        // Lưu start time nếu có
                        if (lastMeasurement.started_at) {
                            downloadBtn.dataset.startedAt = lastMeasurement.started_at;
                        }
                } else {
                        downloadBtn.style.display = 'none';
                    }
                } else {
                    console.warn('⚠️ No measurement files found, trying fallback...');
                    
                    // Fallback: Lấy từ control history
                    try {
                    const fallbackResponse = await fetch('/api/enose/control/measurement/last', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const fallbackData = await fallbackResponse.json();
                        console.log('📁 Fallback response:', fallbackData);
                        
                        if (fallbackData.result && fallbackData.result.file_name) {
                            document.getElementById('lastFileName').textContent = fallbackData.result.file_name;
                            document.getElementById('lastMeasurementTime').textContent = 'Last updated: ' + (fallbackData.result.started_at ? new Date(fallbackData.result.started_at).toLocaleString('vi-VN') : '--');
                        } else {
                            console.warn('⚠️ No fallback data available');
                            document.getElementById('lastFileName').textContent = '--';
                            document.getElementById('lastMeasurementTime').textContent = 'Last updated: --';
                        }
                    } catch (fallbackError) {
                        console.error('❌ Fallback error:', fallbackError);
                        document.getElementById('lastFileName').textContent = '--';
                        document.getElementById('lastMeasurementTime').textContent = 'Last updated: --';
                    }
                }
            } catch (error) {
                console.error('❌ Error loading last measurement:', error);
                document.getElementById('lastFileName').textContent = '--';
                document.getElementById('lastMeasurementTime').textContent = 'Last updated: --';
            }
        }
        
