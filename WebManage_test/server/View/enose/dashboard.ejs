    <script>
        // Helper function để throttle log (chỉ log mỗi interval giây)
        const logThrottle = (() => {
            const lastLogTimes = new Map();
            const LOG_INTERVAL_MS = 10000; // 10 giây
            
            return (key, message, force = false) => {
                const now = Date.now();
                const lastTime = lastLogTimes.get(key) || 0;
                const elapsed = now - lastTime;
                
                if (force || elapsed >= LOG_INTERVAL_MS) {
                    lastLogTimes.set(key, now);
                    if (typeof message === 'function') {
                        console.log(message());
                    } else {
                        console.log(message);
                    }
                    return true;
                }
                return false;
            };
        })();
        
        // ========== TEST MODE: Comment lại phần check token để test không cần đăng nhập ==========
        // Khi deploy lên server, uncomment lại phần này
        // const token = localStorage.getItem('token_AIRSENSE') || localStorage.getItem('token');
        // if (!token) {
        //     window.location.href = '/login/user';
        // }
        
        // Test mode: Dùng dummy token
        const token = 'test_token';

        // Chart variables - Commented out
        // let measurementChart = null;
        // let memsSensorsChart = null;
        let allDevices = [];
        let selectedDeviceId = '';
        let fromTime = null;
        let toTime = null;

        // Load devices list
        async function loadDevices() {
            try {
                const response = await fetch('/api/enose/devices', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await response.json();
                
                if (data.result) {
                    allDevices = data.result;
                    const select = document.getElementById('deviceSelect');
                    select.innerHTML = '<option value="">Tất cả thiết bị</option>';
                    
                    data.result.forEach(device => {
                        const option = document.createElement('option');
                        option.value = device.device_id;
                        option.textContent = device.name || device.device_id;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Error loading devices:', error);
            }
        }

        // Apply filter
        function applyFilter() {
            selectedDeviceId = document.getElementById('deviceSelect').value;
            const fromTimeInput = document.getElementById('fromTime').value;
            const toTimeInput = document.getElementById('toTime').value;
            
            fromTime = fromTimeInput ? new Date(fromTimeInput) : null;
            toTime = toTimeInput ? new Date(toTimeInput) : null;
            
            loadMeasurementHistory();
            loadMEMSSensorsData();
        }

        // Check active measurement và update UI
        async function checkActiveMeasurement() {
            try {
                const activeRes = await fetch('/api/enose/devices/measurements/active', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!activeRes.ok) {
                    console.error('Error fetching active measurement:', activeRes.status, activeRes.statusText);
                    return;
                }
                
                const activeData = await activeRes.json();
                
                const startBtn = document.getElementById('startMeasurementBtn');
                const statusContent = document.getElementById('statusContent');
                const activeAlert = document.getElementById('activeMeasurementAlert');
                const activeFileName = document.getElementById('activeMeasurementFileName');
                
                // Kiểm tra xem có button không (tránh lỗi nếu chưa load)
                if (!startBtn) {
                    console.warn('⚠️ startMeasurementBtn not found');
                    return;
                }
                
                // QUAN TRỌNG: Kiểm tra activeData.result.active trước
                // Nếu active = true → chắc chắn có measurement đang chạy → disable button
                if (activeData.result && activeData.result.active === true && activeData.result.measurement) {
                    // Có measurement đang chạy
                    const measurement = activeData.result.measurement;
                    
                    // Kiểm tra nếu measurement đã completed hoặc failed
                    if (measurement.status === 'completed' || measurement.status === 'failed') {
                        // Measurement đã hoàn thành hoặc failed - enable button ngay
                        startBtn.disabled = false;
                        startBtn.style.opacity = '1';
                        startBtn.style.cursor = 'pointer';
                        
                        // Ẩn alert "Đang đo"
                        activeAlert.style.display = 'none';
                        
                        // Hiển thị thông báo
                        if (measurement.status === 'completed') {
                            let completionMessage = '✅ Đã hoàn thành';
                            if (measurement.duration_ms) {
                                const durationMinutes = Math.round(measurement.duration_ms / 60000);
                                completionMessage += ` (${durationMinutes} phút)`;
                            }
                            statusContent.textContent = completionMessage;
                            statusContent.style.color = '#16a34a'; // Green color
                        } else if (measurement.status === 'failed') {
                            statusContent.textContent = '⚠️ Đo bị gián đoạn - Có thể bắt đầu đo mới';
                            statusContent.style.color = '#dc2626'; // Red color
                        }
                        
                        // Reset MEMS sensors về "--" khi measurement completed/failed
                        resetMEMSSensors();
                        
                        // Reload last measurement info để hiển thị file mới nhất
                        loadLastMeasurementInfo();
                    } else {
                        // Kiểm tra thời gian: nếu đã quá 40 phút thì coi như failed (ESP32 có thể đã restart)
                        const startedAt = new Date(measurement.started_at);
                        const now = new Date();
                        const elapsedMinutes = (now - startedAt) / 60000;
                        
                        if (elapsedMinutes > 40) {
                            // Đã quá thời gian, coi như failed (có thể ESP32 đã restart)
                            console.log(`⚠️ Measurement ${measurement.file_name} đã quá ${Math.round(elapsedMinutes)} phút, coi như failed`);
                            startBtn.disabled = false;
                            startBtn.style.opacity = '1';
                            startBtn.style.cursor = 'pointer';
                            activeAlert.style.display = 'none';
                            statusContent.textContent = '⚠️ Đo bị gián đoạn (quá thời gian) - Có thể bắt đầu đo mới';
                            statusContent.style.color = '#dc2626';
                            resetMEMSSensors();
                        } else {
                            // Measurement đang chạy (status = 'started' hoặc 'in_progress')
                            // QUAN TRỌNG: Luôn disable button khi đang đo
                            startBtn.disabled = true;
                            startBtn.style.opacity = '0.6';
                            startBtn.style.cursor = 'not-allowed';
                            
                            // Hiển thị thông báo
                            activeAlert.style.display = 'block';
                            activeFileName.textContent = measurement.file_name || 'Unknown';
                            statusContent.textContent = `Đang đo: ${measurement.file_name || 'Unknown'}`;
                            statusContent.style.color = '#2563eb';
                            
                            // Log để debug (mỗi 10 giây)
                            logThrottle('measurement_active', () => 
                                `✅ Measurement đang chạy: ${measurement.file_name}, button đã được disable`
                            );
                        }
                    }
                } else {
                    // Không có measurement đang chạy (active = false hoặc không có measurement)
                    // QUAN TRỌNG: Kiểm tra ESP32 có online không trước khi enable button
                    // Chỉ enable button khi ESP32 đang bật và có dữ liệu sensor
                    try {
                        const selectedDeviceId = document.getElementById('deviceSelect')?.value;
                        if (selectedDeviceId) {
                            // Check device online bằng cách lấy latest sensor data
                            const sensorCheck = await fetch(`/api/enose/devices/${selectedDeviceId}/airsense/latest`, {
                                headers: { 'Authorization': `Bearer ${token}` }
                            });
                            const sensorData = await sensorCheck.json();
                            
                            if (sensorData.result && sensorData.result.success && sensorData.result.data) {
                                const data = sensorData.result.data;
                                const currentTime = Math.floor(Date.now() / 1000);
                                const dataTimestamp = data.timestamp || 0;
                                
                                // QUAN TRỌNG: Validate timestamp - nếu là tương lai hoặc quá cũ, coi như offline
                                const timestampDiff = Math.abs(currentTime - dataTimestamp);
                                let ageSeconds = currentTime - dataTimestamp;
                                
                                // Nếu timestamp không hợp lệ (tương lai hoặc quá cũ > 1 giờ), coi như offline
                                if (timestampDiff > 3600) {
                                    ageSeconds = 999999; // Force offline
                                }
                                
                                const maxAgeSeconds = 2 * 60; // 2 phút
                                
                                if (ageSeconds > maxAgeSeconds || ageSeconds < 0) {
                                    // ESP32 không có sensor data mới trong 2 phút → chưa được khởi động hoặc đã tắt
                                    startBtn.disabled = true;
                                    startBtn.style.opacity = '0.6';
                                    startBtn.style.cursor = 'not-allowed';
                                    activeAlert.style.display = 'none';
                                    statusContent.textContent = `⚠️ ESP32 chưa được khởi động. Không có dữ liệu sensor trong ${Math.round(ageSeconds/60)} phút gần đây. Vui lòng kiểm tra và khởi động thiết bị.`;
                                    statusContent.style.color = '#dc2626';
                                    return; // Không enable button
                                }
                            } else {
                                // Không có sensor data → ESP32 chưa được khởi động
                                startBtn.disabled = true;
                                startBtn.style.opacity = '0.6';
                                startBtn.style.cursor = 'not-allowed';
                                activeAlert.style.display = 'none';
                                statusContent.textContent = '⚠️ ESP32 chưa được khởi động. Thiết bị chưa gửi dữ liệu sensor. Vui lòng kiểm tra thiết bị có đang hoạt động và kết nối MQTT không.';
                                statusContent.style.color = '#dc2626';
                                return; // Không enable button
                            }
                        }
                    } catch (deviceCheckError) {
                        console.warn('⚠️ Could not check device online status:', deviceCheckError);
                        // Nếu không check được, vẫn enable button (fallback)
                    }
                    
                    // ESP32 đang online → enable button và hiển thị "Ready"
                    startBtn.disabled = false;
                    startBtn.style.opacity = '1';
                    startBtn.style.cursor = 'pointer';
                    
                    // Ẩn alert "Đang đo"
                    activeAlert.style.display = 'none';
                    
                    // Hiển thị "Ready" nếu chưa có thông báo khác
                    if (!statusContent.textContent.includes('ESP32') && !statusContent.textContent.includes('Đang đo') && !statusContent.textContent.includes('Đã hoàn thành')) {
                        statusContent.textContent = 'Ready';
                        statusContent.style.color = '#1f2937';
                    }
                    
                    // Nếu có reason từ backend (timeout, device_offline, no_recent_data), không hiển thị measurement cũ
                    if (activeData.result && activeData.result.reason) {
                        // Có lý do đặc biệt (timeout, device offline, etc.) - không hiển thị measurement cũ
                        if (activeData.result.reason === 'timeout_or_restart' || 
                            activeData.result.reason === 'device_offline' || 
                            activeData.result.reason === 'no_recent_data') {
                            statusContent.textContent = 'Ready - Có thể bắt đầu đo mới';
                            statusContent.style.color = '#1f2937';
                            resetMEMSSensors();
                            return; // Không cần xử lý thêm
                        }
                    }
                    
                    // Hiển thị thông báo completed/failed nếu có measurement (và không có reason đặc biệt)
                    if (activeData.result && activeData.result.measurement) {
                        const measurement = activeData.result.measurement;
                        
                        if (measurement.status === 'completed') {
                            let completionMessage = '✅ Đã hoàn thành';
                            if (measurement.duration_ms) {
                                const durationMinutes = Math.round(measurement.duration_ms / 60000);
                                completionMessage += ` (${durationMinutes} phút)`;
                            }
                            statusContent.textContent = completionMessage;
                            statusContent.style.color = '#16a34a';
                            
                            // Reset MEMS sensors về "--" khi measurement completed
                            resetMEMSSensors();
                            
                            // Reload last measurement info để hiển thị file mới nhất
                            loadLastMeasurementInfo();
                        } else if (measurement.status === 'failed') {
                            // Chỉ hiển thị failed nếu là measurement gần đây (trong 1 giờ)
                            const failedAt = measurement.completed_at ? new Date(measurement.completed_at) : null;
                            if (failedAt && (Date.now() - failedAt.getTime()) < 60 * 60 * 1000) {
                                // Failed trong 1 giờ gần đây
                                statusContent.textContent = '⚠️ Đo bị gián đoạn - Có thể bắt đầu đo mới';
                                statusContent.style.color = '#dc2626';
                            } else {
                                // Failed quá lâu, không hiển thị
                                statusContent.textContent = 'Ready';
                                statusContent.style.color = '#1f2937';
                            }
                            resetMEMSSensors();
                        } else {
                            // Status khác (không có hoặc unknown)
                            statusContent.textContent = 'Ready';
                            statusContent.style.color = '#1f2937';
                            resetMEMSSensors();
                        }
                    } else {
                        // Không có measurement nào - hiển thị Ready
                        statusContent.textContent = 'Ready';
                        statusContent.style.color = '#1f2937';
                        resetMEMSSensors();
                    }
                }
            } catch (error) {
                console.error('Error checking active measurement:', error);
                // Trong trường hợp lỗi, vẫn đảm bảo button có thể được sử dụng
                // (không disable khi có lỗi để tránh block user)
                const startBtn = document.getElementById('startMeasurementBtn');
                if (startBtn) {
                    // Chỉ enable nếu chưa có measurement đang chạy (để an toàn)
                    // Nếu có lỗi, user vẫn có thể thử start measurement
                    startBtn.disabled = false;
                    startBtn.style.opacity = '1';
                    startBtn.style.cursor = 'pointer';
                }
            }
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                if (!token) {
                    console.error('❌ No token found!');
                    return;
                }
                
                console.log('🔄 Loading dashboard data...');
                
                // Check active measurement trước
                await checkActiveMeasurement();
                
                // Load system status (giống Electric-Nose)
                console.log('🔄 Fetching /api/enose/control/status...');
                const statusRes = await fetch('/api/enose/control/status', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (!statusRes.ok) {
                    console.error('❌ Error fetching status:', statusRes.status, statusRes.statusText);
                    const errorText = await statusRes.text();
                    console.error('❌ Error response:', errorText);
                    return;
                }
                
                const statusData = await statusRes.json();
