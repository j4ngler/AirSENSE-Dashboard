                    console.error('❌ Invalid status response:', statusData);
                    return;
                }
                
                let totalDevices = 0;
                let onlineDevices = 0;
                let offlineDevices = 0;
                let wifiSignal = '--';
                let wifiSSID = '--';
                let wifiIP = null;
                let wifiStatus = 'disconnected';
                
                if (statusData.result) {
                    totalDevices = statusData.result.total_devices || 0;
                    onlineDevices = statusData.result.online_devices || 0;
                    offlineDevices = statusData.result.offline_devices || 0;
                    wifiSignal = statusData.result.wifi_signal || '--';
                    wifiSSID = statusData.result.wifi_ssid || '--';
                    wifiIP = statusData.result.wifi_ip || null;
                    wifiStatus = statusData.result.wifi_status || 'disconnected';
                    window.currentWifiStatus = wifiStatus;
                }
                
                // Update UI with calculated values
                document.getElementById('totalDevices').textContent = totalDevices;
                document.getElementById('onlineDevices').textContent = onlineDevices;
                document.getElementById('offlineDevices').textContent = offlineDevices;
                document.getElementById('recentControls').textContent = statusData.result?.recent_controls || '0';
                
                // Cập nhật chip WiFi (giống Electric-Nose)
                const wifiChip = document.getElementById('wifiChip');
                if (wifiChip) {
                    if (wifiStatus === 'connected') {
                        wifiChip.className = 'status-chip chip-success';
                        wifiChip.innerHTML = '<i class="bi bi-wifi"></i> Connected';
                    } else {
                        wifiChip.className = 'status-chip chip-danger';
                        wifiChip.innerHTML = '<i class="bi bi-wifi-off"></i> Disconnected';
                    }
                }
                
                // Xử lý WiFi alert (tương tự Electric-Nose)
                if (wifiStatus === 'connected') {
                    // WiFi đã kết nối - ẩn alert
                    document.getElementById('wifiSetupAlert').style.display = 'none';
                    if (typeof closeWifiConfigModal === 'function') {
                        closeWifiConfigModal();
                    }
                    window.wifiModalOpened = false;
                } else {
                    // WiFi chưa kết nối - hiển thị alert
                    if (onlineDevices === 0 || !wifiSSID || wifiSSID === '--') {
                        document.getElementById('wifiSetupAlert').style.display = 'block';
                        // Tự động mở modal WiFi config (chỉ mở 1 lần)
                        if (!window.wifiModalOpened) {
                            setTimeout(() => {
                                if (typeof openWifiConfigModal === 'function') {
                                    openWifiConfigModal();
                                }
                                window.wifiModalOpened = true;
                            }, 2000); // Đợi 2 giây để user thấy alert trước
                        }
                    } else {
                        document.getElementById('wifiSetupAlert').style.display = 'none';
                        if (typeof closeWifiConfigModal === 'function') {
                            closeWifiConfigModal();
                        }
                        window.wifiModalOpened = false;
                    }
                }
                // QUAN TRỌNG: Chỉ hiển thị wifi signal nếu ESP32 đang online
                // (wifi signal sẽ được ẩn bởi checkDeviceOnlineAndUpdateUI nếu ESP32 offline)
                const wifiSignalEl = document.getElementById('wifiSignal');
                if (wifiSignalEl && wifiSignal !== '--') {
                    wifiSignalEl.textContent = wifiSignal;
                }
                document.getElementById('wifiSSID').textContent = 'SSID: ' + wifiSSID;

                // Cập nhật link file server nếu có IP
                const fileServerLink = document.getElementById('fileServerLink');
                const fileServerInfo = document.getElementById('fileServerInfo');
                const fileServerText = document.getElementById('fileServerText');
                
                if (wifiIP) {
                    const fileServerUrl = `http://${wifiIP}`;
                    if (fileServerLink) {
                        fileServerLink.href = fileServerUrl;
                        fileServerLink.style.display = 'inline-block';
                    }
                    if (fileServerText) {
                        fileServerText.textContent = `File server: ${wifiIP}`;
                    }
                    if (fileServerInfo) {
                        fileServerInfo.style.display = 'block';
                    }
                } else {
                    if (fileServerLink) fileServerLink.style.display = 'none';
                    if (fileServerText) fileServerText.textContent = 'Chưa có IP address (chưa kết nối WiFi)';
                    if (fileServerInfo) fileServerInfo.style.display = 'block';
                }

                // Load latest sensor data từ E-Nose API
                let deviceIdForSensor = null;
                
                // Load devices list để lấy device đầu tiên
                try {
                    const devicesRes = await fetch('/api/enose/devices', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const devicesData = await devicesRes.json();
                    
                    // Lấy device đầu tiên từ danh sách
                    if (devicesData.result && devicesData.result.success && devicesData.result.devices && devicesData.result.devices.length > 0) {
                        deviceIdForSensor = devicesData.result.devices[0].device_code || devicesData.result.devices[0].device_id;
                    }
                } catch (devicesError) {
                    console.warn('⚠️ Could not load devices:', devicesError);
                }
                
                // Nếu có selectedDeviceId, ưu tiên dùng nó
                if (selectedDeviceId) {
                    deviceIdForSensor = selectedDeviceId;
                }
                
                // Load latest sensor data từ AirSENSE (ưu tiên) hoặc E-Nose API
                if (deviceIdForSensor) {
                    try {
                        // Ưu tiên lấy từ AirSENSE collection (real-time hơn)
                        let sensorRes = await fetch(`/api/enose/devices/${deviceIdForSensor}/airsense/latest`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        let sensorData = await sensorRes.json();
                        
                        // Nếu không có data từ AirSENSE, fallback sang E-Nose API
                        if (!sensorData.result || !sensorData.result.success || !sensorData.result.data) {
                            console.log('⚠️ No data from AirSENSE, trying E-Nose API...');
                            sensorRes = await fetch(`/api/enose/devices/${deviceIdForSensor}/latest`, {
                                headers: { 'Authorization': `Bearer ${token}` }
                            });
                            sensorData = await sensorRes.json();
                        }
                        
                        if (sensorData.result && sensorData.result.success && sensorData.result.data) {
                            const data = sensorData.result.data;
                            const currentTime = Math.floor(Date.now() / 1000);
                            const dataTimestamp = data.timestamp || 0;
                            
                            // QUAN TRỌNG: Validate timestamp - nếu là tương lai hoặc quá cũ, coi như offline
                            const timestampDiff = Math.abs(currentTime - dataTimestamp);
                            let ageSeconds = currentTime - dataTimestamp;
                            
                            // Nếu timestamp không hợp lệ (tương lai hoặc quá cũ > 1 giờ), coi như offline
                            if (timestampDiff > 3600) {
                                ageSeconds = 999999; // Force offline
                            }
                            
                            const maxAgeSeconds = 2 * 60; // 2 phút
                            
                            // Chỉ hiển thị dữ liệu nếu ESP32 đang online (có data mới trong 2 phút)
                            if (ageSeconds <= maxAgeSeconds && ageSeconds >= 0) {
                                // ESP32 đang online → hiển thị dữ liệu
                                // Update Temperature và Humidity
                                if (data.temperature !== undefined && data.temperature !== null) {
                                    const tempEl = document.getElementById('temperature');
                                    if (tempEl) tempEl.textContent = parseFloat(data.temperature).toFixed(1);
                                }
                                if (data.humidity !== undefined && data.humidity !== null) {
                                    const humEl = document.getElementById('humidity');
                                    if (humEl) humEl.textContent = parseFloat(data.humidity).toFixed(1);
                                }
                            } else {
                                // ESP32 offline → ẩn dữ liệu
                                const tempEl = document.getElementById('temperature');
                                if (tempEl) tempEl.textContent = '--';
                                const humEl = document.getElementById('humidity');
                                if (humEl) humEl.textContent = '--';
                            }
                            
                            // Load MEMS sensors - ưu tiên từ ADC array (AirSENSE format)
                            const memsData = [];
                            
                            // Nếu có ADC array (từ AirSENSE)
                            if (data.adc && Array.isArray(data.adc)) {
                                data.adc.forEach((value, index) => {
                                    if (value !== null && value !== undefined && index < 8) {
                                        memsData[index] = {
                                            data_type: `mems${index + 1}`,
                                            value: value,
                                            adc_value: value
                                        };
                                    }
                                });
                            }
                            
                            // Fallback: Tìm trong data object
                            if (memsData.length === 0) {
                                for (let i = 1; i <= 8; i++) {
                                    const memsValue = data[`mems${i}`] || data[`MEMS${i}`] || null;
                                    if (memsValue !== null && memsValue !== undefined) {
                                        memsData.push({
                                            data_type: `mems${i}`,
                                            value: memsValue,
                                            adc_value: memsValue
                                        });
                                    }
                                }
                            }
                            
                            // Nếu có ADC array trong content (từ AirSENSE common format)
                            if (memsData.length === 0 && data.content && data.content.adc && Array.isArray(data.content.adc)) {
                                data.content.adc.forEach((value, index) => {
                                    if (value !== null && value !== undefined && index < 8) {
                                        memsData[index] = {
                                            data_type: `mems${index + 1}`,
                                            value: value,
                                            adc_value: value
                                        };
                                    }
                                });
                            }
                            
                            if (memsData.length > 0) {
                                displayMEMSSensors(memsData);
                                console.log('✅ Loaded MEMS sensors:', memsData);
                            } else {
                                console.warn('⚠️ No MEMS sensor data found');
                                // Hiển thị empty state
                                displayMEMSSensors([]);
                            }
                        }
                    } catch (error) {
                        console.error('Error loading sensor data:', error);
                        // Hiển thị empty state
                        displayMEMSSensors([]);
                    }
                } else {
                    console.warn('⚠️ No device found for sensor query');
                    // Hiển thị empty state
                    displayMEMSSensors([]);
                }
                
                // Load measurement files
                await loadMeasurementFiles();

                await loadMeasurementHistory();
                await loadLastMeasurementInfo();
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        }

