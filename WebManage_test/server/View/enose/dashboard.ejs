        // Load MEMS sensors data
        async function loadMEMSSensorsData() {
            try {
                let url = '/api/devices/data/history?limit=100';
                if (selectedDeviceId) {
                    url += `&device_id=${selectedDeviceId}`;
                }
                if (fromTime && toTime) {
                    url += `&start_time=${fromTime.toISOString()}&end_time=${toTime.toISOString()}`;
