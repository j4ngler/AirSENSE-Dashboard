<!DOCTYPE html>
<html lang="zxx">
  <% include ../../Layout/header.ejs %>
  <link rel="stylesheet" href="/assets/css/blog/styles.css" />
  <body class="defult-home">
    <!-- Main content Start -->
    <div class="main-content">
      <!--Full width header Start-->
      <div class="full-width-header home8-style4">
        <!--Header Start-->
        <% include ../../Layout/topbar.ejs %>

        <!--Header End-->
      </div>
      <!--Full width header End-->
      <div class="container-fluid pb-4 pt-4 paddding">
        <div class="container paddding">
          <div class="row mx-0">
            <div class="col-md-8 animate-box" data-animate-effect="fadeInLeft">
              <div>
                <div
                  class="fh5co_heading fh5co_heading_border_bottom py-2 mb-4"
                >
                  Blog
                </div>
              </div>
              <div id="list_blog"></div>
            </div>
            <% include ../blog-right-sidebar.ejs %>
          </div>
          <div class="row mx-0">
            <div class="col-12 text-center pb-4 pt-4">
              <a href="#" class="btn_mange_pagging"
                ><i class="fa fa-long-arrow-left"></i>&nbsp;&nbsp; Previous</a
              >
              <a href="#" class="btn_pagging">1</a>
              <a href="#" class="btn_pagging">2</a>
              <!-- <a href="#" class="btn_pagging">3</a> -->
              <a href="#" class="btn_mange_pagging"
                >Next <i class="fa fa-long-arrow-right"></i>&nbsp;&nbsp;</a
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Categories Section End -->
    </div>
    <% include ../../Layout/footer.ejs %>
    <!-- Main content End -->
  </body>
  <script type="text/javascript" src="../../utils/pagination.min.js"></script>
  <script type="text/javascript">
    function fetchListBlog() {
      getInfoHtml("/api/document/list_blog", (data) => {
        const listBlog = JSON.parse(data);
        let listBlogItem = "";
        console.log(listBlog);
        listBlog.forEach((element) => {
          listBlogItem += `<div class="row pb-4">
                <div class="col-md-5">
                  <div class="fh5co_hover_news_img">
                    <div class="fh5co_news_img">
                      <img src=${element.content_img} alt="" />
                    </div>
                    <div></div>
                  </div>
                </div>
                <div class="col-md-7 animate-box">
                  <!-- Xu ly link a -->
                  <a href="/blog/environment/${element.file_save}" class="fh5co_magna py-2">
                    ${element.title}
                  </a>
                  <a href="#" class="fh5co_mini_time py-3">
                    Admin Airsense - July 24, 2020
                  </a>
                  <div class="fh5co_consectetur">
                  ${element.description}
                  </div>
                </div>
              </div>`;
        });
        
        
       $("#list_blog").html(listBlogItem);
      });
    }
    fetchListBlog();
  </script>
</html>
