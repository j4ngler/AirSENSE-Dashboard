<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">

<head>
    <title>The Man in Blue &gt; Experiments &gt; widgEditor</title>
    <meta http-equiv="content-type" content="text/html; charset=iso-8859-1" />
    <meta name="author" content="The Man in Blue" />
    <meta name="robots" content="all" />
    <meta name="MSSmartTagsPreventParsing" content="true" />
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link type="text/css" href="/tool_editor/sample/css/sample.css" rel="stylesheet" media="screen" />
    <script language="JavaScript" src="https://code.jquery.com/jquery-3.3.1.js" type="text/javascript"></script>
    <script type="text/javascript" src="/tool_editor/ckeditor.js"></script>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"/>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>
</head>



<body>
    <center> <h2> Đăng bài </h2> </center> 
    <div id="content">
        <div >
            <div  style="width: 25%; float: left; box-sizing: border-box;">
                <div style="width: 100px; float: none;width: auto;overflow: hidden;">
                    chuyên mục chính
                    <select id="selectTable" onclick="selectTableGroup()" >
                        <option value="newProduct"> sản phẩm mới</option>
                        <option value="product">  các sản phẩm   </option>
                        <option value="support">Góc hỗ trợ</option>
                        <option value="video">video</option>
                        <option value="communicate">cộng đồng</option>
                    </select>
                    <br/>
                    chuyên mục phụ
                    <select id="selectTableDetail"  >
                        <option value="newProduct"> sản phẩm mới</option>
                        <option value="product">  các sản phẩm   </option>
                        <option value="support">Góc hỗ trợ</option>
                        <option value="video">video</option>
                        <option value="communicate">cộng đồng</option>
                    </select>
                    <br/>
                    Tiêu đề
                    <br/> 
                    <textarea id="titleInput" name="titleInput" rows="4" cols="50"> </textarea> 
                   
                </div>
                <center> <button onclick="onSelectClick1();"> upload</button></center> 
            </div>
            <div  style="width: 75%; float: left; box-sizing: border-box;">
                <main>
                    <div class="centered">
                        <div class="document-editor">
                            <div class="toolbar-container"></div>
                            <div class="content-container">
                                <div id="editor">
                                    <h2>Start PAges</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
	</div>


    <script type="text/javascript">
        var listImage=[];
        var listSelectContent=[];
        var mname = localStorage.getItem("tocken_LVC");
        class UploadAdapter {
            constructor(loader) {
                this.loader = loader;
            }
            upload() {

                return this.loader.file
            .then( file => new Promise( ( resolve, reject ) => {
                const data = new FormData();
                    data.append('resumeFileBrowser', file);

                    $.ajax({
                        type: "POST",
                        enctype: 'multipart/form-data',
                        url: "/uploadimage",
                        data: data,
                        processData: false, //prevent jQuery from automatically transforming the data into a query string
                        contentType: false,
                        cache: false,
                        success: (data1) => {
                            console.log(data1);
                            if (data1.filename) { 
                                
                                resolve({
                                    default: data1.urlAppend  +data1.filename
                                });
                            } else {
                                reject(false);
                            }
                            
                        },
                        error: (e) => {
                            console.log(e.responseText);
                        }
                    });
            } ) );

            }
            abort() {
            }
        }

        DecoupledEditor
            .create( document.querySelector( '#editor' ), {
                mediaEmbed: {previewsInData: true}
                
                // toolbar: [ 'heading', '|', 'bold', 'italic', 'link' ]
            } )
            .then( editor => {
                const toolbarContainer = document.querySelector( 'main .toolbar-container' );
               toolbarContainer.prepend( editor.ui.view.toolbar.element );
                window.editor = editor;
                editor.plugins.get('FileRepository').createUploadAdapter = (loader)=>{
                    return new UploadAdapter(loader);
                };
            } )
            .catch( err => {
                console.error( err.stack );
                console.log(err);
            } );

        function onSelectClick1(){
            const editorData = editor.getData();
            onSelectClick(editorData);
        }


        function onSelectClick(value){
            console.log(value);
            var group=1;//$('#selectTableDetail').val();
            var title=$('#titleInput').val();
            var titleBody=" du lieu";
            var startHtml= "<html> <head><title>"+ title+"</title> </head><body> ";
            var endHtml="</body></html";
            var valueHtml=startHtml+value+endHtml;
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: "/registerPages",
                data: {
                    content:valueHtml,
                    title:title,
                    group:group,
		            maintitle:titleBody
                 },
                 beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    var string ="Đăng bài ";
                    if(loadcofig)  string+="thành công";
                    else string+="thất bại";
                    alert(string);
                },
                error: function (loadcofig) {
                    console.log('error');
                    alert("Lỗi  đăng bài");
                   
                }
            });
        }

        function selectTableGroup(){
            var group=$('#selectTable').val();
            var showDataDetail="";
            for(var k=0;k< listSelectContent.length;k++) {
                let v=listSelectContent[k];
                if((v["content_group"].indexOf("_")>-1)&&(v["content_group"].indexOf(group)>-1))
                {
                    showDataDetail+='<option value="'+v["content_group"]+'">'+v["title"] +'</option>';
                }
                
            }
            $('#selectTableDetail').html(showDataDetail);
        }

    </script>

</html>
