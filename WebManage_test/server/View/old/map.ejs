    <script>
        const url = location.href;
        const itemUrl = url.split('/');
        const tokenAdmin = itemUrl[itemUrl.length-1];
        var mname = tokenAdmin;
        console.log("mname .................. mname",mname);
        var mapObj=null;
        var NewMarker=null;
        var DefaulLocation=[21.0277644,105.83415979999995];
        var zoomLevel=13;
        var groupID=[];
        var nameGroupID=[];
        var dataStation = null;
        var Mapconfig={
            attributionControl:true,
            center: DefaulLocation,
            zoom:zoomLevel
        }

        var UrlIcon1="/training_library/img/core-img/Maker.png";

        function createMaker(LoLa, Content, Options, MakerObj)
        {
            var IIcon=L.Icon.extend({
                options:{
                    iconSize:     [13, 20],
                    shadowSize:   [50, 64],
                    iconAnchor:   [22, 94],
                    popupAnchor:  [-3, -76]
                }
            });
            var redIcon=new IIcon({iconUrl:UrlIcon1});  
            if (!MakerObj)
            {
                MakerObj={};
            }
            if (!Options)
            {
                Options={};
            }
            var NewNode=L.marker(LoLa,{icon:redIcon},MakerObj).addTo(mapObj);
            //var NewNode=L.marker(LoLa,{icon:setIcon}).addTo(mapObj).bindPopup("Hi");
            var popup=L.popup(Options);
            popup.setContent(Content);
            NewNode.bindPopup(popup);
            return NewNode;
        }

        gotoCheckUserStorage();
        function createcontent(data,station)
        {
            var content='';           
            content+=`<div class='left'><img src='/training_library/img/core-img/codexact.png' /></div>`;
            content+=`<div class='right'><b>Detailed Index:</div><div class='right'><b>Station : `;
            content+=station.station_id +` - `+station.content+` - `+station.adress;
            for(var k=data.result.length-1;k>0;k--)
            {
                let v=data.result[k];
                if(v.station_id===station.station_id){
                    content+=`</div><div class='right'><b>Date and Time:`;
                    content=content+v.time +`</div>`;
                    content=content+`<div class='right'><b>Vbatt: `+ v.vbat+ `mV</div>`;
                    content=content+`<div class='right'><b>Board Temp: `+ v.broad_temp+ `oC</div>`;
                    content=content+`<div class='right'><b>CH1_freq: `+v.ch1_freq+ `Hz</div>`;
                    content=content+`<div class='right'><b>CH1_temp: `+v.ch1_temp+ `oC</div>`;
                    content=content+`<div class='right'><b>CH2_freq: `+v.ch2_freq+ `Hz</div>`;
                    content=content+`<div class='right'><b>CH2_temp: `+v.ch2_temp+ `oC</div>`;
                    content=content+`<div class='right'><b>Flags: `+v.flag+ `</div>`;
                    break;
                }
            }
            content+=`<div class='clearfix'></div>`;
            return content;    
        }

        function loadAllData(){
                //var mname=localStorage.getItem("tocken_LVC");
                var Link='/api/social/getdatalimit';
                    $.ajax({
                        type: 'post',
                        method: 'POST',
                    url: Link,
                    data:JSON.stringify( {data:1000 }),
                    cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                    credentials: 'same-origin', // include, *same-origin, omit
                    redirect: 'follow', // manual, *follow, error
                    referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                    dataType: 'json',
                    cache: 'no-cache', // *default, no-cache, reload, force-cache, only-if-cached
                    credentials: 'same-origin', // include, *same-origin, omit
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                        'Authorization': 'Beard ' + mname,
                        // 'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    success: function (loadcofig) {
                        console.log("Show Data..........................................");
                        console.log(loadcofig);
                        
                        for(var k=0;k< dataStation.length;k++) {
                            let v= dataStation[k];
                            groupID.push(v.id_group);
                            nameGroupID.push(v.name_group);
                            var text={"firstName":"John", "lastName":"Doe"};
                            var checklola=[v.location_lat,v.location_long];
                            var marker=createMaker(checklola,createcontent(loadcofig,v),{},NewMarker);
                         
                        }
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
               //return text;
        }

        window.onload=function()
        {
            
            mapObj=L.map('Map',Mapconfig);
            L.tileLayer('http://{s}.tile.osm.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="http://osm.org/copyright">OpenStreetMap</a> contributors'}).addTo(mapObj);
            NewMarker={
                        className: "map-popup-content",
            } ;
    

            function loadAllContent(){
                var Link='/api/social/getStation';
                    $.ajax({
                        type: 'get',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (loadcofig) {
                        console.log("Show Data");
                        console.log(loadcofig);
                        dataStation= loadcofig.result;
                        setTimeout(function(){ loadAllData(); }, 300);
                        // loadAllData();
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
               //return text;
                    }
                 var x=loadAllContent();
                console.log(x);
            };
     
    </script>

