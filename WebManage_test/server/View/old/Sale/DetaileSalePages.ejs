    <script type="text/javascript">
        var showData='MÔ TẢ SẢN PHẨM'+
'Kết nối dễ đàng với các thiết bị qua ngõ đầu vào (AV, HDMI, VGA)'+
'Với một cáp kết nối HDMI bạn đã có thể trình chiếu âm thanh và hình ảnh chất lượng cao từ các nguồn phát HD hay laptop.'

         $('#homeDescription').html(showData);

         var dataJsonPage = "<%= dataPage %>";
         console.log(dataJsonPage);

         gotoCheckUser(dataJsonPage);
         
         function gotoCheckUser(tableSelect){  
                var Link='http://localhost:3000/productdetail/'+tableSelect;
                $.ajax({
                    type: 'get',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        var typeSupport='<div style="float: left;margin-right: 15px;width:150px;"> kết hợp với </div>';
                        var tupeSupportImage='';

                        for(var i=0;i<loadcofig.length;i++ ){
                            if(loadcofig[i].content!=null)
                                $('#name_product_device').html(loadcofig[i].content);
                            $('#cost_value_calculator').html(loadcofig[i].cost);
                            if(loadcofig[i].cost_percent<100)
                                $('#km_product_detail').html(loadcofig[i].km_product_detail+'%');
                            $('#save_coin_product_detail').html('0 xu');
                            if(loadcofig[i].content_sale_support!=null)
                                typeSupport+='<button class="add_to_cart_button" >' 
                                    +loadcofig[i].content_sale_support+'</button>';
                             $('#note_product_detail').html(loadcofig[i].content);

                             if((i==0)&&(loadcofig[i].link_image!=null)){
                                $("#main_product_detail").attr("src",loadcofig[i].link_image);
                                tupeSupportImage+=' <img   src="'+loadcofig[i].link_image +'" onclick="onChangeLinkClick('+"'"
                                +loadcofig[i].link_image +"'" +')" alt="">';
                             }
                               
                            if(loadcofig[i].link_sale_suport!=null)
                                tupeSupportImage+=' <img   src="'+loadcofig[i].link_sale_suport +'" onclick="onChangeLinkClick('+"'"
                                +loadcofig[i].link_sale_suport +"'" +')" alt="">';

                        }

                        $('#type_product_detail').html(typeSupport);
                        $('#main_suport_pro_detail').html(tupeSupportImage);
                        
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
            }

        function onChangeLinkClick(link){
            $("#main_product_detail").attr("src",link);
        }
    </script>



  </body>
</html>