    <script type="text/javascript">
        var mname = localStorage.getItem("tocken_LVC");
        function onSelectClick(value){
            console.log(value);
            var group=$('#selectTable').val();
            var title=$('#titleInput').val();
            var titleBody=" du lieu";
            var startHtml= "<html> <head><title>"+ title+"</title> </head><body> ";

            var endHtml="</body></html";


            var valueHtml=startHtml+value+endHtml;


           
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: "http://localhost:3000/controlpage",
                data: {
                    content:valueHtml,
                    title:title,
                    group:group,
		            maintitle:titleBody
                 },
                 beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                success: function (loadcofig) {
                    console.log(loadcofig);
                    var string ="Đăng bài ";
                    if(loadcofig)  string+="thành công";
                    else string+="thất bại";
                    alert(string);
                },
                error: function (loadcofig) {
                    console.log('error');
                    alert("Lỗi  đăng bài");
                   
                }
            });



