        var modal = document.getElementById("myModal");
        // Get the button that opens the modal
        // Get the <span> element that closes the modal
        var span = document.getElementsByClassName("close")[0];
        // When the user clicks the button, open the modal 
        var listSetValue=[];
    
        // When the user clicks on <span> (x), close the modal
        span.onclick = function() {
            //ationSelect
            modal.style.display = "none";
        }
        // When the user clicks anywhere outside of the modal, close it
        window.onclick = function(event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

            

        function exportReport() {
            var fromTime = new Date($('#fromTime').val());
            var toTime = new Date($('#toTime').val());
            var station_id = document.getElementById("selectTable").value;
            if(!station_id) {
                alert("Vui lòng chọn trạm để xuất báo cáo");
                return;
            }
            if(isNaN(fromTime.getFullYear())) {
                fromTime = undefined;
            } else fromTime = fromTime.getFullYear() +'-'+ fromTime.getMonth() +'-'+ fromTime.getDate() +' '+ fromTime.getHours() +':'+ fromTime.getMinutes() +':00';
            if(isNaN(toTime.getFullYear())) {
                toTime = undefined;
            } else toTime = toTime.getFullYear() +'-'+ toTime.getMonth() +'-'+ toTime.getDate() +' '+ toTime.getHours() +':'+ toTime.getMinutes() +':00';            
            var data = {'fromTime': fromTime, 'toTime': toTime, 'station_id': station_id};
            var link = 'http://localhost:3000/getReport';
            
            $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: link,
                    data: data,
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function(result) {
                         window.location = 'http://localhost:3000/file/sparc_sensor_data.xlsx';
                    }
                })
        }

        loadAllContent();
        function loadAllContent(){
            var Link='http://localhost:3000/report/sparc_location_sensor';
                $.ajax({
                    type: 'post',
                    dataType: 'json',
                    url: Link,
                    data: { },
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('Authorization', 'Bearer '+mname);
                    },
                    success: function (loadcofig) {
                        console.log(loadcofig);
                        var showData='<option value="">None</option>';
                        var groupID=[];
                        var nameGroupID=[];
                        allInfoStation=loadcofig.result;
                        for(var k=0;k< loadcofig.result.length;k++) {
                            let v=loadcofig.result[k];
                            showData+='<option value="'+v.station_id+'">'+v.content +'</option>';
                            if((v.id_group>0)&&(!groupID.includes(v.id_group)))
                            {
                                groupID.push(v.id_group);
                                nameGroupID.push(v.name_group);
                            }
                            
                        }

                        for(var l=0;l< groupID.length;l++) {
                            let dataChoice=groupID[l];
                            var itemData="";
                            for(var k=0;k< loadcofig.result.length;k++) {
                                let v=loadcofig.result[k];
                                if(v.id_group==dataChoice){
                                    if(itemData.length>1) itemData+=","
                                    itemData+="'"+v.station_id+"'";
                                }   
                            }
                            showData+='<option value="('+itemData+')">'+nameGroupID[l] +'</option>';

                        }

                        console.log(showData);
                        $('#selectTable').html(showData);
                        
                    },
                      error: function (loadcofig) {
                        console.log('error');
                          console.log(loadcofig);
                          console.log('end error');
                      }
                });
        }

