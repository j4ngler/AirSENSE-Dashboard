<html lang="en">
  <head>
    <meta charset="utf-8" http-equiv="Content-Type" />
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
      }

      /* The Modal (background) */
      .modal {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0, 0, 0); /* Fallback color */
        background-color: rgba(0, 0, 0, 0.4); /* Black w/ opacity */
      }

      /* Modal Content */
      .modal-content {
        background-color: #fefefe;
        margin: auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
      }

      /* The Close Button */
      .close {
        color: #aaaaaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
      }

      .close:hover,
      .close:focus {
        color: #000;
        text-decoration: none;
        cursor: pointer;
      }
    </style>
    <script
      language="JavaScript"
      src="https://code.jquery.com/jquery-3.3.1.js"
      type="text/javascript"
    ></script>
    <script
      language="JavaScript"
      src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"
      type="text/javascript"
    ></script>
    <script
      language="JavaScript"
      src="https://cdn.datatables.net/1.10.20/js/dataTables.bootstrap4.min.js"
      type="text/javascript"
    ></script>
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/css/bootstrap.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.datatables.net/1.10.20/css/dataTables.bootstrap4.min.css"
    />
  </head>
  <body>
    <h1>Choice Table</h1>
    <select id="selectTable" onchange="onSelectClick()">
      <option value="">none</option>

      <option value="content_page">Các website</option>
      <option value="content_group">Các nội dung</option>
    </select>

    <br />
    <table
      id="datatable"
      class="table table-striped table-bordered"
      style="width: 100%"
    >
      <thead>
        <tr>
          <th>Name</th>
          <th>
            Positionsczxczzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
          </th>
          <th>Officexzccccccccccccc</th>
          <th>Age</th>
          <th>Start date</th>
          <th>
            Salaryxzcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Tiger Nixon</td>
          <td>System Architect</td>
          <td>Edinburgh</td>
          <td>61</td>
          <td>2011/04/25</td>
          <td>$320,800</td>
        </tr>
      </tbody>
    </table>
    <br />
    <center>Tác vụ</center>
    <br />
    <center>
      <button onclick='actionData("add")'>Thêm</button>
      <button onclick='actionData("edit")'>Sửa</button>
      <button onclick="loaddingDeleteUser()">Xóa</button>
    </center>
    <div id="myModal" class="modal">
      <!-- Modal content -->
      <div class="modal-content">
        <span class="close">&times;</span>
        <div id="ationSelect"></div>
      </div>
    </div>

    <script type="text/javascript">
      var mname = localStorage.getItem("tocken_LVC");
      function onSelectClick() {
        var stringvalue = document.getElementById("selectTable").value;
        console.log(stringvalue);
        gotoCheckUser(stringvalue);
      }

      var actionDataSelect = null;
      var dataSelectEdit = null;
      var dataClick = null;
      /*$(document).ready(function() {
                $('#datatable').DataTable();
                
                gotoCheckUser();
                
            } ); */

      // 0 là không cho hiện
      // 1 là chỉ quyền admin thì mới cho hiện
      // 2  không hiện
      // 3 hiện dữ liệu không cho chỉnh sửa trừ admin
      // 4 hiện dữ liệu cho chỉnh sửa
      function assetDataBase(result) {
        actionDataSelect = {
          dataTableTitle: result.dataReport.dataTableTitle,
          titleDataBase: result.dataReport.titleDataBase,
        };
        $("#datatable").DataTable({ destroy: true }).destroy();
        var showData = "<thead> <tr>";
        var columeShow = [];
        for (var k in result.dataReport.dataTableTitle) {
          if (result.dataReport.titleDataBase[k] > 2) {
            showData += result.dataReport.dataTableTitle[k];
            showData +=
              '<th data-field="' +
              k +
              '">' +
              result.dataReport.dataTableTitle[k] +
              "</th>";
            columeShow.push({ data: k });
          }
        }
        showData += "</tr></thead>";
        $("#datatable").html(showData);
        var table = $("#datatable").DataTable({
          data: result.result,
          columns: columeShow,
        });
        $("#datatable tbody").on("click", "td", function () {
          console.log(this);
          var idx = table.cell(this).index().row;
          console.log(idx);
          var data = table.row(idx).data();
          console.log(data);
          dataClick = data;
        });
      }

      // gotoCheckUser();
      function gotoCheckUser(tableSelect) {
        if (tableSelect.length < 1) return;
        var Link = "http://localhost:3000/report/" + tableSelect;
        $.ajax({
          type: "post",
          dataType: "json",
          url: Link,
          data: {},
          beforeSend: function (xhr) {
            xhr.setRequestHeader("Authorization", "Bearer " + mname);
          },
          success: function (loadcofig) {
            console.log(loadcofig);
            console.log("ssssssssssss");
            assetDataBase(loadcofig);
          },
          error: function (loadcofig) {
            console.log("error");
            console.log(loadcofig);
            console.log("end error");
          },
        });
      }
      var modal = document.getElementById("myModal");
      // Get the button that opens the modal
      // Get the <span> element that closes the modal
      var span = document.getElementsByClassName("close")[0];
      // When the user clicks the button, open the modal

      function actionData(varAction) {
        var showData = " <table> ";
        var pageSelect = "";
        if (varAction === "add") {
          for (var k in actionDataSelect.dataTableTitle) {
            if (actionDataSelect.titleDataBase[k] > 3) {
              showData += " <tr> <th>" + actionDataSelect.dataTableTitle[k];
              showData +=
                '</th><th><input type="text" id="' + k + '"/> </th></tr>';
            }
          }
          showData +=
            "</table> <br/> <button onclick='loaddingAddUser()'>Thêm </button>";
          console.log(showData);
          $("#ationSelect").html(showData);
          modal.style.display = "block";
        } else if (varAction === "edit") {
          for (var k in actionDataSelect.dataTableTitle) {
            if (actionDataSelect.titleDataBase[k] > 3) {
              showData += " <tr> <th>" + actionDataSelect.dataTableTitle[k];
              showData +=
                '</th><th><input type="text" id="' +
                k +
                '" value="' +
                dataClick[k] +
                '"" /></th> </tr>';
            }
          }
          if (dataClick["id"]) pageSelect = dataClick["id"];
          showData +=
            "</table> <br/> <button onclick='loaddingUppdateUser()'>Sửa </button>" +
            "<button onclick='gotoEditPage(" +
            pageSelect +
            ")'>Sửa trang </button>";
          console.log(showData);
          $("#ationSelect").html(showData);
          modal.style.display = "block";
        }
      }

      // When the user clicks on <span> (x), close the modal
      span.onclick = function () {
        //ationSelect
        modal.style.display = "none";
      };
      // When the user clicks anywhere outside of the modal, close it
      window.onclick = function (event) {
        if (event.target == modal) {
          modal.style.display = "none";
        }
      };

      function gotoEditPage(linkUpdate) {
        window.location.href = "/editPage/" + linkUpdate;
      }

      function loaddingUser(linkUpdate, jsonValue) {
        $.ajax({
          type: "post",
          dataType: "json",
          url: linkUpdate,
          data: jsonValue,
          beforeSend: function (xhr) {
            xhr.setRequestHeader("Authorization", "Bearer " + mname);
          },
          success: function (loadcofig) {
            console.log(loadcofig);
            //location.reload();
            gotoCheckUser(document.getElementById("selectTable").value);
          },
          complete: function (loadcofig) {
            console.log(loadcofig.responseText);
            gotoCheckUser(document.getElementById("selectTable").value);
          },
          error: function (loadcofig) {
            console.log(loadcofig);
          },
        });
      }

      function loaddingAddUser() {
        var showData = {};
        for (var k in actionDataSelect.dataTableTitle) {
          showData[k] = null;
          if ($("#" + k).val()) {
            showData[k] = $("#" + k).val();
          }
        }
        console.log("loadcofig  loaddingAddUser");
        console.log(showData);
        modal.style.display = "none";
        var stringvalue = document.getElementById("selectTable").value;
        showData["add_table"] = stringvalue;
        showData["action_table"] = "add";
        loaddingUser("http://localhost:3000/managerTable", showData);
      }

      function loaddingUppdateUser() {
        var showData = dataClick;
        for (var k in actionDataSelect.dataTableTitle) {
          if ($("#" + k).val()) {
            showData[k] = $("#" + k).val();
          }
        }
        var stringvalue = document.getElementById("selectTable").value;
        showData["add_table"] = stringvalue;
        showData["action_table"] = "update";
        modal.style.display = "none";
        loaddingUser("http://localhost:3000/managerTable", showData);
      }
      function loaddingDeleteUser() {
        var showData = dataClick;
        var stringvalue = document.getElementById("selectTable").value;
        showData["add_table"] = stringvalue;
        showData["action_table"] = "delete";
        loaddingUser("http://localhost:3000/managerTable", showData);
      }
    </script>
  </body>
</html>
