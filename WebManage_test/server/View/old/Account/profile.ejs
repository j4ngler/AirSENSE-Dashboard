                                    <div class="col-lg-9">
                                        <input id="email" class="form-control" type="email" value="" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-lg-3 col-form-label form-control-label">Điện thoại</label>
                                    <div class="col-lg-9">
                                        <input id="phone" class="form-control" type="text" value="11111122333" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-lg-3 col-form-label form-control-label">Liên hệ</label>
                                    <div class="col-lg-9">
                                        <input id="contact" class="form-control" type="text" value="" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-lg-3 col-form-label form-control-label">Vai trò</label>
                                    <div class="col-lg-9">
                                        <input id="role" class="form-control" type="text" disabled value="Admin" />
                                    </div>
                                </div>
                                <!-- <div class="form-group">
                                    <div class="row">
                                        <label class="col-lg-6 col-form-label form-control-label">Latitude</label>
                                        <label class="col-lg-6 col-form-label form-control-label">Longitude</label>
                                    </div>
                                    <div class="row location">
                                        <div class="col-lg-6">
                                            <input id="latitude" class="form-control" type="text" value="22.234" />
                                        </div>
                                        
                                        <div class="col-lg-6">
                                            <input id="longitude" class="form-control" type="text" value="103.4444" />
                                        </div>
                                    </div>
                                    
                                    
                                </div> -->
                                <div class="form-group row">
                                    <label class="col-lg-3 col-form-label form-control-label"></label>
                                    <div class="col-lg-9">
                                        <input type="reset" class="cancel btn btn-secondary" value="Hủy" />
                                        <input type="button" class="save btn btn-primary" value="Lưu thay đổi" />
                                    </div>
                                </div>

                                <input id="userid" style="display: none;" type="text" value="" />
                            </form>
                        </div>
                        <div class="col-lg-4 pull-lg-8 text-xs-center">
                            <img id="avatar" src="//placehold.it/150" class="m-x-auto img-fluid img-circle rounded float-left" alt="avatar" />
                            <h6 class="m-t-2">Chọn ảnh đại diện khác</h6>
                            <label class="custom-file">
                                <input type="file" id="file" class="custom-file-input">
                                <span class="custom-file-control">Chọn file</span>
                            </label>
                        </div>
                    </div>
                </div>


            </div>
