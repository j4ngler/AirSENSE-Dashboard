  <script>
    const fbScroll = document.querySelector('.js-fb-scroll');
    const fbPrevScroll = document.querySelector('.fb-scroll-prev-btn');
    const fbNextScroll = document.querySelector('.fb-scroll-next-btn');
    const fbItem = document.querySelectorAll('.feedback-outstanding-item');

    const topdevScroll = document.querySelector('.js-topdev-scroll');
    const topdevPrevBtn = document.querySelector('.td-scroll-prev-btn');
    const topdevNextBtn = document.querySelector('.td-scroll-next-btn');
    const topdevCourseItem = document.querySelectorAll('.top-dev-course-item');

    topdevNextBtn.onclick = () => {
        topdevScroll.scrollLeft =
            topdevScroll.scrollLeft +
            (2 * topdevScroll.scrollWidth) / topdevCourseItem.length;
    };
    topdevPrevBtn.onclick = () => {
        topdevScroll.scrollLeft =
            topdevScroll.scrollLeft -
            (2 * topdevScroll.scrollWidth) / topdevCourseItem.length;
    };

    fbNextScroll.onclick = () => {
        fbScroll.scrollLeft =
            fbScroll.scrollLeft + fbScroll.scrollWidth / fbItem.length;
    };
    fbPrevScroll.onclick = () => {
        fbScroll.scrollLeft =
            fbScroll.scrollLeft - fbScroll.scrollWidth / fbItem.length;
    };

    const curriculumChapterBtns = document.querySelectorAll(
        '.curriculum-chapter-btn'
    );
    const curriculumLectureLists = document.querySelectorAll(
        '.curriculum-lecture-list'
    );

    const curriculumChapterIconUps = document.querySelectorAll(
        '.curriculum-chapter-icon-up'
    );

    curriculumChapterBtns.forEach((item, index) => {
        item.onclick = () => {
            curriculumLectureLists[index].classList.toggle(
                'curriculum-lecture-list--hidden'
            );
            curriculumChapterIconUps[index].classList.toggle(
                'curriculum-chapter-icon-up--rotate180deg'
            );
        };
    });

</script>

